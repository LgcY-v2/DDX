[Unit]
Description=DDX | Testing server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/ddx_testing/server
ExecStartPre=/usr/bin/test -r /srv/multi_tas/data/maps/Tutorial.map
ExecStartPre=/usr/bin/test -d /srv/multi_tas/data/maps/tw_maps/ddnet-maps-master/types
ExecStartPre=/usr/bin/test -d /srv/multi_tas/data/maps/tw_maps/KoGmaps-main
ExecStartPre=/usr/bin/test -r /srv/ddx_testing/archive/source/maps.7z
ExecStartPre=/usr/bin/test -r /srv/ddx_testing/archive/index/maps-v1.tsv
ExecStartPre=/usr/bin/test -r /srv/ddx_testing/archive/index/map-metadata-v1.tsv
ExecStartPre=/usr/bin/test -d /srv/ddx_testing/archive/delta
ExecStartPre=/usr/bin/test -x /srv/ddx_testing/archive/tools/7zip-26.00/usr/lib/7zip/7za
ExecStartPre=/usr/bin/sha256sum --check --strict --quiet /srv/ddx_testing/archive/manifest.sha256
ExecStart=/srv/ddx_testing/build/ddnet/DDNet-Server
Restart=on-failure
RestartSec=3s
KillSignal=SIGTERM
TimeoutStopSec=15s
UMask=0077
StandardOutput=append:/srv/ddx_testing/server/logs/console.log
StandardError=append:/srv/ddx_testing/server/logs/console.log

[Install]
WantedBy=default.target
