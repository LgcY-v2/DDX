[Unit]
Description=tee_world_candidate_testing DDNet server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/tee_world_candidate_testing/server
ExecStartPre=/usr/bin/test -r /srv/multi_tas/data/maps/Tutorial.map
ExecStartPre=/usr/bin/test -d /srv/multi_tas/data/maps/tw_maps/ddnet-maps-master/types
ExecStartPre=/usr/bin/test -d /srv/multi_tas/data/maps/tw_maps/KoGmaps-main
ExecStartPre=/usr/bin/test -r /srv/tee_world_candidate_testing/warehouse/archive/maps.7z
ExecStartPre=/usr/bin/test -r /srv/tee_world_candidate_testing/warehouse/index/maps-v1.tsv
ExecStartPre=/usr/bin/test -r /srv/tee_world_candidate_testing/warehouse/index/map-metadata-v1.tsv
ExecStartPre=/usr/bin/test -d /srv/tee_world_candidate_testing/warehouse/delta
ExecStartPre=/usr/bin/test -x /srv/tee_world_candidate_testing/warehouse/tools/7zip-26.00/usr/lib/7zip/7za
ExecStartPre=/usr/bin/sha256sum --check --strict --quiet /srv/tee_world_candidate_testing/warehouse/manifest.sha256
ExecStart=/srv/tee_world_candidate_testing/build/ddnet/DDNet-Server
Restart=on-failure
RestartSec=3s
KillSignal=SIGTERM
TimeoutStopSec=15s
UMask=0077
StandardOutput=append:/srv/tee_world_candidate_testing/server/logs/console.log
StandardError=append:/srv/tee_world_candidate_testing/server/logs/console.log

[Install]
WantedBy=default.target
