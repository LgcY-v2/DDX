+TEST_F(CMapArchiveTest, MaxLengthUtf8CollectionNameKeepsRandomRowWithinProtocolLimits)
+{
+	WriteIndex(DefaultMaps());
+	CMapArchive Archive;
+	Load(&Archive);
+	std::string LongName;
+	for(int Index = 0; Index < 10; ++Index)
+		LongName += "Äö";
+	ASSERT_EQ(LongName.size(), 40U);
+	const std::string SearchInput = "aip --name " + LongName;
+	const CMapArchive::SSearchResult Search = Archive.Search(SearchInput.c_str(), m_pStorage.get());
+	ASSERT_EQ(Search.m_Status, CMapArchive::ESearchStatus::CREATED);
+	CreateCoreMapCatalog();
+
+	CMapVoteCatalog Catalog;
+	std::string Error;
+	ASSERT_TRUE(Catalog.BuildFromStorageType(m_pStorage.get(), IStorage::TYPE_SAVE, nullptr, &Archive, &Error)) << Error;
+	const CMapVoteCatalog::SPageId Collection{CMapVoteCatalog::EPage::ARCHIVE_COLLECTION, Search.m_CollectionId, 0};
+
+	int RandomRows = 0;
+	for(int Index = 0; Index < Catalog.OptionCount(Collection); ++Index)
+	{
+		const CMapVoteCatalog::SEntry *pEntry = Catalog.OptionAt(Collection, Index);
+		ASSERT_NE(pEntry, nullptr);
+		if(pEntry->m_Kind != CMapVoteCatalog::EOptionKind::RANDOM)
+			continue;
+		++RandomRows;
+		EXPECT_EQ(Index, 1);
+		EXPECT_TRUE(str_utf8_check(pEntry->m_Description.c_str()));
+		EXPECT_LT(pEntry->m_Description.size(), static_cast<size_t>(VOTE_DESC_LENGTH));
+		char aCommand[VOTE_CMD_LENGTH];
+		EXPECT_TRUE(Catalog.ResolveCommand(*pEntry, aCommand, sizeof(aCommand)));
+	}
+	ASSERT_EQ(RandomRows, 1);
+	const CMapVoteCatalog::SEntry *pRandom = Catalog.OptionAt(Collection, 1);
+	ASSERT_NE(pRandom, nullptr);
+	EXPECT_TRUE(str_startswith(pRandom->m_Description.c_str(), "★ Random "));
+	EXPECT_TRUE(str_endswith(pRandom->m_Description.c_str(), " map"));
+}
