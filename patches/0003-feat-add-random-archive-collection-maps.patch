+TEST_F(CMapArchiveTest, CollectionRandomUsesOnlyEligibleContents)
+{
+	WriteIndex(DefaultMaps());
+	CMapArchive Archive;
+	Load(&Archive);
+	const CMapArchive::SSearchResult Search = Archive.Search("*aip*race*", m_pStorage.get());
+	ASSERT_EQ(Search.m_Status, CMapArchive::ESearchStatus::CREATED);
+	CreateCoreMapCatalog();
+
+	CMapVoteCatalog Catalog;
+	std::string Error;
+	ASSERT_TRUE(Catalog.BuildFromStorageType(m_pStorage.get(), IStorage::TYPE_SAVE, nullptr, &Archive, &Error)) << Error;
+	using EKind = CMapVoteCatalog::EOptionKind;
+	const CMapVoteCatalog::SPageId Collection{CMapVoteCatalog::EPage::ARCHIVE_COLLECTION, Search.m_CollectionId, 0};
+
+	const CMapVoteCatalog::SEntry *pRandom = Catalog.Find(Collection, "★ Random AIP · Race map");
+	ASSERT_NE(pRandom, nullptr);
+	EXPECT_EQ(pRandom->m_Kind, EKind::RANDOM);
+
+	const std::set<std::string> ExpectedCommands{
+		"archive_map \"" + TestHash(1) + "\"",
+		"archive_map \"" + TestHash(3) + "\""};
+	constexpr int Samples = 32;
+	for(int Index = 0; Index < Samples; ++Index)
+	{
+		char aCommand[VOTE_CMD_LENGTH];
+		ASSERT_TRUE(Catalog.ResolveCommand(*pRandom, aCommand, sizeof(aCommand)));
+		EXPECT_EQ(ExpectedCommands.count(aCommand), 1U);
+	}
+
+	CMapVoteCatalog::SEntry UnknownCollection = *pRandom;
+	UnknownCollection.m_RandomType = 9999;
+	char aCommand[VOTE_CMD_LENGTH];
+	EXPECT_FALSE(Catalog.ResolveCommand(UnknownCollection, aCommand, sizeof(aCommand)));
+	EXPECT_STREQ(aCommand, "");
+	EXPECT_FALSE(Catalog.ResolveCommand(*pRandom, aCommand, 8));
+	EXPECT_STREQ(aCommand, "");
+
+	for(int SortIndex = 0; SortIndex < static_cast<int>(CMapVoteCatalog::ESort::COUNT); ++SortIndex)
+	{
+		const auto Sort = static_cast<CMapVoteCatalog::ESort>(SortIndex);
+		if(Sort == CMapVoteCatalog::ESort::DATE_NEWEST || Sort == CMapVoteCatalog::ESort::DATE_OLDEST)
+			continue;
+		const CMapVoteCatalog::SPageId SortedCollection{CMapVoteCatalog::EPage::ARCHIVE_COLLECTION, Search.m_CollectionId, 0, Sort};
+		ASSERT_NE(Catalog.Find(SortedCollection, "★ Random AIP · Race map"), nullptr) << static_cast<int>(Sort);
+	}
+	const CMapVoteCatalog::SPageId SortSettings{CMapVoteCatalog::EPage::ARCHIVE_SORT, Search.m_CollectionId, 0};
+	EXPECT_EQ(Catalog.Find(SortSettings, "★ Random AIP · Race map"), nullptr);
+}
