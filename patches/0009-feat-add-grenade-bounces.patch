diff --git a/src/test/ddx_grenade_bounce_test.cpp b/src/test/ddx_grenade_bounce_test.cpp
new file mode 100644
index 0000000..4856661
--- /dev/null
+++ b/src/test/ddx_grenade_bounce_test.cpp
@@ -0,0 +1,38 @@
+#include <game/server/ddx_grenade_bounce.h>
+
+#include <gtest/gtest.h>
+
+TEST(DdxGrenadeBounce, KeepsCustomGrenadesAliveThroughTheirFinalBounce)
+{
+	EXPECT_EQ(DdxGrenadeBounce::InitialRemaining(0), DdxGrenadeBounce::DISABLED);
+	EXPECT_TRUE(DdxGrenadeBounce::UsesVanillaLifetime(DdxGrenadeBounce::DISABLED));
+
+	int Remaining = DdxGrenadeBounce::InitialRemaining(3);
+	for(int Bounce = 0; Bounce < 3; Bounce++)
+	{
+		EXPECT_TRUE(DdxGrenadeBounce::CanBounce(Remaining));
+		Remaining = DdxGrenadeBounce::AfterBounce(Remaining);
+	}
+	EXPECT_EQ(Remaining, 0);
+	EXPECT_FALSE(DdxGrenadeBounce::CanBounce(Remaining));
+	EXPECT_FALSE(DdxGrenadeBounce::UsesVanillaLifetime(Remaining));
+}
+
+TEST(DdxGrenadeBounce, ReflectsTheImpactDirection)
+{
+	const vec2 FloorBounce = DdxGrenadeBounce::BounceDirection(
+		vec2(1.0f, 0.0f), 7.0f, 1000.0f, 0.5f, false, true);
+	EXPECT_GT(FloorBounce.x, 0.0f);
+	EXPECT_LT(FloorBounce.y, 0.0f);
+	EXPECT_NEAR(length(FloorBounce), 1.0f, 0.0001f);
+
+	const vec2 WallBounce = DdxGrenadeBounce::BounceDirection(
+		vec2(1.0f, 0.0f), 0.0f, 1000.0f, 0.5f, true, false);
+	EXPECT_FLOAT_EQ(WallBounce.x, -1.0f);
+	EXPECT_FLOAT_EQ(WallBounce.y, 0.0f);
+
+	const vec2 CornerBounce = DdxGrenadeBounce::BounceDirection(
+		vec2(1.0f, 0.0f), 0.0f, 1000.0f, 0.5f, false, false);
+	EXPECT_FLOAT_EQ(CornerBounce.x, -1.0f);
+	EXPECT_FLOAT_EQ(CornerBounce.y, 0.0f);
+}
