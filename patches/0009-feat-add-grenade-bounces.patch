+void CGameContext::ConGrenadeBounces(IConsole::IResult *pResult, void *pUserData)
+{
+	CGameContext *pSelf = (CGameContext *)pUserData;
+	const int Bounces = pResult->GetInteger(0);
+	if(Bounces < 0)
+	{
+		pSelf->Console()->Print(IConsole::OUTPUT_LEVEL_STANDARD, "grenade_bounces", "bounces must be 0 or greater");
+		return;
+	}
+
+	const int ClientId = pResult->NumArguments() > 1 ? pResult->GetVictim() : pResult->m_ClientId;
+	if(!CheckClientId(ClientId))
+	{
+		pSelf->Console()->Print(IConsole::OUTPUT_LEVEL_STANDARD, "grenade_bounces", "a client must be specified outside rcon");
+		return;
+	}
+	CPlayer *pPlayer = pSelf->m_apPlayers[ClientId];
+	if(!pPlayer)
+	{
+		pSelf->Console()->Print(IConsole::OUTPUT_LEVEL_STANDARD, "grenade_bounces", "client is not connected");
+		return;
+	}
+
+	pPlayer->m_GrenadeBounces = Bounces;
+	char aBuf[96];
+	str_format(aBuf, sizeof(aBuf), "grenade bounces client %d: %d", ClientId, Bounces);
+	pSelf->Console()->Print(IConsole::OUTPUT_LEVEL_STANDARD, "grenade_bounces", aBuf);
+}
