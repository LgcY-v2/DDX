+#ifndef GAME_SERVER_DDX_GRENADE_BOUNCE_H
+#define GAME_SERVER_DDX_GRENADE_BOUNCE_H
+
+#include <base/vmath.h>
+
+namespace DdxGrenadeBounce
+{
+constexpr int DISABLED = -1;
+
+constexpr int InitialRemaining(int Bounces)
+{
+	return Bounces > 0 ? Bounces : DISABLED;
+}
+
+constexpr bool UsesVanillaLifetime(int Remaining)
+{
+	// Zero means the extra bounces are spent, but the grenade still waits for its final impact.
+	return Remaining == DISABLED;
+}
+
+constexpr bool CanBounce(int Remaining)
+{
+	return Remaining > 0;
+}
+
+constexpr int AfterBounce(int Remaining)
+{
+	return Remaining - 1;
+}
+
+inline vec2 BounceDirection(vec2 Direction, float Curvature, float Speed, float Time, bool HitX, bool HitY)
+{
+	Direction.y += 2.0f * Curvature * Speed * Time / 10000.0f;
+	if(!HitX && !HitY)
+	{
+		HitX = true;
+		HitY = true;
+	}
+	if(HitX)
+		Direction.x = -Direction.x;
+	if(HitY)
+		Direction.y = -Direction.y;
+	return normalize(Direction);
+}
+} // namespace DdxGrenadeBounce
+
+#endif // GAME_SERVER_DDX_GRENADE_BOUNCE_H
