+void CGameContext::DeleteMapVoteCollection(int ClientId, int CollectionId)
+{
+	const CMapArchive::SDeleteResult Result = m_MapArchive.DeleteCollection(CollectionId, Storage());
+	if(Result.m_Status == CMapArchive::EDeleteStatus::ERROR)
+	{
+		char aMessage[256];
+		str_format(aMessage, sizeof(aMessage), "Could not delete collection #%d: %s", CollectionId, Result.m_Message.c_str());
+		SendChatTarget(ClientId, aMessage);
+		return;
+	}
+	RefreshArchiveMapVotePages();
+	if(Result.m_Status == CMapArchive::EDeleteStatus::NOT_FOUND)
+	{
+		SendChatTarget(ClientId, "That collection no longer exists. The management page was refreshed.");
+		return;
+	}
+	char aMessage[256];
+	str_format(aMessage, sizeof(aMessage), "Deleted collection #%d: %s.", Result.m_Collection.m_Id, Result.m_Collection.m_Name.c_str());
+	SendChatTarget(ClientId, aMessage);
+}
