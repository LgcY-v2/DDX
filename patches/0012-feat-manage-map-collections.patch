+TEST_F(CMapArchiveTest, DeletesCollectionsByStableIdAndPersistsTheResult)
+{
+	WriteIndex(DefaultMaps());
+	CMapArchive Archive;
+	Load(&Archive);
+	const auto First = Archive.Search("aip --name First collection", m_pStorage.get());
+	const auto Middle = Archive.Search("race --name Middle · special", m_pStorage.get());
+	const auto Last = Archive.Search("gores --name Last collection", m_pStorage.get());
+	ASSERT_EQ(First.m_Status, CMapArchive::ESearchStatus::CREATED);
+	ASSERT_EQ(Middle.m_Status, CMapArchive::ESearchStatus::CREATED);
+	ASSERT_EQ(Last.m_Status, CMapArchive::ESearchStatus::CREATED);
+
+	const CMapArchive::SDeleteResult Deleted = Archive.DeleteCollection(Middle.m_CollectionId, m_pStorage.get());
+	ASSERT_EQ(Deleted.m_Status, CMapArchive::EDeleteStatus::DELETED);
+	EXPECT_EQ(Deleted.m_Collection.m_Name, "Middle · special");
+	EXPECT_EQ(Archive.CollectionById(Middle.m_CollectionId), nullptr);
+	EXPECT_NE(Archive.CollectionById(First.m_CollectionId), nullptr);
+	EXPECT_NE(Archive.CollectionById(Last.m_CollectionId), nullptr);
+	EXPECT_EQ(Archive.DeleteCollection(Middle.m_CollectionId, m_pStorage.get()).m_Status, CMapArchive::EDeleteStatus::NOT_FOUND);
+
+	CMapArchive Reloaded;
+	Load(&Reloaded);
+	EXPECT_EQ(Reloaded.Collections().size(), 2U);
+	EXPECT_EQ(Reloaded.CollectionById(Middle.m_CollectionId), nullptr);
+}
+
+TEST_F(CMapArchiveTest, FailedDeletePreservesMemoryAndPersistedState)
+{
+	WriteIndex(DefaultMaps());
+	CMapArchive Archive;
+	Load(&Archive);
+	const auto Search = Archive.Search("gores --name Keep me", m_pStorage.get());
+	ASSERT_EQ(Search.m_Status, CMapArchive::ESearchStatus::CREATED);
+	char aTemporary[IO_MAX_PATH_LENGTH];
+	str_format(aTemporary, sizeof(aTemporary), "state/collections.tsv.%d.tmp", process_id());
+	ASSERT_TRUE(m_pStorage->CreateFolder(aTemporary, IStorage::TYPE_SAVE));
+
+	const CMapArchive::SDeleteResult Result = Archive.DeleteCollection(Search.m_CollectionId, m_pStorage.get());
+	EXPECT_EQ(Result.m_Status, CMapArchive::EDeleteStatus::ERROR);
+	EXPECT_NE(Archive.CollectionById(Search.m_CollectionId), nullptr);
+	ASSERT_TRUE(m_pStorage->RemoveFolder(aTemporary, IStorage::TYPE_SAVE));
+
+	CMapArchive Reloaded;
+	Load(&Reloaded);
+	EXPECT_NE(Reloaded.CollectionById(Search.m_CollectionId), nullptr);
 }
 
