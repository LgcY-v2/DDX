+	}
+	Result.m_Collection = *It;
+	std::vector<SCollection> vCandidate = m_vCollections;
+	vCandidate.erase(vCandidate.begin() + std::distance(m_vCollections.begin(), It));
+	if(!SaveCollections(pStorage, vCandidate, &Result.m_Message))
+		return Result;
+	m_vCollections = std::move(vCandidate);
+	Result.m_Status = EDeleteStatus::DELETED;
+	Result.m_Message = "Search collection deleted";
+	return Result;
+}
