+void CGameContext::ConDeleteMapCollection(IConsole::IResult *pResult, void *pUserData)
+{
+	auto *pSelf = static_cast<CGameContext *>(pUserData);
+	const int CollectionId = pResult->GetInteger(0);
+	const CMapArchive::SDeleteResult Result = pSelf->m_MapArchive.DeleteCollection(CollectionId, pSelf->Storage());
+	char aMessage[256];
+	if(Result.m_Status == CMapArchive::EDeleteStatus::ERROR)
+		str_format(aMessage, sizeof(aMessage), "failed to delete collection #%d: %s", CollectionId, Result.m_Message.c_str());
+	else if(Result.m_Status == CMapArchive::EDeleteStatus::NOT_FOUND)
+		str_format(aMessage, sizeof(aMessage), "collection #%d no longer exists", CollectionId);
+	else
+		str_format(aMessage, sizeof(aMessage), "deleted collection #%d: %s", Result.m_Collection.m_Id, Result.m_Collection.m_Name.c_str());
+	pSelf->Console()->Print(IConsole::OUTPUT_LEVEL_STANDARD, "map-archive", aMessage);
+	if(Result.m_Status != CMapArchive::EDeleteStatus::ERROR)
+		pSelf->RefreshArchiveMapVotePages();
+}
