+
+		void WriteIndex(const std::vector<STestMap> &vMaps, const char *pAuthorityHash = AUTHORITY_HASH, int DeclaredUnique = -1)
+		{
+			std::set<std::string> UniqueHashes;
+			for(const STestMap &Map : vMaps)
+				UniqueHashes.insert(Map.m_Hash);
+			if(DeclaredUnique < 0)
+				DeclaredUnique = static_cast<int>(UniqueHashes.size());
+			std::string Index = std::string("TW_MAP_WAREHOUSE_INDEX\t1\n") +
+					    "archive_sha256\t" + ARCHIVE_HASH + "\n" +
+					    "archive_size\t123\n" +
+					    "authority_listing_sha256\t" + pAuthorityHash + "\n" +
+					    "mirror_listing_sha256\t" + MIRROR_HASH + "\n" +
+					    "map_entries\t" + std::to_string(vMaps.size()) + "\n" +
+					    "unique_content\t" + std::to_string(DeclaredUnique) + "\n\n";
+			for(const STestMap &Map : vMaps)
+			{
+				Index += "M\t" + PercentEncode(Map.m_Name) + "\t" + Map.m_Hash + "\t" + std::to_string(Map.m_Size) + "\tA\t" + Map.m_Hash + ".map\n";
+			}
+			ASSERT_TRUE(WriteFile(m_pStorage.get(), "warehouse-index.tsv", Index));
+		}
+
+		void Load(CMapWarehouse *pWarehouse)
+		{
+			std::string Error;
+			ASSERT_TRUE(pWarehouse->Load(m_pStorage.get(), nullptr, "warehouse-index.tsv", "state/collections.tsv", &Error)) << Error;
+			ASSERT_TRUE(Error.empty());
+		}
+
+		void CreateCoreMapCatalog()
+		{
+			const char *apDirectories[] = {
+				"maps",
+				"maps/tw_maps",
+				"maps/tw_maps/ddnet-maps-master",
+				"maps/tw_maps/ddnet-maps-master/types",
+				"maps/tw_maps/ddnet-maps-master/types/novice",
+				"maps/tw_maps/ddnet-maps-master/types/novice/maps",
+				"maps/tw_maps/KoGmaps-main",
+				"maps/tw_maps/KoGmaps-main/HARD",
+			};
+			for(const char *pDirectory : apDirectories)
+			{
+				ASSERT_TRUE(m_pStorage->CreateFolder(pDirectory, IStorage::TYPE_SAVE));
+				m_vCoreMapDirectories.emplace_back(pDirectory);
+			}
+			m_vCoreMapFiles = {
+				"maps/tw_maps/ddnet-maps-master/types/novice/maps/Alpha.map",
+				"maps/tw_maps/KoGmaps-main/HARD/Omega.map",
+			};
+			for(const std::string &Path : m_vCoreMapFiles)
+				ASSERT_TRUE(WriteFile(m_pStorage.get(), Path.c_str(), ""));
