+		int m_AliasMatches = 0;
+		std::string m_CollectionName;
+		std::string m_Message;
+	};
+
+	struct SPreparedMap
+	{
+		bool m_Finished = false;
+		bool m_Success = false;
+		std::string m_MapPath;
+		std::string m_DisplayName;
+		std::string m_Error;
+	};
+
+	CMapWarehouse();
+	~CMapWarehouse();
+
+	CMapWarehouse(const CMapWarehouse &) = delete;
+	CMapWarehouse &operator=(const CMapWarehouse &) = delete;
+
+	bool Load(IStorage *pStorage, IConsole *pConsole, const char *pIndexPath, const char *pStatePath, std::string *pError);
+	bool Active() const { return m_Active; }
+	int AliasCount() const { return static_cast<int>(m_vMaps.size()); }
+	int UniqueMapCount() const { return m_UniqueMapCount; }
+	const std::vector<SCollection> &Collections() const { return m_vCollections; }
+	const SMap *Map(int Index) const;
+	const SCollection *CollectionById(int Id) const;
+
+	SSearchResult Search(const char *pInput, IStorage *pStorage);
+	bool ClearCollections(IStorage *pStorage, std::string *pError);
+
+	bool QueueMap(const char *pHash, IEngine *pEngine, IStorage *pStorage, const char *pArchivePath, const char *pDeltaDirectory, const char *pExtractorPath, const char *pCacheDirectory, int CacheMaxMegabytes, int CacheMaxMaps, const char *pCurrentMapPath, std::string *pDisplayName, std::string *pError);
+	SPreparedMap PollPreparedMap();
+	bool Busy() const { return m_pExtractJob != nullptr; }
+	int64_t PrepareStartTime() const { return m_PrepareStartTime; }
+	const std::string &PreparingDisplayName() const { return m_PreparingDisplayName; }
+	void AbortPreparation();
+
+private:
+	bool m_Active = false;
+	int m_UniqueMapCount = 0;
+	int m_NextCollectionId = 1;
+	std::string m_IndexIdentity;
+	std::string m_StatePath;
+	std::vector<SMap> m_vMaps;
+	std::vector<SCollection> m_vCollections;
+	std::shared_ptr<IJob> m_pExtractJob;
+	int64_t m_PrepareStartTime = 0;
+	std::string m_PreparingDisplayName;
+
+	bool LoadIndex(IStorage *pStorage, const char *pIndexPath, std::string *pError);
+	bool LoadCollections(IStorage *pStorage, std::string *pError);
+	bool SaveCollections(IStorage *pStorage, std::string *pError) const;
+	const SMap *CanonicalMapByHash(const char *pHash) const;
+};
