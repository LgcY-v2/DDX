+	constexpr std::array<const char *, 8> TEST_DIRECTORIES = {
+		"maps",
+		"maps/tw_maps",
+		"maps/tw_maps/ddnet-maps-master",
+		"maps/tw_maps/ddnet-maps-master/types",
+		"maps/tw_maps/ddnet-maps-master/types/novice",
+		"maps/tw_maps/ddnet-maps-master/types/novice/maps",
+		"maps/tw_maps/KoGmaps-main",
+		"maps/tw_maps/KoGmaps-main/HARD",
+	};
+
+	constexpr const char *DDRACE_MAP = "maps/tw_maps/ddnet-maps-master/types/novice/maps/Alpha.map";
+	constexpr const char *GORES_MAP = "maps/tw_maps/KoGmaps-main/HARD/Omega.map";
+	constexpr const char *OTHER_MAP = "maps/dm_1.map";
+
+	constexpr std::array<const char *, 3> TEST_MAPS = {
+		DDRACE_MAP,
+		GORES_MAP,
+		OTHER_MAP,
+	};
+
+	struct SExpectedOption
+	{
+		EOptionKind m_Kind;
+		const char *m_pDescription;
+	};
+
+	void ExpectPage(const CMapVoteCatalog &Catalog, SPageId Page, std::initializer_list<SExpectedOption> Expected)
+	{
+		ASSERT_EQ(Catalog.OptionCount(Page), static_cast<int>(Expected.size()));
+		int Index = 0;
+		for(const SExpectedOption &Option : Expected)
+		{
+			const CMapVoteCatalog::SEntry *pEntry = Catalog.OptionAt(Page, Index++);
+			ASSERT_NE(pEntry, nullptr);
+			EXPECT_EQ(pEntry->m_Kind, Option.m_Kind);
+			EXPECT_STREQ(pEntry->m_Description.c_str(), Option.m_pDescription);
+			EXPECT_LT(pEntry->m_Description.size(), static_cast<size_t>(VOTE_DESC_LENGTH));
+			EXPECT_EQ(pEntry->m_Description.find("@TAS"), std::string::npos);
+			EXPECT_EQ(pEntry->m_Description.find('|'), std::string::npos);
+		}
+	}
+
+	void ExpectResolvedCommand(const CMapVoteCatalog &Catalog, const CMapVoteCatalog::SEntry *pEntry, const char *pExpected)
+	{
+		ASSERT_NE(pEntry, nullptr);
+		char aCommand[VOTE_CMD_LENGTH];
+		ASSERT_TRUE(Catalog.ResolveCommand(*pEntry, aCommand, sizeof(aCommand)));
+		EXPECT_STREQ(aCommand, pExpected);
+	}
