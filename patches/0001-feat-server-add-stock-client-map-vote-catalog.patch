+TEST_F(CMapWarehouseTest, PublishesReadableArchiveGuideAndCollectionPages)
+{
+	WriteIndex(DefaultMaps());
+	CMapWarehouse Warehouse;
+	Load(&Warehouse);
+	const CMapWarehouse::SSearchResult Search = Warehouse.Search("*aip*race*", m_pStorage.get());
+	ASSERT_EQ(Search.m_Status, CMapWarehouse::ESearchStatus::CREATED);
+	CreateCoreMapCatalog();
+
+	CMapVoteCatalog Catalog;
+	std::string Error;
+	ASSERT_TRUE(Catalog.BuildFromStorageType(m_pStorage.get(), IStorage::TYPE_SAVE, nullptr, &Warehouse, &Error)) << Error;
+	using EKind = CMapVoteCatalog::EOptionKind;
+	using EPage = CMapVoteCatalog::EPage;
+	const CMapVoteCatalog::SPageId Root{EPage::ROOT, -1};
+	const CMapVoteCatalog::SPageId Hub{EPage::WAREHOUSE, -1};
+	const CMapVoteCatalog::SPageId Guide{EPage::WAREHOUSE_GUIDE, -1};
+	const CMapVoteCatalog::SPageId Collection{EPage::WAREHOUSE_COLLECTION, Search.m_CollectionId, 0};
+
+	ASSERT_EQ(Catalog.OptionCount(Root), 7);
+	const CMapVoteCatalog::SEntry *pArchive = Catalog.OptionAt(Root, 0);
+	ASSERT_NE(pArchive, nullptr);
+	EXPECT_EQ(pArchive->m_Kind, EKind::FOLDER);
+	EXPECT_EQ(pArchive->m_Description, "Search 6 archive maps  ›");
+	EXPECT_EQ(pArchive->m_TargetPage, Hub);
+	const CMapVoteCatalog::SEntry *pRandomArchive = Catalog.OptionAt(Root, 6);
+	ASSERT_NE(pRandomArchive, nullptr);
+	EXPECT_EQ(pRandomArchive->m_Kind, EKind::RANDOM);
+	EXPECT_EQ(pRandomArchive->m_Description, "★ Random archive map");
+
+	ASSERT_EQ(Catalog.OptionCount(Hub), 5);
+	EXPECT_EQ(Catalog.OptionAt(Hub, 1)->m_Kind, EKind::INFO);
+	EXPECT_EQ(Catalog.OptionAt(Hub, 1)->m_Description, "━━  Historical Map Archive  ━━");
+	EXPECT_EQ(Catalog.OptionAt(Hub, 2)->m_Description, "6 names · 5 unique maps");
+	EXPECT_EQ(Catalog.OptionAt(Hub, 3)->m_TargetPage, Guide);
+	EXPECT_EQ(Catalog.OptionAt(Hub, 3)->m_Description, "Search guide & syntax  ›");
+	EXPECT_EQ(Catalog.OptionAt(Hub, 4)->m_Description, "AIP · Race · 2 maps  ›");
+	EXPECT_EQ(Catalog.OptionAt(Hub, 4)->m_TargetPage, Collection);
+	EXPECT_EQ(Catalog.OptionCount(Guide), 8);
+
+	ASSERT_EQ(Catalog.OptionCount(Collection), 5);
+	EXPECT_EQ(Catalog.OptionAt(Collection, 0)->m_Kind, EKind::BACK);
+	EXPECT_EQ(Catalog.OptionAt(Collection, 1)->m_Kind, EKind::INFO);
+	EXPECT_EQ(Catalog.OptionAt(Collection, 2)->m_Description, "2 maps · page 1 of 1");
+	for(int Index = 3; Index < Catalog.OptionCount(Collection); ++Index)
+	{
+		const CMapVoteCatalog::SEntry *pMap = Catalog.OptionAt(Collection, Index);
+		ASSERT_NE(pMap, nullptr);
+		EXPECT_EQ(pMap->m_Kind, EKind::MAP);
+		EXPECT_TRUE(str_startswith(pMap->m_Description.c_str(), "• "));
+		char aCommand[VOTE_CMD_LENGTH];
+		ASSERT_TRUE(Catalog.ResolveCommand(*pMap, aCommand, sizeof(aCommand)));
+		EXPECT_TRUE(str_startswith(aCommand, "warehouse_map "));
+	}
+}
