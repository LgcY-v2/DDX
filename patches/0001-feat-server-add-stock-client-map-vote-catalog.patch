+	WriteIndex({{"Empty", TestHash(2), 0}});
+	CMapWarehouse EmptyWarehouse;
+	Load(&EmptyWarehouse);
+	ASSERT_TRUE(Catalog.BuildFromStorageType(m_pStorage.get(), IStorage::TYPE_SAVE, nullptr, &EmptyWarehouse, &Error)) << Error;
+	EXPECT_EQ(Catalog.OptionCount(Root), 6);
+	EXPECT_EQ(Catalog.Find(Root, "★ Random archive map"), nullptr);
+}
