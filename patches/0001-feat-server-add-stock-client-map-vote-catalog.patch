+bool CMapVoteCatalog::Build(IStorage *pStorage, IConsole *pConsole, const CMapWarehouse *pWarehouse, std::string *pError)
+{
+	return BuildFromStorageType(pStorage, IStorage::TYPE_ALL, pConsole, pWarehouse, pError);
+}
+
+bool CMapVoteCatalog::BuildFromStorageType(IStorage *pStorage, int StorageType, IConsole *pConsole, const CMapWarehouse *pWarehouse, std::string *pError)
+{
+	if(pError)
+		pError->clear();
+	if(!pStorage)
+	{
+		SetError(pError, "storage is unavailable");
+		return false;
+	}
+
+	CMapVoteCatalog Candidate;
+	bool PathTruncated = false;
+	auto ScanTypes = [&](const char *pTypesRoot, bool Ddrace, std::vector<SType> *pOutTypes) {
+		for(const std::string &TypeName : ScanNames(pStorage, StorageType, pTypesRoot, true))
+		{
+			char aMapDirectory[IO_MAX_PATH_LENGTH];
+			if(str_format(aMapDirectory, sizeof(aMapDirectory), "%s/%s%s", pTypesRoot, TypeName.c_str(), Ddrace ? "/maps" : "") >= static_cast<int>(sizeof(aMapDirectory)))
+			{
+				PathTruncated = true;
+				return;
+			}
+			const std::vector<std::string> vMapNames = ScanNames(pStorage, StorageType, aMapDirectory, false);
+			if(vMapNames.empty())
+				continue;
+
+			SType Type;
+			Type.m_Name = TypeName;
+			// Both map corpora use machine-oriented directory names. Publish
+			// consistent reader-facing labels instead of leaking their casing
+			// and separator conventions into the vote menu.
+			Type.m_DisplayName = PrettyTypeName(TypeName);
+			Type.m_vMaps.reserve(vMapNames.size());
+			for(const std::string &MapName : vMapNames)
+			{
+				char aPath[IO_MAX_PATH_LENGTH];
+				if(str_format(aPath, sizeof(aPath), "%s/%s", aMapDirectory + str_length("maps/"), MapName.c_str()) >= static_cast<int>(sizeof(aPath)))
+				{
+					PathTruncated = true;
+					return;
+				}
+				Type.m_vMaps.push_back({MapName, aPath});
+			}
+			pOutTypes->push_back(std::move(Type));
+		}
+	};
+
+	ScanTypes("maps/tw_maps/ddnet-maps-master/types", true, &Candidate.m_vDdraceTypes);
+	ScanTypes("maps/tw_maps/KoGmaps-main", false, &Candidate.m_vGoresTypes);
+	DisambiguateTypeDisplayNames(Candidate.m_vDdraceTypes);
+	DisambiguateTypeDisplayNames(Candidate.m_vGoresTypes);
+	if(PathTruncated)
+	{
+		SetError(pError, "a map catalog path exceeds the supported length");
+		return false;
+	}
+	for(const std::string &MapName : ScanNames(pStorage, StorageType, "maps", false))
+		Candidate.m_vOtherMaps.push_back({MapName, MapName});
+
+	if(Candidate.m_vDdraceTypes.empty() || Candidate.m_vGoresTypes.empty())
+	{
+		SetError(pError, "DDRace or Gores map roots are missing or empty");
+		return false;
+	}
+	if(Candidate.MapCount() > MAX_VOTE_OPTIONS)
+	{
+		SetError(pError, "map catalog exceeds the vote option safety limit");
+		return false;
+	}
+
+	if(pWarehouse && pWarehouse->Active())
+	{
+		Candidate.m_WarehouseAliases = pWarehouse->AliasCount();
+		Candidate.m_WarehouseUniqueMaps = pWarehouse->UniqueMapCount();
+		std::unordered_set<std::string> SeenHashes;
+		SeenHashes.reserve(pWarehouse->UniqueMapCount());
+		Candidate.m_vWarehouseRandomHashes.reserve(pWarehouse->UniqueMapCount());
+		for(int MapIndex = 0; MapIndex < pWarehouse->AliasCount(); ++MapIndex)
+		{
+			const CMapWarehouse::SMap *pMap = pWarehouse->Map(MapIndex);
+			if(pMap && pMap->m_Size > 0 && SeenHashes.insert(pMap->m_Hash).second)
+				Candidate.m_vWarehouseRandomHashes.push_back(pMap->m_Hash);
+		}
+	}
+	if(!Candidate.BuildWarehousePages(pWarehouse, pError) || !Candidate.BuildPages(pError))
+		return false;
+	Candidate.m_Active = true;
+	*this = std::move(Candidate);
+
+	if(pConsole)
+	{
+		char aMessage[160];
+		str_format(aMessage, sizeof(aMessage), "published %d maps in %d DDRace and %d Gores types", MapCount(), static_cast<int>(m_vDdraceTypes.size()), static_cast<int>(m_vGoresTypes.size()));
+		pConsole->Print(IConsole::OUTPUT_LEVEL_STANDARD, "map-votes", aMessage);
+	}
+	return true;
+}
+
+bool CMapVoteCatalog::BuildPages(std::string *pError)
+{
+	auto Navigation = [](const char *pLabel, SPageId Target) {
+		SEntry Entry;
+		Entry.m_Kind = EOptionKind::FOLDER;
+		Entry.m_Description = pLabel;
+		Entry.m_TargetPage = Target;
+		return Entry;
+	};
+	auto Back = [](const char *pLabel, SPageId Target) {
+		SEntry Entry;
+		Entry.m_Kind = EOptionKind::BACK;
+		Entry.m_Description = pLabel;
+		Entry.m_TargetPage = Target;
+		return Entry;
+	};
+	auto Random = [](const char *pLabel, ECategory Category, int Type) {
+		SEntry Entry;
+		Entry.m_Kind = EOptionKind::RANDOM;
+		Entry.m_Description = pLabel;
+		Entry.m_RandomCategory = static_cast<int>(Category);
+		Entry.m_RandomType = Type;
+		return Entry;
+	};
+	auto Map = [](const SMap &MapValue) {
+		SEntry Entry;
+		Entry.m_Kind = EOptionKind::MAP;
+		Entry.m_Description = MapValue.m_Name;
+		Entry.m_Command = MapCommand(MapValue.m_Path);
+		return Entry;
+	};
+
+	m_vRootPage.clear();
+	if(m_WarehouseAliases > 0)
+	{
+		char aArchiveLabel[VOTE_DESC_LENGTH];
+		str_format(aArchiveLabel, sizeof(aArchiveLabel), "Search %s archive maps  ›", FormatCount(m_WarehouseAliases).c_str());
+		m_vRootPage.push_back(Navigation(aArchiveLabel, {EPage::WAREHOUSE, -1}));
+	}
+	const std::vector<SEntry> vCoreRoot = {
+		Navigation("Browse DDRace maps  ›", {EPage::DDRACE_TYPES, -1}),
+		Navigation("Browse Gores maps  ›", {EPage::GORES_TYPES, -1}),
+		Navigation("Browse other maps  ›", {EPage::OTHERS, -1}),
+		Random("★ Random DDRace map", ECategory::DDRACE, -1),
+		Random("★ Random Gores map", ECategory::GORES, -1),
+	};
+	m_vRootPage.insert(m_vRootPage.end(), vCoreRoot.begin(), vCoreRoot.end());
+	if(!m_vWarehouseRandomHashes.empty())
+		m_vRootPage.push_back(Random("★ Random archive map", ECategory::WAREHOUSE, -1));
+
+	m_vDdracePage.push_back(Back("‹  Back to map categories", {EPage::ROOT, -1}));
+	for(int TypeIndex = 0; TypeIndex < static_cast<int>(m_vDdraceTypes.size()); ++TypeIndex)
+	{
+		char aLabel[VOTE_DESC_LENGTH];
+		str_format(aLabel, sizeof(aLabel), "Browse %s maps  ›", m_vDdraceTypes[TypeIndex].m_DisplayName.c_str());
+		m_vDdracePage.push_back(Navigation(aLabel, {EPage::DDRACE_TYPE, TypeIndex}));
+	}
+	m_vGoresPage.push_back(Back("‹  Back to map categories", {EPage::ROOT, -1}));
+	for(int TypeIndex = 0; TypeIndex < static_cast<int>(m_vGoresTypes.size()); ++TypeIndex)
+	{
+		char aLabel[VOTE_DESC_LENGTH];
+		str_format(aLabel, sizeof(aLabel), "Browse %s maps  ›", m_vGoresTypes[TypeIndex].m_DisplayName.c_str());
+		m_vGoresPage.push_back(Navigation(aLabel, {EPage::GORES_TYPE, TypeIndex}));
+	}
+
+	for(int TypeIndex = 0; TypeIndex < static_cast<int>(m_vDdraceTypes.size()); ++TypeIndex)
+	{
+		SType &Type = m_vDdraceTypes[TypeIndex];
+		char aRandomLabel[VOTE_DESC_LENGTH];
+		str_format(aRandomLabel, sizeof(aRandomLabel), "★ Random %s map", Type.m_DisplayName.c_str());
+		Type.m_vPage.push_back(Back("‹  Back to DDRace difficulties", {EPage::DDRACE_TYPES, -1}));
+		Type.m_vPage.push_back(Random(aRandomLabel, ECategory::DDRACE, TypeIndex));
+		for(const SMap &MapValue : Type.m_vMaps)
+			Type.m_vPage.push_back(Map(MapValue));
+	}
+	for(int TypeIndex = 0; TypeIndex < static_cast<int>(m_vGoresTypes.size()); ++TypeIndex)
+	{
+		SType &Type = m_vGoresTypes[TypeIndex];
+		char aRandomLabel[VOTE_DESC_LENGTH];
+		str_format(aRandomLabel, sizeof(aRandomLabel), "★ Random %s map", Type.m_DisplayName.c_str());
+		Type.m_vPage.push_back(Back("‹  Back to Gores difficulties", {EPage::GORES_TYPES, -1}));
+		Type.m_vPage.push_back(Random(aRandomLabel, ECategory::GORES, TypeIndex));
+		for(const SMap &MapValue : Type.m_vMaps)
+			Type.m_vPage.push_back(Map(MapValue));
+	}
+
+	m_vOthersPage.push_back(Back("‹  Back to map categories", {EPage::ROOT, -1}));
+	for(const SMap &MapValue : m_vOtherMaps)
+		m_vOthersPage.push_back(Map(MapValue));
+
+	auto ValidatePage = [&](const std::vector<SEntry> &vPage) {
+		std::vector<const char *> vpDescriptions;
+		vpDescriptions.reserve(vPage.size());
+		if(vPage.size() > MAX_VOTE_OPTIONS)
+			return false;
+		for(const SEntry &Entry : vPage)
+		{
+			if(Entry.m_Description.empty() || Entry.m_Description.size() >= VOTE_DESC_LENGTH ||
+				(Entry.m_Kind == EOptionKind::MAP && Entry.m_Command.empty()))
+				return false;
+			vpDescriptions.push_back(Entry.m_Description.c_str());
+		}
+		std::sort(vpDescriptions.begin(), vpDescriptions.end(), [](const char *pLeft, const char *pRight) {
+			return str_comp_nocase(pLeft, pRight) < 0;
+		});
+		for(size_t Index = 1; Index < vpDescriptions.size(); ++Index)
+			if(str_comp_nocase(vpDescriptions[Index - 1], vpDescriptions[Index]) == 0)
+				return false;
+		return true;
+	};
+	if(!ValidatePage(m_vRootPage) || !ValidatePage(m_vDdracePage) || !ValidatePage(m_vGoresPage) || !ValidatePage(m_vOthersPage) ||
+		!ValidatePage(m_vWarehousePage) || !ValidatePage(m_vWarehouseGuidePage))
+	{
+		SetError(pError, "a map vote page exceeds protocol limits");
+		return false;
+	}
+	for(const SType &Type : m_vDdraceTypes)
+		if(!ValidatePage(Type.m_vPage))
+		{
+			SetError(pError, "a DDRace map vote page exceeds protocol limits");
+			return false;
+		}
+	for(const SType &Type : m_vGoresTypes)
+		if(!ValidatePage(Type.m_vPage))
+		{
+			SetError(pError, "a Gores map vote page exceeds protocol limits");
+			return false;
+		}
+	for(const SWarehouseCollection &Collection : m_vWarehouseCollections)
+		for(const std::vector<SEntry> &vPage : Collection.m_vPages)
+			if(!ValidatePage(vPage))
+			{
+				SetError(pError, "an archive collection page exceeds protocol limits");
+				return false;
+			}
+	return true;
+}
+
+bool CMapVoteCatalog::BuildWarehousePages(const CMapWarehouse *pWarehouse, std::string *pError)
+{
+	if(!pWarehouse || !pWarehouse->Active())
+		return true;
+	auto Navigation = [](const std::string &Label, SPageId Target) {
+		SEntry Entry;
+		Entry.m_Kind = EOptionKind::FOLDER;
+		Entry.m_Description = Label;
+		Entry.m_TargetPage = Target;
+		return Entry;
+	};
+	auto Back = [](const char *pLabel, SPageId Target) {
+		SEntry Entry;
+		Entry.m_Kind = EOptionKind::BACK;
+		Entry.m_Description = pLabel;
+		Entry.m_TargetPage = Target;
+		return Entry;
+	};
+	auto Info = [](const std::string &Label, const std::string &Text) {
+		SEntry Entry;
+		Entry.m_Kind = EOptionKind::INFO;
+		Entry.m_Description = Label;
+		Entry.m_InfoText = Text;
+		return Entry;
+	};
+
+	m_vWarehousePage.push_back(Back("‹  Back to map categories", {EPage::ROOT, -1}));
+	m_vWarehousePage.push_back(Info("━━  Historical Map Archive  ━━", "Search 55,250 historical map names without unpacking the archive."));
+	char aCountLabel[VOTE_DESC_LENGTH];
+	str_format(aCountLabel, sizeof(aCountLabel), "%s names · %s unique maps", FormatCount(pWarehouse->AliasCount()).c_str(), FormatCount(pWarehouse->UniqueMapCount()).c_str());
+	m_vWarehousePage.push_back(Info(aCountLabel, "Duplicate historical names share one verified map file."));
+	m_vWarehousePage.push_back(Navigation("Search guide & syntax  ›", {EPage::WAREHOUSE_GUIDE, -1}));
+	if(pWarehouse->Collections().empty())
+		m_vWarehousePage.push_back(Info("No collections yet · type /search", "Example: /search *aip*race*"));
+
+	m_vWarehouseGuidePage = {
+		Back("‹  Back to the map archive", {EPage::WAREHOUSE, -1}),
+		Info("━━  /search Guide  ━━", "Type a /search command in chat, then open its collection here."),
+		Info("/search aip race · both, any order", "Find names containing both words, in any order."),
+		Info("/search *aip*race* · aip before race", "Find names with aip before race; * means any text."),
+		Info("* = any text · ? = one character", "Wildcards can appear anywhere inside a pattern."),
+		Info("-test · exclude matching names", "Example: /search race -test"),
+		Info("--name AIP Race · name the collection", "Example: /search aip race --name AIP Race"),
+		Info("No --name · create a clean automatic name", "Searches are saved and survive map changes and restarts."),
+	};
+
+	constexpr int MAPS_PER_PAGE = 44;
+	for(const CMapWarehouse::SCollection &WarehouseCollection : pWarehouse->Collections())
+	{
+		SWarehouseCollection Collection;
+		Collection.m_Id = WarehouseCollection.m_Id;
+		Collection.m_Name = WarehouseCollection.m_Name;
+		Collection.m_Query = WarehouseCollection.m_Query;
+		char aFolderSuffix[32];
+		str_format(aFolderSuffix, sizeof(aFolderSuffix), " · %d maps  ›", static_cast<int>(WarehouseCollection.m_vMapIndices.size()));
+		const std::string FolderLabel = TruncateLabel(Collection.m_Name, VOTE_DESC_LENGTH - str_length(aFolderSuffix) - 1) + aFolderSuffix;
+		m_vWarehousePage.push_back(Navigation(FolderLabel, {EPage::WAREHOUSE_COLLECTION, Collection.m_Id, 0}));
+
+		const int PageCount = (static_cast<int>(WarehouseCollection.m_vMapIndices.size()) + MAPS_PER_PAGE - 1) / MAPS_PER_PAGE;
+		Collection.m_vPages.resize(PageCount);
+		for(int PageIndex = 0; PageIndex < PageCount; ++PageIndex)
+		{
+			std::vector<SEntry> &vPage = Collection.m_vPages[PageIndex];
+			vPage.push_back(Back("‹  Back to archive collections", {EPage::WAREHOUSE, -1}));
+			const std::string Header = "━━  " + TruncateLabel(Collection.m_Name, 46) + "  ━━";
+			vPage.push_back(Info(Header, "Search: " + Collection.m_Query));
+			char aPageLabel[VOTE_DESC_LENGTH];
+			str_format(aPageLabel, sizeof(aPageLabel), "%d maps · page %d of %d", static_cast<int>(WarehouseCollection.m_vMapIndices.size()), PageIndex + 1, PageCount);
+			vPage.push_back(Info(aPageLabel, "Select a map to call a vote. It is extracted only if the vote passes."));
+			if(PageIndex > 0)
+				vPage.push_back(Back("‹  Previous page", {EPage::WAREHOUSE_COLLECTION, Collection.m_Id, PageIndex - 1}));
+			if(PageIndex + 1 < PageCount)
+				vPage.push_back(Navigation("Next page  ›", {EPage::WAREHOUSE_COLLECTION, Collection.m_Id, PageIndex + 1}));
+
+			const int Start = PageIndex * MAPS_PER_PAGE;
+			const int End = std::min(Start + MAPS_PER_PAGE, static_cast<int>(WarehouseCollection.m_vMapIndices.size()));
+			std::vector<const CMapWarehouse::SMap *> vpMaps;
+			std::vector<std::string> vNames;
+			vpMaps.reserve(End - Start);
+			vNames.reserve(End - Start);
+			for(int Index = Start; Index < End; ++Index)
+			{
+				const CMapWarehouse::SMap *pMap = pWarehouse->Map(WarehouseCollection.m_vMapIndices[Index]);
+				vpMaps.push_back(pMap);
+				vNames.push_back(pMap ? pMap->m_Name : "");
+			}
+			auto MapDescription = [&](const CMapWarehouse::SMap &Map, bool DuplicateName, int Disambiguator) {
+				const std::string Prefix = "• ";
+				const bool NeedsHash = DuplicateName || Map.m_Name.size() > static_cast<size_t>(VOTE_DESC_LENGTH - 1 - Prefix.size());
+				std::string Suffix = NeedsHash ? " · " + Map.m_Hash.substr(0, 8) : "";
+				if(Disambiguator > 0)
+					Suffix += " · #" + std::to_string(Disambiguator);
+				const int NameBytes = VOTE_DESC_LENGTH - 1 - static_cast<int>(Prefix.size() + Suffix.size());
+				return Prefix + TruncateLabel(Map.m_Name, std::max(NameBytes, 0)) + Suffix;
+			};
+			const int FirstMapOption = static_cast<int>(vPage.size());
+			for(int Index = 0; Index < static_cast<int>(vpMaps.size()); ++Index)
+			{
+				const CMapWarehouse::SMap *pMap = vpMaps[Index];
+				if(!pMap)
+				{
+					SetError(pError, "an archive collection references an unknown map");
+					return false;
+				}
+				const bool DuplicateName = std::count_if(vNames.begin(), vNames.end(), [&](const std::string &Name) {
+					return str_utf8_comp_nocase(Name.c_str(), pMap->m_Name.c_str()) == 0;
+				}) > 1;
+				SEntry Entry;
+				Entry.m_Kind = EOptionKind::MAP;
+				Entry.m_Description = MapDescription(*pMap, DuplicateName, 0);
+				Entry.m_Command = WarehouseMapCommand(pMap->m_Hash);
+				vPage.push_back(std::move(Entry));
+			}
+			std::vector<bool> vColliding(vpMaps.size(), false);
+			for(int Index = 0; Index < static_cast<int>(vpMaps.size()); ++Index)
+			{
+				for(int Other = Index + 1; Other < static_cast<int>(vpMaps.size()); ++Other)
+				{
+					if(str_utf8_comp_nocase(vPage[FirstMapOption + Index].m_Description.c_str(), vPage[FirstMapOption + Other].m_Description.c_str()) == 0)
+						vColliding[Index] = vColliding[Other] = true;
+				}
+			}
+			std::vector<std::string> vUsedDescriptions;
+			vUsedDescriptions.reserve(vpMaps.size());
+			for(int Index = 0; Index < static_cast<int>(vpMaps.size()); ++Index)
+				if(!vColliding[Index])
+					vUsedDescriptions.push_back(vPage[FirstMapOption + Index].m_Description);
+			for(int Index = 0; Index < static_cast<int>(vpMaps.size()); ++Index)
+			{
+				if(!vColliding[Index])
+					continue;
+				const bool DuplicateName = std::count_if(vNames.begin(), vNames.end(), [&](const std::string &Name) {
+					return str_utf8_comp_nocase(Name.c_str(), vpMaps[Index]->m_Name.c_str()) == 0;
+				}) > 1;
+				int Disambiguator = Index + 1;
+				std::string Description;
+				do
+				{
+					Description = MapDescription(*vpMaps[Index], DuplicateName, Disambiguator++);
+				} while(std::any_of(vUsedDescriptions.begin(), vUsedDescriptions.end(), [&](const std::string &Used) {
+					return str_utf8_comp_nocase(Used.c_str(), Description.c_str()) == 0;
+				}));
+				vPage[FirstMapOption + Index].m_Description = Description;
+				vUsedDescriptions.push_back(std::move(Description));
+			}
+		}
+		m_vWarehouseCollections.push_back(std::move(Collection));
+	}
+	return true;
+}
+
+const std::vector<CMapVoteCatalog::SType> &CMapVoteCatalog::Types(ECategory Category) const
+{
+	return Category == ECategory::DDRACE ? m_vDdraceTypes : m_vGoresTypes;
+}
+
+const std::vector<CMapVoteCatalog::SEntry> *CMapVoteCatalog::PageEntries(SPageId Page) const
+{
+	switch(Page.m_Page)
+	{
+	case EPage::ROOT: return &m_vRootPage;
+	case EPage::DDRACE_TYPES: return &m_vDdracePage;
+	case EPage::GORES_TYPES: return &m_vGoresPage;
+	case EPage::OTHERS: return &m_vOthersPage;
+	case EPage::DDRACE_TYPE:
+		return Page.m_Type >= 0 && Page.m_Type < static_cast<int>(m_vDdraceTypes.size()) ? &m_vDdraceTypes[Page.m_Type].m_vPage : nullptr;
+	case EPage::GORES_TYPE:
+		return Page.m_Type >= 0 && Page.m_Type < static_cast<int>(m_vGoresTypes.size()) ? &m_vGoresTypes[Page.m_Type].m_vPage : nullptr;
+	case EPage::WAREHOUSE: return &m_vWarehousePage;
+	case EPage::WAREHOUSE_GUIDE: return &m_vWarehouseGuidePage;
+	case EPage::WAREHOUSE_COLLECTION:
+		for(const SWarehouseCollection &Collection : m_vWarehouseCollections)
+			if(Collection.m_Id == Page.m_Type)
+				return Page.m_SubPage >= 0 && Page.m_SubPage < static_cast<int>(Collection.m_vPages.size()) ? &Collection.m_vPages[Page.m_SubPage] : nullptr;
+		return nullptr;
+	}
+	return nullptr;
+}
+
+int CMapVoteCatalog::OptionCount(SPageId Page) const
+{
+	const std::vector<SEntry> *pEntries = PageEntries(Page);
+	return pEntries ? static_cast<int>(pEntries->size()) : 0;
+}
+
+const CMapVoteCatalog::SEntry *CMapVoteCatalog::OptionAt(SPageId Page, int Index) const
+{
+	const std::vector<SEntry> *pEntries = PageEntries(Page);
+	return pEntries && Index >= 0 && Index < static_cast<int>(pEntries->size()) ? &(*pEntries)[Index] : nullptr;
+}
+
+const CMapVoteCatalog::SEntry *CMapVoteCatalog::Find(SPageId Page, const char *pDescription) const
+{
+	const std::vector<SEntry> *pEntries = PageEntries(Page);
+	if(!pEntries || !pDescription)
+		return nullptr;
+	for(const SEntry &Entry : *pEntries)
+		if(str_comp_nocase(Entry.m_Description.c_str(), pDescription) == 0)
+			return &Entry;
+	return nullptr;
+}
+
+bool CMapVoteCatalog::ResolveCommand(const SEntry &Entry, char *pCommand, int CommandSize) const
+{
+	if(!pCommand || CommandSize <= 0)
+		return false;
+	pCommand[0] = '\0';
+	if(Entry.m_Kind == EOptionKind::MAP)
+	{
+		if(Entry.m_Command.empty() || Entry.m_Command.size() >= static_cast<size_t>(CommandSize))
+			return false;
+		str_copy(pCommand, Entry.m_Command.c_str(), CommandSize);
+		return true;
+	}
+	if(Entry.m_Kind != EOptionKind::RANDOM || Entry.m_RandomCategory < 0 || Entry.m_RandomCategory > static_cast<int>(ECategory::WAREHOUSE))
+		return false;
+
+	const ECategory Category = static_cast<ECategory>(Entry.m_RandomCategory);
+	if(Category == ECategory::WAREHOUSE)
+	{
+		if(Entry.m_RandomType != -1 || m_vWarehouseRandomHashes.empty())
+			return false;
+		const std::string Command = WarehouseMapCommand(m_vWarehouseRandomHashes[secure_rand_below(static_cast<int>(m_vWarehouseRandomHashes.size()))]);
+		if(Command.size() >= static_cast<size_t>(CommandSize))
+			return false;
+		str_copy(pCommand, Command.c_str(), CommandSize);
+		return true;
+	}
+	const std::vector<SType> &vTypes = Types(Category);
+	int Total = 0;
+	if(Entry.m_RandomType >= 0)
+	{
+		if(Entry.m_RandomType >= static_cast<int>(vTypes.size()))
+			return false;
+		Total = static_cast<int>(vTypes[Entry.m_RandomType].m_vMaps.size());
+	}
+	else
+	{
+		for(const SType &Type : vTypes)
+			Total += static_cast<int>(Type.m_vMaps.size());
+	}
+	if(Total <= 0)
+		return false;
+
+	int Chosen = secure_rand_below(Total);
+	const SMap *pChosenMap = nullptr;
+	if(Entry.m_RandomType >= 0)
+		pChosenMap = &vTypes[Entry.m_RandomType].m_vMaps[Chosen];
+	else
+	{
+		for(const SType &Type : vTypes)
+		{
+			if(Chosen < static_cast<int>(Type.m_vMaps.size()))
+			{
+				pChosenMap = &Type.m_vMaps[Chosen];
+				break;
+			}
+			Chosen -= static_cast<int>(Type.m_vMaps.size());
+		}
+	}
+	if(!pChosenMap)
+		return false;
+	const std::string Command = MapCommand(pChosenMap->m_Path);
+	if(Command.empty() || Command.size() >= static_cast<size_t>(CommandSize))
+		return false;
+	str_copy(pCommand, Command.c_str(), CommandSize);
+	return true;
+}
+
+int CMapVoteCatalog::MapCount() const
+{
+	int Count = static_cast<int>(m_vOtherMaps.size());
+	for(const SType &Type : m_vDdraceTypes)
+		Count += static_cast<int>(Type.m_vMaps.size());
+	for(const SType &Type : m_vGoresTypes)
+		Count += static_cast<int>(Type.m_vMaps.size());
+	return Count;
+}
