+TEST(MapVoteCatalog, NavigationKindsAreExplicitServerState)
+{
+	EXPECT_TRUE(CMapVoteCatalog::IsNavigation(EOptionKind::FOLDER));
+	EXPECT_TRUE(CMapVoteCatalog::IsNavigation(EOptionKind::BACK));
+	EXPECT_FALSE(CMapVoteCatalog::IsNavigation(EOptionKind::NORMAL));
+	EXPECT_FALSE(CMapVoteCatalog::IsNavigation(EOptionKind::RANDOM));
+	EXPECT_FALSE(CMapVoteCatalog::IsNavigation(EOptionKind::MAP));
+}
