+	class CMapVoteCatalogTest : public ::testing::Test
+	{
+	protected:
+		CTestInfo m_TestInfo;
+		std::unique_ptr<IStorage> m_pStorage;
+		CMapVoteCatalog m_Catalog;
+		std::vector<std::string> m_vCreatedDirectories;
+		std::vector<std::string> m_vCreatedMaps;
+
+		static bool CreateEmptyFile(IStorage *pStorage, const char *pPath)
+		{
+			IOHANDLE File = pStorage->OpenFile(pPath, IOFLAG_WRITE, IStorage::TYPE_SAVE);
+			return File && io_close(File) == 0;
+		}
+
+		bool CreateDirectory(const char *pPath)
+		{
+			if(!m_pStorage->CreateFolder(pPath, IStorage::TYPE_SAVE))
+				return false;
+			m_vCreatedDirectories.emplace_back(pPath);
+			return true;
+		}
+
+		bool CreateMap(const char *pPath)
+		{
+			if(!CreateEmptyFile(m_pStorage.get(), pPath))
+				return false;
+			m_vCreatedMaps.emplace_back(pPath);
+			return true;
+		}
+
+		void SetUp() override
+		{
+			m_TestInfo.m_DeleteTestStorageFilesOnSuccess = true;
+			m_pStorage = m_TestInfo.CreateTestStorage();
+			ASSERT_NE(m_pStorage, nullptr);
+
+			for(const char *pDirectory : TEST_DIRECTORIES)
+				ASSERT_TRUE(CreateDirectory(pDirectory)) << pDirectory;
+			for(const char *pMap : TEST_MAPS)
+				ASSERT_TRUE(CreateMap(pMap)) << pMap;
+		}
+
+		void TearDown() override
+		{
+			if(!m_pStorage)
+				return;
+			for(auto It = m_vCreatedMaps.rbegin(); It != m_vCreatedMaps.rend(); ++It)
+			{
+				if(m_pStorage->FileExists(It->c_str(), IStorage::TYPE_SAVE))
+				{
+					EXPECT_TRUE(m_pStorage->RemoveFile(It->c_str(), IStorage::TYPE_SAVE)) << *It;
+				}
+			}
+			for(auto It = m_vCreatedDirectories.rbegin(); It != m_vCreatedDirectories.rend(); ++It)
+			{
+				if(m_pStorage->FolderExists(It->c_str(), IStorage::TYPE_SAVE))
+				{
+					EXPECT_TRUE(m_pStorage->RemoveFolder(It->c_str(), IStorage::TYPE_SAVE)) << *It;
+				}
+			}
+			m_pStorage.reset();
+		}
+	};
+} // namespace
