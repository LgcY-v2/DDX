+#ifndef GAME_SERVER_MAP_VOTE_CATALOG_H
+#define GAME_SERVER_MAP_VOTE_CATALOG_H
+
+#include <string>
+#include <vector>
+
+class IConsole;
+class IStorage;
+class CMapWarehouse;
+
+class CMapVoteCatalog
+{
+public:
+	enum class EOptionKind
+	{
+		NORMAL = 0,
+		FOLDER,
+		BACK,
+		INFO,
+		RANDOM,
+		MAP,
+	};
+
+	enum class EPage : int
+	{
+		ROOT = 0,
+		DDRACE_TYPES,
+		GORES_TYPES,
+		OTHERS,
+		DDRACE_TYPE,
+		GORES_TYPE,
+		WAREHOUSE,
+		WAREHOUSE_GUIDE,
+		WAREHOUSE_COLLECTION,
+	};
+
+	struct SPageId
+	{
+		EPage m_Page = EPage::ROOT;
+		int m_Type = -1;
