+	bool IsHexHash(const std::string &Value)
+	{
+		return Value.size() == 64 && std::all_of(Value.begin(), Value.end(), [](unsigned char Ch) {
+			return (Ch >= '0' && Ch <= '9') || (Ch >= 'a' && Ch <= 'f');
+		});
+	}
+
+	std::vector<std::string> Split(const std::string &Value, char Separator)
+	{
+		std::vector<std::string> vResult;
+		size_t Start = 0;
+		while(Start <= Value.size())
+		{
+			const size_t End = Value.find(Separator, Start);
+			vResult.push_back(Value.substr(Start, End == std::string::npos ? std::string::npos : End - Start));
+			if(End == std::string::npos)
+				break;
+			Start = End + 1;
+		}
+		return vResult;
+	}
+
+	bool PercentDecode(const std::string &Encoded, std::string *pDecoded)
+	{
+		pDecoded->clear();
+		pDecoded->reserve(Encoded.size());
+		auto HexValue = [](char Ch) {
+			if(Ch >= '0' && Ch <= '9')
+				return Ch - '0';
+			if(Ch >= 'A' && Ch <= 'F')
+				return Ch - 'A' + 10;
+			if(Ch >= 'a' && Ch <= 'f')
+				return Ch - 'a' + 10;
+			return -1;
+		};
+		for(size_t Index = 0; Index < Encoded.size(); ++Index)
+		{
+			if(Encoded[Index] != '%')
+			{
+				pDecoded->push_back(Encoded[Index]);
+				continue;
+			}
+			if(Index + 2 >= Encoded.size())
+				return false;
+			const int High = HexValue(Encoded[Index + 1]);
+			const int Low = HexValue(Encoded[Index + 2]);
+			if(High < 0 || Low < 0)
+				return false;
+			const char Decoded = static_cast<char>((High << 4) | Low);
+			if(Decoded == '\0' || Decoded == '\r' || Decoded == '\n' || Decoded == '\t')
+				return false;
+			pDecoded->push_back(Decoded);
+			Index += 2;
+		}
+		return true;
+	}
+
+	std::string PercentEncode(const std::string &Value)
+	{
+		static constexpr char HEX[] = "0123456789ABCDEF";
+		std::string Result;
+		for(const unsigned char Ch : Value)
+		{
+			if((Ch >= 'a' && Ch <= 'z') || (Ch >= 'A' && Ch <= 'Z') || (Ch >= '0' && Ch <= '9') || Ch == '-' || Ch == '.' || Ch == '_' || Ch == '~')
+				Result.push_back(static_cast<char>(Ch));
+			else
+			{
+				Result.push_back('%');
+				Result.push_back(HEX[Ch >> 4]);
+				Result.push_back(HEX[Ch & 0xf]);
+			}
+		}
+		return Result;
+	}
+
+	std::string Normalize(const std::string &Value)
+	{
+		std::vector<char> vResult(Value.size() * 4 + 1);
+		str_utf8_tolower(Value.c_str(), vResult.data(), vResult.size());
+		return vResult.data();
+	}
+
+	std::string Trim(std::string Value)
+	{
+		while(!Value.empty() && std::isspace(static_cast<unsigned char>(Value.front())))
+			Value.erase(Value.begin());
+		while(!Value.empty() && std::isspace(static_cast<unsigned char>(Value.back())))
+			Value.pop_back();
+		return Value;
+	}
+
+	std::string Utf8Truncate(const std::string &Value, int MaxBytes)
+	{
+		if(static_cast<int>(Value.size()) <= MaxBytes)
+			return Value;
+		std::vector<char> vBuffer(MaxBytes + 1);
+		str_utf8_truncate(vBuffer.data(), static_cast<int>(vBuffer.size()), Value.c_str(), MaxBytes);
+		return vBuffer.data();
+	}
+
+	bool GlobMatch(const std::string &Pattern, const std::string &Value)
+	{
+		const char *pPattern = Pattern.c_str();
+		const char *pValue = Value.c_str();
+		const char *pAfterStar = nullptr;
+		const char *pRetry = nullptr;
+		while(*pValue)
+		{
+			const char *pNextPattern = pPattern;
+			const char *pNextValue = pValue;
+			const int PatternCodepoint = str_utf8_decode(&pNextPattern);
+			const int ValueCodepoint = str_utf8_decode(&pNextValue);
+			if(PatternCodepoint == '?' || PatternCodepoint == ValueCodepoint)
+			{
+				pPattern = pNextPattern;
+				pValue = pNextValue;
+			}
+			else if(PatternCodepoint == '*')
+			{
+				pAfterStar = pNextPattern;
+				pPattern = pNextPattern;
+				pRetry = pValue;
+			}
+			else if(pAfterStar)
+			{
+				if(str_utf8_decode(&pRetry) <= 0)
+					return false;
+				pPattern = pAfterStar;
+				pValue = pRetry;
+			}
+			else
+				return false;
+		}
+		while(*pPattern)
+			if(str_utf8_decode(&pPattern) != '*')
+				return false;
+		return true;
+	}
