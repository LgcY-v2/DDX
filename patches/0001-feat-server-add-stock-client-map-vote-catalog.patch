+namespace
+{
+	struct SScanContext
+	{
+		bool m_WantDirectories = false;
+		std::vector<std::string> m_vNames{};
+	};
+
+	int ScanDirectoryEntry(const char *pName, int IsDir, int DirType, void *pUser)
+	{
+		(void)DirType;
+		auto *pContext = static_cast<SScanContext *>(pUser);
+		if(!pName || !str_comp(pName, ".") || !str_comp(pName, "..") || (IsDir != 0) != pContext->m_WantDirectories)
+			return 0;
+		if(!pContext->m_WantDirectories && !str_endswith_nocase(pName, ".map"))
+			return 0;
+
+		std::string Name = pName;
+		if(!pContext->m_WantDirectories)
+			Name.resize(Name.size() - 4);
+		if(Name.empty() || !str_valid_filename(Name.c_str()))
+			return 0;
+		pContext->m_vNames.push_back(std::move(Name));
+		return 0;
+	}
+
+	std::vector<std::string> ScanNames(IStorage *pStorage, int StorageType, const char *pDirectory, bool Directories)
+	{
+		SScanContext Context;
+		Context.m_WantDirectories = Directories;
+		pStorage->ListDirectory(StorageType, pDirectory, ScanDirectoryEntry, &Context);
+		std::sort(Context.m_vNames.begin(), Context.m_vNames.end(), [](const std::string &Left, const std::string &Right) {
+			return str_comp_filenames(Left.c_str(), Right.c_str()) < 0;
+		});
+		Context.m_vNames.erase(std::unique(Context.m_vNames.begin(), Context.m_vNames.end(), [](const std::string &Left, const std::string &Right) {
+			return str_comp_nocase(Left.c_str(), Right.c_str()) == 0;
+		}),
+			Context.m_vNames.end());
+		return Context.m_vNames;
+	}
+
+	std::string PrettyTypeName(const std::string &Name)
+	{
+		std::string Pretty;
+		Pretty.reserve(Name.size() + 4);
+		bool NewWord = true;
+		for(char Ch : Name)
+		{
+			if(Ch == '.' || Ch == '_' || Ch == '-')
+			{
+				Pretty.push_back(' ');
+				NewWord = true;
+				continue;
+			}
+			const unsigned char UCh = static_cast<unsigned char>(Ch);
+			Pretty.push_back(NewWord ? static_cast<char>(std::toupper(UCh)) : static_cast<char>(std::tolower(UCh)));
+			NewWord = false;
+		}
+		if(str_startswith_nocase(Name.c_str(), "ddmax."))
+			Pretty.replace(0, 5, "DDMax");
+		return Pretty;
+	}
+
+	std::string MapCommand(const std::string &Path)
+	{
+		char aEscaped[IO_MAX_PATH_LENGTH * 2];
+		char *pDst = aEscaped;
+		str_escape(&pDst, Path.c_str(), aEscaped + sizeof(aEscaped));
+		std::string Command = "change_map \"";
+		Command += aEscaped;
+		Command += '"';
+		return Command.size() < VOTE_CMD_LENGTH ? Command : std::string{};
+	}
+
+	void SetError(std::string *pError, const char *pMessage)
+	{
+		if(pError)
+			*pError = pMessage;
+	}
+} // namespace
+
+void CMapVoteCatalog::Clear()
+{
+	m_Active = false;
+	m_vDdraceTypes.clear();
+	m_vGoresTypes.clear();
+	m_vOtherMaps.clear();
+	m_vRootPage.clear();
+	m_vDdracePage.clear();
+	m_vGoresPage.clear();
+	m_vOthersPage.clear();
+}
+
+void CMapVoteCatalog::DisambiguateTypeDisplayNames(std::vector<SType> &vTypes)
+{
+	std::vector<bool> vDuplicate(vTypes.size(), false);
+	for(size_t Index = 0; Index < vTypes.size(); ++Index)
+	{
+		for(size_t Other = 0; Other < vTypes.size(); ++Other)
+		{
+			if(Index != Other && str_comp_nocase(vTypes[Index].m_DisplayName.c_str(), vTypes[Other].m_DisplayName.c_str()) == 0)
+			{
+				vDuplicate[Index] = true;
+				break;
+			}
+		}
+	}
+	for(size_t Index = 0; Index < vTypes.size(); ++Index)
+	{
+		if(vDuplicate[Index])
+		{
+			vTypes[Index].m_DisplayName += " [";
+			vTypes[Index].m_DisplayName += vTypes[Index].m_Name;
+			vTypes[Index].m_DisplayName += ']';
+		}
+	}
+}
+
+bool CMapVoteCatalog::Build(IStorage *pStorage, IConsole *pConsole, std::string *pError)
+{
+	return BuildFromStorageType(pStorage, IStorage::TYPE_ALL, pConsole, pError);
+}
+
+bool CMapVoteCatalog::BuildFromStorageType(IStorage *pStorage, int StorageType, IConsole *pConsole, std::string *pError)
+{
+	if(pError)
+		pError->clear();
+	if(!pStorage)
+	{
+		SetError(pError, "storage is unavailable");
+		return false;
+	}
+
+	CMapVoteCatalog Candidate;
+	bool PathTruncated = false;
+	auto ScanTypes = [&](const char *pTypesRoot, bool Ddrace, std::vector<SType> *pOutTypes) {
+		for(const std::string &TypeName : ScanNames(pStorage, StorageType, pTypesRoot, true))
+		{
+			char aMapDirectory[IO_MAX_PATH_LENGTH];
+			if(str_format(aMapDirectory, sizeof(aMapDirectory), "%s/%s%s", pTypesRoot, TypeName.c_str(), Ddrace ? "/maps" : "") >= static_cast<int>(sizeof(aMapDirectory)))
+			{
+				PathTruncated = true;
+				return;
+			}
+			const std::vector<std::string> vMapNames = ScanNames(pStorage, StorageType, aMapDirectory, false);
+			if(vMapNames.empty())
+				continue;
+
+			SType Type;
+			Type.m_Name = TypeName;
+			// Both map corpora use machine-oriented directory names. Publish
+			// consistent reader-facing labels instead of leaking their casing
+			// and separator conventions into the vote menu.
+			Type.m_DisplayName = PrettyTypeName(TypeName);
+			Type.m_vMaps.reserve(vMapNames.size());
+			for(const std::string &MapName : vMapNames)
+			{
+				char aPath[IO_MAX_PATH_LENGTH];
+				if(str_format(aPath, sizeof(aPath), "%s/%s", aMapDirectory + str_length("maps/"), MapName.c_str()) >= static_cast<int>(sizeof(aPath)))
+				{
+					PathTruncated = true;
+					return;
+				}
+				Type.m_vMaps.push_back({MapName, aPath});
+			}
+			pOutTypes->push_back(std::move(Type));
+		}
+	};
+
+	ScanTypes("maps/tw_maps/ddnet-maps-master/types", true, &Candidate.m_vDdraceTypes);
+	ScanTypes("maps/tw_maps/KoGmaps-main", false, &Candidate.m_vGoresTypes);
+	DisambiguateTypeDisplayNames(Candidate.m_vDdraceTypes);
+	DisambiguateTypeDisplayNames(Candidate.m_vGoresTypes);
+	if(PathTruncated)
+	{
+		SetError(pError, "a map catalog path exceeds the supported length");
+		return false;
+	}
+	for(const std::string &MapName : ScanNames(pStorage, StorageType, "maps", false))
+		Candidate.m_vOtherMaps.push_back({MapName, MapName});
+
+	if(Candidate.m_vDdraceTypes.empty() || Candidate.m_vGoresTypes.empty())
+	{
+		SetError(pError, "DDRace or Gores map roots are missing or empty");
+		return false;
+	}
+	if(Candidate.MapCount() > MAX_VOTE_OPTIONS)
+	{
+		SetError(pError, "map catalog exceeds the vote option safety limit");
+		return false;
+	}
+
+	if(!Candidate.BuildPages(pError))
+		return false;
+	Candidate.m_Active = true;
+	*this = std::move(Candidate);
+
+	if(pConsole)
+	{
+		char aMessage[160];
+		str_format(aMessage, sizeof(aMessage), "published %d maps in %d DDRace and %d Gores types", MapCount(), static_cast<int>(m_vDdraceTypes.size()), static_cast<int>(m_vGoresTypes.size()));
+		pConsole->Print(IConsole::OUTPUT_LEVEL_STANDARD, "map-votes", aMessage);
+	}
+	return true;
+}
+
+bool CMapVoteCatalog::BuildPages(std::string *pError)
+{
+	auto Navigation = [](const char *pLabel, SPageId Target) {
+		SEntry Entry;
+		Entry.m_Kind = EOptionKind::FOLDER;
+		Entry.m_Description = pLabel;
+		Entry.m_TargetPage = Target;
+		return Entry;
+	};
+	auto Back = [](const char *pLabel, SPageId Target) {
+		SEntry Entry;
+		Entry.m_Kind = EOptionKind::BACK;
+		Entry.m_Description = pLabel;
+		Entry.m_TargetPage = Target;
+		return Entry;
+	};
+	auto Random = [](const char *pLabel, ECategory Category, int Type) {
+		SEntry Entry;
+		Entry.m_Kind = EOptionKind::RANDOM;
+		Entry.m_Description = pLabel;
+		Entry.m_RandomCategory = static_cast<int>(Category);
+		Entry.m_RandomType = Type;
+		return Entry;
+	};
+	auto Map = [](const SMap &MapValue) {
+		SEntry Entry;
+		Entry.m_Kind = EOptionKind::MAP;
+		Entry.m_Description = MapValue.m_Name;
+		Entry.m_Command = MapCommand(MapValue.m_Path);
+		return Entry;
+	};
+
+	m_vRootPage = {
+		Navigation("Browse DDRace maps  ›", {EPage::DDRACE_TYPES, -1}),
+		Navigation("Browse Gores maps  ›", {EPage::GORES_TYPES, -1}),
+		Navigation("Browse other maps  ›", {EPage::OTHERS, -1}),
+		Random("★ Random DDRace map", ECategory::DDRACE, -1),
+		Random("★ Random Gores map", ECategory::GORES, -1),
+	};
+
+	m_vDdracePage.push_back(Back("‹  Back to map categories", {EPage::ROOT, -1}));
+	for(int TypeIndex = 0; TypeIndex < static_cast<int>(m_vDdraceTypes.size()); ++TypeIndex)
+	{
+		char aLabel[VOTE_DESC_LENGTH];
+		str_format(aLabel, sizeof(aLabel), "Browse %s maps  ›", m_vDdraceTypes[TypeIndex].m_DisplayName.c_str());
+		m_vDdracePage.push_back(Navigation(aLabel, {EPage::DDRACE_TYPE, TypeIndex}));
+	}
+	m_vGoresPage.push_back(Back("‹  Back to map categories", {EPage::ROOT, -1}));
+	for(int TypeIndex = 0; TypeIndex < static_cast<int>(m_vGoresTypes.size()); ++TypeIndex)
+	{
+		char aLabel[VOTE_DESC_LENGTH];
+		str_format(aLabel, sizeof(aLabel), "Browse %s maps  ›", m_vGoresTypes[TypeIndex].m_DisplayName.c_str());
+		m_vGoresPage.push_back(Navigation(aLabel, {EPage::GORES_TYPE, TypeIndex}));
+	}
+
+	for(int TypeIndex = 0; TypeIndex < static_cast<int>(m_vDdraceTypes.size()); ++TypeIndex)
+	{
+		SType &Type = m_vDdraceTypes[TypeIndex];
+		char aRandomLabel[VOTE_DESC_LENGTH];
+		str_format(aRandomLabel, sizeof(aRandomLabel), "★ Random %s map", Type.m_DisplayName.c_str());
+		Type.m_vPage.push_back(Back("‹  Back to DDRace difficulties", {EPage::DDRACE_TYPES, -1}));
+		Type.m_vPage.push_back(Random(aRandomLabel, ECategory::DDRACE, TypeIndex));
+		for(const SMap &MapValue : Type.m_vMaps)
+			Type.m_vPage.push_back(Map(MapValue));
+	}
+	for(int TypeIndex = 0; TypeIndex < static_cast<int>(m_vGoresTypes.size()); ++TypeIndex)
+	{
+		SType &Type = m_vGoresTypes[TypeIndex];
+		char aRandomLabel[VOTE_DESC_LENGTH];
+		str_format(aRandomLabel, sizeof(aRandomLabel), "★ Random %s map", Type.m_DisplayName.c_str());
+		Type.m_vPage.push_back(Back("‹  Back to Gores difficulties", {EPage::GORES_TYPES, -1}));
+		Type.m_vPage.push_back(Random(aRandomLabel, ECategory::GORES, TypeIndex));
+		for(const SMap &MapValue : Type.m_vMaps)
+			Type.m_vPage.push_back(Map(MapValue));
+	}
+
+	m_vOthersPage.push_back(Back("‹  Back to map categories", {EPage::ROOT, -1}));
+	for(const SMap &MapValue : m_vOtherMaps)
+		m_vOthersPage.push_back(Map(MapValue));
+
+	auto ValidatePage = [&](const std::vector<SEntry> &vPage) {
+		std::vector<const char *> vpDescriptions;
+		vpDescriptions.reserve(vPage.size());
+		if(vPage.size() > MAX_VOTE_OPTIONS)
+			return false;
+		for(const SEntry &Entry : vPage)
+		{
+			if(Entry.m_Description.empty() || Entry.m_Description.size() >= VOTE_DESC_LENGTH ||
+				(Entry.m_Kind == EOptionKind::MAP && Entry.m_Command.empty()))
+				return false;
+			vpDescriptions.push_back(Entry.m_Description.c_str());
+		}
+		std::sort(vpDescriptions.begin(), vpDescriptions.end(), [](const char *pLeft, const char *pRight) {
+			return str_comp_nocase(pLeft, pRight) < 0;
+		});
+		for(size_t Index = 1; Index < vpDescriptions.size(); ++Index)
+			if(str_comp_nocase(vpDescriptions[Index - 1], vpDescriptions[Index]) == 0)
+				return false;
+		return true;
+	};
+	if(!ValidatePage(m_vRootPage) || !ValidatePage(m_vDdracePage) || !ValidatePage(m_vGoresPage) || !ValidatePage(m_vOthersPage))
+	{
+		SetError(pError, "a map vote page exceeds protocol limits");
+		return false;
+	}
+	for(const SType &Type : m_vDdraceTypes)
+		if(!ValidatePage(Type.m_vPage))
+		{
+			SetError(pError, "a DDRace map vote page exceeds protocol limits");
+			return false;
+		}
+	for(const SType &Type : m_vGoresTypes)
+		if(!ValidatePage(Type.m_vPage))
+		{
+			SetError(pError, "a Gores map vote page exceeds protocol limits");
+			return false;
+		}
+	return true;
+}
+
+const std::vector<CMapVoteCatalog::SType> &CMapVoteCatalog::Types(ECategory Category) const
+{
+	return Category == ECategory::DDRACE ? m_vDdraceTypes : m_vGoresTypes;
+}
+
+const std::vector<CMapVoteCatalog::SEntry> *CMapVoteCatalog::PageEntries(SPageId Page) const
+{
+	switch(Page.m_Page)
+	{
+	case EPage::ROOT: return &m_vRootPage;
+	case EPage::DDRACE_TYPES: return &m_vDdracePage;
+	case EPage::GORES_TYPES: return &m_vGoresPage;
+	case EPage::OTHERS: return &m_vOthersPage;
+	case EPage::DDRACE_TYPE:
+		return Page.m_Type >= 0 && Page.m_Type < static_cast<int>(m_vDdraceTypes.size()) ? &m_vDdraceTypes[Page.m_Type].m_vPage : nullptr;
+	case EPage::GORES_TYPE:
+		return Page.m_Type >= 0 && Page.m_Type < static_cast<int>(m_vGoresTypes.size()) ? &m_vGoresTypes[Page.m_Type].m_vPage : nullptr;
+	}
+	return nullptr;
+}
+
+int CMapVoteCatalog::OptionCount(SPageId Page) const
+{
+	const std::vector<SEntry> *pEntries = PageEntries(Page);
+	return pEntries ? static_cast<int>(pEntries->size()) : 0;
+}
+
+const CMapVoteCatalog::SEntry *CMapVoteCatalog::OptionAt(SPageId Page, int Index) const
+{
+	const std::vector<SEntry> *pEntries = PageEntries(Page);
+	return pEntries && Index >= 0 && Index < static_cast<int>(pEntries->size()) ? &(*pEntries)[Index] : nullptr;
+}
+
+const CMapVoteCatalog::SEntry *CMapVoteCatalog::Find(SPageId Page, const char *pDescription) const
+{
+	const std::vector<SEntry> *pEntries = PageEntries(Page);
+	if(!pEntries || !pDescription)
+		return nullptr;
+	for(const SEntry &Entry : *pEntries)
+		if(str_comp_nocase(Entry.m_Description.c_str(), pDescription) == 0)
+			return &Entry;
+	return nullptr;
+}
+
+bool CMapVoteCatalog::ResolveCommand(const SEntry &Entry, char *pCommand, int CommandSize) const
+{
+	if(!pCommand || CommandSize <= 0)
+		return false;
+	pCommand[0] = '\0';
+	if(Entry.m_Kind == EOptionKind::MAP)
+	{
+		if(Entry.m_Command.empty() || Entry.m_Command.size() >= static_cast<size_t>(CommandSize))
+			return false;
+		str_copy(pCommand, Entry.m_Command.c_str(), CommandSize);
+		return true;
+	}
+	if(Entry.m_Kind != EOptionKind::RANDOM || Entry.m_RandomCategory < 0 || Entry.m_RandomCategory > 1)
+		return false;
+
+	const ECategory Category = static_cast<ECategory>(Entry.m_RandomCategory);
+	const std::vector<SType> &vTypes = Types(Category);
+	int Total = 0;
+	if(Entry.m_RandomType >= 0)
+	{
+		if(Entry.m_RandomType >= static_cast<int>(vTypes.size()))
+			return false;
+		Total = static_cast<int>(vTypes[Entry.m_RandomType].m_vMaps.size());
+	}
+	else
+	{
+		for(const SType &Type : vTypes)
+			Total += static_cast<int>(Type.m_vMaps.size());
+	}
+	if(Total <= 0)
+		return false;
+
+	int Chosen = secure_rand_below(Total);
+	const SMap *pChosenMap = nullptr;
+	if(Entry.m_RandomType >= 0)
+		pChosenMap = &vTypes[Entry.m_RandomType].m_vMaps[Chosen];
+	else
+	{
+		for(const SType &Type : vTypes)
+		{
+			if(Chosen < static_cast<int>(Type.m_vMaps.size()))
+			{
+				pChosenMap = &Type.m_vMaps[Chosen];
+				break;
+			}
+			Chosen -= static_cast<int>(Type.m_vMaps.size());
+		}
+	}
+	if(!pChosenMap)
+		return false;
+	const std::string Command = MapCommand(pChosenMap->m_Path);
+	if(Command.empty() || Command.size() >= static_cast<size_t>(CommandSize))
+		return false;
+	str_copy(pCommand, Command.c_str(), CommandSize);
+	return true;
+}
+
+int CMapVoteCatalog::MapCount() const
+{
+	int Count = static_cast<int>(m_vOtherMaps.size());
+	for(const SType &Type : m_vDdraceTypes)
+		Count += static_cast<int>(Type.m_vMaps.size());
+	for(const SType &Type : m_vGoresTypes)
+		Count += static_cast<int>(Type.m_vMaps.size());
+	return Count;
+}
