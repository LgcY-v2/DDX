+TEST_F(CMapVoteCatalogTest, FailedRebuildPreservesPublishedCatalog)
+{
+	std::string Error;
+	ASSERT_TRUE(m_Catalog.BuildFromStorageType(m_pStorage.get(), IStorage::TYPE_SAVE, nullptr, &Error)) << Error;
+	const SPageId Root{EPage::ROOT, -1};
+	const CMapVoteCatalog::SEntry *pPublishedGoresRandom = m_Catalog.OptionAt(Root, 4);
+	ASSERT_NE(pPublishedGoresRandom, nullptr);
+	const std::string PublishedDescription = pPublishedGoresRandom->m_Description;
+
+	ASSERT_TRUE(m_pStorage->RemoveFile(GORES_MAP, IStorage::TYPE_SAVE));
+	Error.clear();
+	EXPECT_FALSE(m_Catalog.BuildFromStorageType(m_pStorage.get(), IStorage::TYPE_SAVE, nullptr, &Error));
+	EXPECT_FALSE(Error.empty());
+
+	EXPECT_TRUE(m_Catalog.Active());
+	EXPECT_EQ(m_Catalog.MapCount(), 3);
+	EXPECT_EQ(m_Catalog.OptionCount(Root), 5);
+	const CMapVoteCatalog::SEntry *pPreservedGoresRandom = m_Catalog.Find(Root, PublishedDescription.c_str());
+	ExpectResolvedCommand(m_Catalog, pPreservedGoresRandom, "change_map \"tw_maps/KoGmaps-main/HARD/Omega\"");
+}
