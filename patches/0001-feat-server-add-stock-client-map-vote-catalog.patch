+TEST_F(CMapVoteCatalogTest, PublishesReadablePagesAndResolvesCommands)
+{
+	std::string Error = "stale error";
+	ASSERT_TRUE(m_Catalog.BuildFromStorageType(m_pStorage.get(), IStorage::TYPE_SAVE, nullptr, &Error)) << Error;
+	EXPECT_TRUE(Error.empty());
+	ASSERT_TRUE(m_Catalog.Active());
+	EXPECT_EQ(m_Catalog.MapCount(), 3);
+
+	const SPageId Root{EPage::ROOT, -1};
+	const SPageId DdraceTypes{EPage::DDRACE_TYPES, -1};
+	const SPageId GoresTypes{EPage::GORES_TYPES, -1};
+	const SPageId Others{EPage::OTHERS, -1};
+	const SPageId DdraceNovice{EPage::DDRACE_TYPE, 0};
+	const SPageId GoresHard{EPage::GORES_TYPE, 0};
+
+	ExpectPage(m_Catalog, Root, {
+					    {EOptionKind::FOLDER, "Browse DDRace maps  ›"},
+					    {EOptionKind::FOLDER, "Browse Gores maps  ›"},
+					    {EOptionKind::FOLDER, "Browse other maps  ›"},
+					    {EOptionKind::RANDOM, "★ Random DDRace map"},
+					    {EOptionKind::RANDOM, "★ Random Gores map"},
+				    });
+	ExpectPage(m_Catalog, DdraceTypes, {
+						   {EOptionKind::BACK, "‹  Back to map categories"},
+						   {EOptionKind::FOLDER, "Browse Novice maps  ›"},
+					   });
+	ExpectPage(m_Catalog, GoresTypes, {
+						  {EOptionKind::BACK, "‹  Back to map categories"},
+						  {EOptionKind::FOLDER, "Browse Hard maps  ›"},
+					  });
+	ExpectPage(m_Catalog, DdraceNovice, {
+						    {EOptionKind::BACK, "‹  Back to DDRace difficulties"},
+						    {EOptionKind::RANDOM, "★ Random Novice map"},
+						    {EOptionKind::MAP, "Alpha"},
+					    });
+	ExpectPage(m_Catalog, GoresHard, {
+						 {EOptionKind::BACK, "‹  Back to Gores difficulties"},
+						 {EOptionKind::RANDOM, "★ Random Hard map"},
+						 {EOptionKind::MAP, "Omega"},
+					 });
+	ExpectPage(m_Catalog, Others, {
+					      {EOptionKind::BACK, "‹  Back to map categories"},
+					      {EOptionKind::MAP, "dm_1"},
+				      });
+
+	const CMapVoteCatalog::SEntry *pDdraceFolder = m_Catalog.OptionAt(Root, 0);
+	const CMapVoteCatalog::SEntry *pGoresFolder = m_Catalog.OptionAt(Root, 1);
+	const CMapVoteCatalog::SEntry *pOthersFolder = m_Catalog.OptionAt(Root, 2);
+	ASSERT_NE(pDdraceFolder, nullptr);
+	ASSERT_NE(pGoresFolder, nullptr);
+	ASSERT_NE(pOthersFolder, nullptr);
+	EXPECT_EQ(pDdraceFolder->m_TargetPage, DdraceTypes);
+	EXPECT_EQ(pGoresFolder->m_TargetPage, GoresTypes);
+	EXPECT_EQ(pOthersFolder->m_TargetPage, Others);
+
+	const CMapVoteCatalog::SEntry *pNoviceFolder = m_Catalog.OptionAt(DdraceTypes, 1);
+	const CMapVoteCatalog::SEntry *pHardFolder = m_Catalog.OptionAt(GoresTypes, 1);
+	ASSERT_NE(pNoviceFolder, nullptr);
+	ASSERT_NE(pHardFolder, nullptr);
+	EXPECT_EQ(pNoviceFolder->m_TargetPage, DdraceNovice);
+	EXPECT_EQ(pHardFolder->m_TargetPage, GoresHard);
+	EXPECT_EQ(m_Catalog.OptionAt(DdraceNovice, 0)->m_TargetPage, DdraceTypes);
+	EXPECT_EQ(m_Catalog.OptionAt(GoresHard, 0)->m_TargetPage, GoresTypes);
+	EXPECT_EQ(m_Catalog.OptionAt(Others, 0)->m_TargetPage, Root);
+
+	ExpectResolvedCommand(m_Catalog, m_Catalog.OptionAt(Root, 3), "change_map \"tw_maps/ddnet-maps-master/types/novice/maps/Alpha\"");
+	ExpectResolvedCommand(m_Catalog, m_Catalog.OptionAt(Root, 4), "change_map \"tw_maps/KoGmaps-main/HARD/Omega\"");
+	ExpectResolvedCommand(m_Catalog, m_Catalog.OptionAt(DdraceNovice, 1), "change_map \"tw_maps/ddnet-maps-master/types/novice/maps/Alpha\"");
+	ExpectResolvedCommand(m_Catalog, m_Catalog.OptionAt(GoresHard, 1), "change_map \"tw_maps/KoGmaps-main/HARD/Omega\"");
+	ExpectResolvedCommand(m_Catalog, m_Catalog.OptionAt(DdraceNovice, 2), "change_map \"tw_maps/ddnet-maps-master/types/novice/maps/Alpha\"");
+	ExpectResolvedCommand(m_Catalog, m_Catalog.OptionAt(GoresHard, 2), "change_map \"tw_maps/KoGmaps-main/HARD/Omega\"");
+	const CMapVoteCatalog::SEntry *pOtherMap = m_Catalog.OptionAt(Others, 1);
+	ExpectResolvedCommand(m_Catalog, pOtherMap, "change_map \"dm_1\"");
+	char aTruncatedCommand[8] = "stale";
+	ASSERT_FALSE(m_Catalog.ResolveCommand(*pOtherMap, aTruncatedCommand, sizeof(aTruncatedCommand)));
+	EXPECT_STREQ(aTruncatedCommand, "");
+
+	EXPECT_NE(m_Catalog.Find(Root, pDdraceFolder->m_Description.c_str()), nullptr);
+	EXPECT_EQ(m_Catalog.Find(DdraceTypes, pDdraceFolder->m_Description.c_str()), nullptr);
+	EXPECT_EQ(m_Catalog.Find(GoresTypes, pDdraceFolder->m_Description.c_str()), nullptr);
+	EXPECT_EQ(m_Catalog.OptionAt(DdraceTypes, 0)->m_TargetPage, Root);
+	EXPECT_EQ(m_Catalog.OptionAt(GoresTypes, 0)->m_TargetPage, Root);
+	EXPECT_EQ(m_Catalog.Find(GoresHard, m_Catalog.OptionAt(DdraceNovice, 1)->m_Description.c_str()), nullptr);
+}
