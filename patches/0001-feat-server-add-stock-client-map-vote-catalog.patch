+	ASSERT_NE(pRandomArchive, nullptr);
+	EXPECT_EQ(Catalog.OptionCount(Root), 7);
+
+	char aCommand[VOTE_CMD_LENGTH];
+	ASSERT_TRUE(Catalog.ResolveCommand(*pRandomArchive, aCommand, sizeof(aCommand)));
+	EXPECT_EQ(aCommand, "warehouse_map \"" + TestHash(1) + "\"");
+
+	CMapVoteCatalog::SEntry Forged = *pRandomArchive;
+	Forged.m_RandomType = 0;
+	EXPECT_FALSE(Catalog.ResolveCommand(Forged, aCommand, sizeof(aCommand)));
+	EXPECT_STREQ(aCommand, "");
+	EXPECT_FALSE(Catalog.ResolveCommand(*pRandomArchive, aCommand, 8));
+	EXPECT_STREQ(aCommand, "");
