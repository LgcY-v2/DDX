+TEST_F(CMapWarehouseTest, SearchesAnyOrderDeduplicatesAliasesAndPersists)
+{
+	WriteIndex(DefaultMaps());
+	CMapWarehouse Warehouse;
+	Load(&Warehouse);
+	EXPECT_EQ(Warehouse.AliasCount(), 6);
+	EXPECT_EQ(Warehouse.UniqueMapCount(), 5);
+
+	const CMapWarehouse::SSearchResult Ordered = Warehouse.Search("*aip*race*", m_pStorage.get());
+	EXPECT_EQ(Ordered.m_Status, CMapWarehouse::ESearchStatus::CREATED);
+	EXPECT_EQ(Ordered.m_CollectionName, "AIP · Race");
+	EXPECT_EQ(Ordered.m_UniqueMatches, 2);
+	EXPECT_EQ(Ordered.m_AliasMatches, 3);
+
+	const CMapWarehouse::SSearchResult Existing = Warehouse.Search("*aip*race*", m_pStorage.get());
+	EXPECT_EQ(Existing.m_Status, CMapWarehouse::ESearchStatus::EXISTING);
+	EXPECT_EQ(Existing.m_CollectionId, Ordered.m_CollectionId);
+
+	const CMapWarehouse::SSearchResult Collision = Warehouse.Search("race aip --name AIP · Race", m_pStorage.get());
+	EXPECT_EQ(Collision.m_Status, CMapWarehouse::ESearchStatus::ERROR);
+	EXPECT_NE(Collision.m_Message.find("already in use"), std::string::npos);
+
+	const CMapWarehouse::SSearchResult AnyOrder = Warehouse.Search("race aip --name Any Order", m_pStorage.get());
+	EXPECT_EQ(AnyOrder.m_Status, CMapWarehouse::ESearchStatus::CREATED);
+	EXPECT_EQ(AnyOrder.m_UniqueMatches, 3);
+	EXPECT_EQ(AnyOrder.m_AliasMatches, 4);
+
+	const CMapWarehouse::SSearchResult Excluded = Warehouse.Search("race -gores --name No Gores", m_pStorage.get());
+	EXPECT_EQ(Excluded.m_Status, CMapWarehouse::ESearchStatus::CREATED);
+	EXPECT_EQ(Excluded.m_UniqueMatches, 3);
+	EXPECT_EQ(Excluded.m_AliasMatches, 4);
+
+	std::vector<STestMap> vReorderedMaps = DefaultMaps();
+	std::reverse(vReorderedMaps.begin(), vReorderedMaps.end());
+	WriteIndex(vReorderedMaps);
+	CMapWarehouse Reloaded;
+	Load(&Reloaded);
+	ASSERT_EQ(Reloaded.Collections().size(), 3U);
+	EXPECT_EQ(Reloaded.CollectionById(Ordered.m_CollectionId)->m_Name, "AIP · Race");
+	EXPECT_EQ(Reloaded.CollectionById(AnyOrder.m_CollectionId)->m_Name, "Any Order");
+}
