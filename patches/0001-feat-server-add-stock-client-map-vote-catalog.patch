+TEST_F(CMapVoteCatalogTest, DisambiguatesFriendlyTypeNameCollisions)
+{
+	constexpr const char *pFirstType = "maps/tw_maps/ddnet-maps-master/types/foo.bar";
+	constexpr const char *pFirstMaps = "maps/tw_maps/ddnet-maps-master/types/foo.bar/maps";
+	constexpr const char *pFirstMap = "maps/tw_maps/ddnet-maps-master/types/foo.bar/maps/First.map";
+	constexpr const char *pSecondType = "maps/tw_maps/ddnet-maps-master/types/foo_bar";
+	constexpr const char *pSecondMaps = "maps/tw_maps/ddnet-maps-master/types/foo_bar/maps";
+	constexpr const char *pSecondMap = "maps/tw_maps/ddnet-maps-master/types/foo_bar/maps/Second.map";
+	ASSERT_TRUE(CreateDirectory(pFirstType));
+	ASSERT_TRUE(CreateDirectory(pFirstMaps));
+	ASSERT_TRUE(CreateMap(pFirstMap));
+	ASSERT_TRUE(CreateDirectory(pSecondType));
+	ASSERT_TRUE(CreateDirectory(pSecondMaps));
+	ASSERT_TRUE(CreateMap(pSecondMap));
+
+	std::string Error;
+	ASSERT_TRUE(m_Catalog.BuildFromStorageType(m_pStorage.get(), IStorage::TYPE_SAVE, nullptr, &Error)) << Error;
+	const SPageId DdraceTypes{EPage::DDRACE_TYPES, -1};
+	const CMapVoteCatalog::SEntry *pFirstFolder = m_Catalog.Find(DdraceTypes, "Browse Foo Bar [foo.bar] maps  ›");
+	const CMapVoteCatalog::SEntry *pSecondFolder = m_Catalog.Find(DdraceTypes, "Browse Foo Bar [foo_bar] maps  ›");
+	ASSERT_NE(pFirstFolder, nullptr);
+	ASSERT_NE(pSecondFolder, nullptr);
+	EXPECT_FALSE(pFirstFolder->m_TargetPage == pSecondFolder->m_TargetPage);
+	ASSERT_NE(m_Catalog.Find(pFirstFolder->m_TargetPage, "First"), nullptr);
+	ASSERT_NE(m_Catalog.Find(pSecondFolder->m_TargetPage, "Second"), nullptr);
+}
