+void CGameContext::ProgressMapWarehouse()
+{
+	const CMapWarehouse::SPreparedMap Prepared = m_MapWarehouse.PollPreparedMap();
+	if(Prepared.m_Finished)
+	{
+		m_LastMapWarehouseProgressMessage = 0;
+		char aMessage[256];
+		if(Prepared.m_Success)
+		{
+			str_format(aMessage, sizeof(aMessage), "Archive map ready: %s. Changing map now.", Prepared.m_DisplayName.c_str());
+			SendChat(-1, TEAM_ALL, aMessage);
+			Server()->ChangeMap(Prepared.m_MapPath.c_str());
+		}
+		else
+		{
+			str_format(aMessage, sizeof(aMessage), "Could not prepare %s: %s", Prepared.m_DisplayName.c_str(), Prepared.m_Error.c_str());
+			SendChat(-1, TEAM_ALL, aMessage);
+			Console()->Print(IConsole::OUTPUT_LEVEL_STANDARD, "map-warehouse", aMessage);
+		}
+		return;
+	}
+	if(!m_MapWarehouse.Busy())
+		return;
+	const int64_t Now = time_get();
+	const int64_t ElapsedSeconds = (Now - m_MapWarehouse.PrepareStartTime()) / time_freq();
+	if(ElapsedSeconds >= 10 && (m_LastMapWarehouseProgressMessage == 0 || Now - m_LastMapWarehouseProgressMessage >= 15 * time_freq()))
+	{
+		char aMessage[192];
+		str_format(aMessage, sizeof(aMessage), "Preparing %s from the archive… %lld seconds", m_MapWarehouse.PreparingDisplayName().c_str(), static_cast<long long>(ElapsedSeconds));
+		SendChat(-1, TEAM_ALL, aMessage);
+		m_LastMapWarehouseProgressMessage = Now;
+	}
+}
+
+CMapVoteCatalog::SPageId CGameContext::MapVotePage(int ClientId) const
+{
+	if(ClientId < 0 || ClientId >= MAX_CLIENTS || !m_apPlayers[ClientId])
+		return {};
+	CMapVoteCatalog::SPageId Page{
+		static_cast<CMapVoteCatalog::EPage>(m_apPlayers[ClientId]->m_MapVotePage),
+		m_apPlayers[ClientId]->m_MapVoteType,
+		m_apPlayers[ClientId]->m_MapVoteSubPage};
+	if(m_MapVoteCatalog.Active() && m_MapVoteCatalog.OptionCount(Page) > 0)
+		return Page;
+	return {};
+}
+
+void CGameContext::NavigateMapVotes(int ClientId, CMapVoteCatalog::SPageId Page)
+{
+	if(!m_MapVoteCatalog.Active() || ClientId < 0 || ClientId >= MAX_CLIENTS || !m_apPlayers[ClientId])
+		return;
+	if(m_MapVoteCatalog.OptionCount(Page) <= 0)
+		Page = {};
+
+	CNetMsg_Sv_VoteClearOptions ClearMsg;
+	Server()->SendPackMsg(&ClearMsg, MSGFLAG_VITAL, ClientId);
+	m_apPlayers[ClientId]->m_MapVotePage = static_cast<int>(Page.m_Page);
+	m_apPlayers[ClientId]->m_MapVoteType = Page.m_Type;
+	m_apPlayers[ClientId]->m_MapVoteSubPage = Page.m_SubPage;
+	m_apPlayers[ClientId]->m_SendVoteIndex = 0;
+}
+
+bool CGameContext::PublishMapVoteCatalog()
+{
+	std::string Error;
+	if(g_Config.m_SvMapWarehouseIndex[0] && !m_MapWarehouse.Load(Storage(), Console(), g_Config.m_SvMapWarehouseIndex, g_Config.m_SvMapWarehouseState, &Error))
+	{
+		char aMessage[256];
+		str_format(aMessage, sizeof(aMessage), "failed to load map warehouse: %s", Error.c_str());
+		Console()->Print(IConsole::OUTPUT_LEVEL_STANDARD, "map-warehouse", aMessage);
+		return false;
+	}
+	if(!m_MapVoteCatalog.Build(Storage(), Console(), m_MapWarehouse.Active() ? &m_MapWarehouse : nullptr, &Error))
+	{
+		char aMessage[256];
+		str_format(aMessage, sizeof(aMessage), "failed to publish map catalog: %s", Error.c_str());
+		Console()->Print(IConsole::OUTPUT_LEVEL_STANDARD, "map-votes", aMessage);
+		return false;
+	}
+
+	// One immutable catalog owns all map selections. Keeping the legacy list
+	// would leave a second command authority reachable through forged calls.
+	m_pVoteOptionHeap->Reset();
+	m_pVoteOptionFirst = nullptr;
+	m_pVoteOptionLast = nullptr;
+	m_NumVoteOptions = 0;
+
+	CNetMsg_Sv_VoteClearOptions ClearMsg;
+	Server()->SendPackMsg(&ClearMsg, MSGFLAG_VITAL, -1);
+	for(CPlayer *pPlayer : m_apPlayers)
+	{
+		if(!pPlayer)
+			continue;
+		pPlayer->m_MapVotePage = static_cast<int>(CMapVoteCatalog::EPage::ROOT);
+		pPlayer->m_MapVoteType = -1;
+		pPlayer->m_MapVoteSubPage = 0;
+		pPlayer->m_LastMapVoteNavigationTick = -1;
+		pPlayer->m_SendVoteIndex = 0;
+	}
+	return true;
+}
