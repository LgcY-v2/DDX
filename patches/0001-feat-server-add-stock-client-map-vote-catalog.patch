+void CGameContext::ConMapSearch(IConsole::IResult *pResult, void *pUserData)
+{
+	auto *pSelf = static_cast<CGameContext *>(pUserData);
+	const int ClientId = pResult->m_ClientId;
+	const bool ChatClient = ClientId >= 0 && ClientId < MAX_CLIENTS && pSelf->m_apPlayers[ClientId];
+	if(pResult->NumArguments() == 0)
+	{
+		if(ChatClient)
+		{
+			pSelf->SendChatTarget(ClientId, "Usage: /search <words or wildcards> [--name collection]");
+			pSelf->SendChatTarget(ClientId, "Example: /search *aip*race* --name AIP Race");
+			pSelf->SendChatTarget(ClientId, "Use separate words for any order, * for any text, ? for one character, and -word to exclude.");
+		}
+		else
+			pSelf->Console()->Print(IConsole::OUTPUT_LEVEL_STANDARD, "map-warehouse", "usage: search <words or wildcards> [--name collection]");
+		return;
+	}
+	CPlayer *pPlayer = ChatClient ? pSelf->m_apPlayers[ClientId] : nullptr;
+	if(ChatClient)
+	{
+		const int PlayerCooldown = 10 * pSelf->Server()->TickSpeed();
+		const int GlobalCooldown = 2 * pSelf->Server()->TickSpeed();
+		if((pPlayer->m_LastMapWarehouseSearchTick >= 0 && pPlayer->m_LastMapWarehouseSearchTick + PlayerCooldown > pSelf->Server()->Tick()) ||
+			(pSelf->m_LastMapWarehouseSearchTick >= 0 && pSelf->m_LastMapWarehouseSearchTick + GlobalCooldown > pSelf->Server()->Tick()))
+		{
+			pSelf->SendChatTarget(ClientId, "Please wait a moment before searching the archive again");
+			return;
+		}
+		pPlayer->m_LastMapWarehouseSearchTick = pSelf->Server()->Tick();
+		pSelf->m_LastMapWarehouseSearchTick = pSelf->Server()->Tick();
+	}
+	const CMapWarehouse::SSearchResult Search = pSelf->m_MapWarehouse.Search(pResult->GetString(0), pSelf->Storage());
+	if(Search.m_Status == CMapWarehouse::ESearchStatus::ERROR)
+	{
+		if(ChatClient)
+			pSelf->SendChatTarget(ClientId, Search.m_Message.c_str());
+		else
+			pSelf->Console()->Print(IConsole::OUTPUT_LEVEL_STANDARD, "map-warehouse", Search.m_Message.c_str());
+		return;
+	}
+	if(Search.m_Status == CMapWarehouse::ESearchStatus::CREATED && !pSelf->PublishMapVoteCatalog())
+	{
+		if(ChatClient)
+			pSelf->SendChatTarget(ClientId, "The search was saved, but the vote menu could not be refreshed");
+		else
+			pSelf->Console()->Print(IConsole::OUTPUT_LEVEL_STANDARD, "map-warehouse", "search saved, but the vote menu could not be refreshed");
+		return;
+	}
+	if(ChatClient)
+		pSelf->NavigateMapVotes(ClientId, {CMapVoteCatalog::EPage::WAREHOUSE_COLLECTION, Search.m_CollectionId, 0});
+	char aMessage[256];
+	if(Search.m_AliasMatches > Search.m_UniqueMatches)
+		str_format(aMessage, sizeof(aMessage), "%s: %s · %d unique maps from %d matching names. Open Call vote.", Search.m_Status == CMapWarehouse::ESearchStatus::CREATED ? "Created" : "Ready", Search.m_CollectionName.c_str(), Search.m_UniqueMatches, Search.m_AliasMatches);
+	else
+		str_format(aMessage, sizeof(aMessage), "%s: %s · %d maps. Open Call vote.", Search.m_Status == CMapWarehouse::ESearchStatus::CREATED ? "Created" : "Ready", Search.m_CollectionName.c_str(), Search.m_UniqueMatches);
+	if(ChatClient)
+		pSelf->SendChatTarget(ClientId, aMessage);
+	else
+		pSelf->Console()->Print(IConsole::OUTPUT_LEVEL_STANDARD, "map-warehouse", aMessage);
+}
+
+void CGameContext::ConWarehouseMap(IConsole::IResult *pResult, void *pUserData)
+{
+	auto *pSelf = static_cast<CGameContext *>(pUserData);
+	std::string DisplayName;
+	std::string Error;
+	if(!pSelf->m_MapWarehouse.QueueMap(pResult->GetString(0), pSelf->Engine(), pSelf->Storage(), g_Config.m_SvMapWarehouseArchive, g_Config.m_SvMapWarehouseDelta, g_Config.m_SvMapWarehouseExtractor, g_Config.m_SvMapWarehouseCache, g_Config.m_SvMapWarehouseCacheMegabytes, g_Config.m_SvMapWarehouseCacheMaps, pSelf->Map()->FullName(), &DisplayName, &Error))
+	{
+		char aMessage[256];
+		str_format(aMessage, sizeof(aMessage), "Could not prepare archive map: %s", Error.c_str());
+		pSelf->SendChat(-1, TEAM_ALL, aMessage);
+		return;
+	}
+	pSelf->m_LastMapWarehouseProgressMessage = 0;
+	char aMessage[256];
+	str_format(aMessage, sizeof(aMessage), "Vote passed. Preparing %s from the verified archive; solid-map extraction may take a little while.", DisplayName.c_str());
+	pSelf->SendChat(-1, TEAM_ALL, aMessage);
+}
