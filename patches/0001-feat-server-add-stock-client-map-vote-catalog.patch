+#ifndef GAME_SERVER_MAP_VOTE_CATALOG_H
+#define GAME_SERVER_MAP_VOTE_CATALOG_H
+
+#include <string>
+#include <vector>
+
+class IConsole;
+class IStorage;
+
+class CMapVoteCatalog
+{
+public:
+	enum class EOptionKind
+	{
+		NORMAL = 0,
+		FOLDER,
+		BACK,
+		RANDOM,
+		MAP,
+	};
+
+	enum class EPage : int
+	{
+		ROOT = 0,
+		DDRACE_TYPES,
+		GORES_TYPES,
+		OTHERS,
+		DDRACE_TYPE,
+		GORES_TYPE,
+	};
+
+	struct SPageId
+	{
+		EPage m_Page = EPage::ROOT;
+		int m_Type = -1;
+
+		bool operator==(const SPageId &Other) const { return m_Page == Other.m_Page && m_Type == Other.m_Type; }
+	};
+
+	struct SEntry
+	{
+		EOptionKind m_Kind = EOptionKind::NORMAL;
+		std::string m_Description{};
+		std::string m_Command{};
+		SPageId m_TargetPage{};
+		int m_RandomCategory = -1;
+		int m_RandomType = -1;
+	};
+
+	bool Build(IStorage *pStorage, IConsole *pConsole, std::string *pError = nullptr);
+	bool BuildFromStorageType(IStorage *pStorage, int StorageType, IConsole *pConsole, std::string *pError = nullptr);
+	void Clear();
+	bool Active() const { return m_Active; }
+	static bool IsNavigation(EOptionKind Kind) { return Kind == EOptionKind::FOLDER || Kind == EOptionKind::BACK; }
+	int OptionCount(SPageId Page) const;
+	const SEntry *OptionAt(SPageId Page, int Index) const;
+	const SEntry *Find(SPageId Page, const char *pDescription) const;
+	bool ResolveCommand(const SEntry &Entry, char *pCommand, int CommandSize) const;
+	int MapCount() const;
+
+private:
+	enum class ECategory : int
+	{
+		DDRACE = 0,
+		GORES,
+	};
+
+	struct SMap
+	{
+		std::string m_Name{};
+		std::string m_Path{};
+	};
+
+	struct SType
+	{
+		std::string m_Name{};
+		std::string m_DisplayName{};
+		std::vector<SMap> m_vMaps{};
+		std::vector<SEntry> m_vPage{};
+	};
+
+	bool m_Active = false;
+	std::vector<SType> m_vDdraceTypes{};
+	std::vector<SType> m_vGoresTypes{};
+	std::vector<SMap> m_vOtherMaps{};
+	std::vector<SEntry> m_vRootPage{};
+	std::vector<SEntry> m_vDdracePage{};
+	std::vector<SEntry> m_vGoresPage{};
+	std::vector<SEntry> m_vOthersPage{};
+
+	const std::vector<SEntry> *PageEntries(SPageId Page) const;
+	const std::vector<SType> &Types(ECategory Category) const;
+	static void DisambiguateTypeDisplayNames(std::vector<SType> &vTypes);
+	bool BuildPages(std::string *pError);
+};
+
+#endif // GAME_SERVER_MAP_VOTE_CATALOG_H
