+	struct SParsedSearch
+	{
+		std::vector<std::string> m_vPositive;
+		std::vector<std::string> m_vNegative;
+		std::string m_Name;
+		std::string m_CanonicalQuery;
+		bool m_ExplicitName = false;
+	};
+
+	bool Tokenize(const std::string &Input, std::vector<std::string> *pTokens, std::string *pError)
+	{
+		std::string Current;
+		bool Quoted = false;
+		bool Escaped = false;
+		for(char Ch : Input)
+		{
+			if(Escaped)
+			{
+				Current.push_back(Ch);
+				Escaped = false;
+			}
+			else if(Ch == '\\')
+				Escaped = true;
+			else if(Ch == '"')
+				Quoted = !Quoted;
+			else if(!Quoted && std::isspace(static_cast<unsigned char>(Ch)))
+			{
+				if(!Current.empty())
+				{
+					pTokens->push_back(Current);
+					Current.clear();
+				}
+			}
+			else
+				Current.push_back(Ch);
+		}
+		if(Escaped)
+			Current.push_back('\\');
+		if(Quoted)
+		{
+			SetError(pError, "A quote is not closed");
+			return false;
+		}
+		if(!Current.empty())
+			pTokens->push_back(Current);
+		return true;
+	}
+
+	bool ParseSearch(const char *pInput, SParsedSearch *pParsed, std::string *pError)
+	{
+		std::string Input = Trim(pInput ? pInput : "");
+		if(Input.empty())
+		{
+			SetError(pError, "Add one or more words after /search");
+			return false;
+		}
+		if(Input.size() > 180)
+		{
+			SetError(pError, "Searches are limited to 180 characters");
+			return false;
+		}
+		if(!str_utf8_check(Input.c_str()))
+		{
+			SetError(pError, "Search text must be valid UTF-8");
+			return false;
+		}
+
+		bool Quoted = false;
+		bool Escaped = false;
+		size_t NameMarker = std::string::npos;
+		for(size_t Index = 0; Index + 6 <= Input.size(); ++Index)
+		{
+			if(Escaped)
+			{
+				Escaped = false;
+				continue;
+			}
+			if(Input[Index] == '\\')
+			{
+				Escaped = true;
+				continue;
+			}
+			if(Input[Index] == '"')
+				Quoted = !Quoted;
+			if(!Quoted && (Index == 0 || std::isspace(static_cast<unsigned char>(Input[Index - 1]))) && Input.compare(Index, 6, "--name") == 0 && (Index + 6 == Input.size() || Input[Index + 6] == '=' || std::isspace(static_cast<unsigned char>(Input[Index + 6]))))
+			{
+				NameMarker = Index;
+				break;
+			}
+		}
+		std::string Query = NameMarker == std::string::npos ? Input : Trim(Input.substr(0, NameMarker));
+		if(NameMarker != std::string::npos)
+		{
+			pParsed->m_ExplicitName = true;
+			size_t NameStart = NameMarker + 6;
+			if(NameStart < Input.size() && Input[NameStart] == '=')
+				++NameStart;
+			pParsed->m_Name = Trim(Input.substr(NameStart));
+			if(pParsed->m_Name.size() >= 2 && pParsed->m_Name.front() == '"' && pParsed->m_Name.back() == '"')
+				pParsed->m_Name = pParsed->m_Name.substr(1, pParsed->m_Name.size() - 2);
+			pParsed->m_Name = Trim(pParsed->m_Name);
+			if(pParsed->m_Name.empty())
+			{
+				SetError(pError, "Write a collection name after --name");
+				return false;
+			}
+			if(!str_utf8_check(pParsed->m_Name.c_str()) || pParsed->m_Name.size() > 40 || pParsed->m_Name.find_first_of("/\\\t\r\n") != std::string::npos)
+			{
+				SetError(pError, "Collection names must be readable and at most 40 bytes");
+				return false;
+			}
+		}
+
+		std::vector<std::string> vTokens;
+		if(!Tokenize(Query, &vTokens, pError))
+			return false;
+		int PositiveLiteralCharacters = 0;
+		for(std::string Token : vTokens)
+		{
+			bool Negative = Token.size() > 1 && Token.front() == '-';
+			if(Negative)
+				Token.erase(Token.begin());
+			int TokenLiteralCharacters = 0;
+			const char *pCursor = Token.c_str();
+			while(*pCursor)
+			{
+				const int Codepoint = str_utf8_decode(&pCursor);
+				if(Codepoint != '*' && Codepoint != '?')
+					++TokenLiteralCharacters;
+			}
+			if(!Negative)
+				PositiveLiteralCharacters += TokenLiteralCharacters;
+			if(Token.find_first_of("*?") == std::string::npos)
+				Token = "*" + Token + "*";
+			Token = Normalize(Token);
+			(Negative ? pParsed->m_vNegative : pParsed->m_vPositive).push_back(std::move(Token));
+		}
+		if(pParsed->m_vPositive.empty())
+		{
+			SetError(pError, "A search needs at least one included word or pattern");
+			return false;
+		}
+		if(pParsed->m_vPositive.size() > 8 || pParsed->m_vNegative.size() > 8)
+		{
+			SetError(pError, "Use at most eight included and eight excluded patterns");
+			return false;
+		}
+		if(PositiveLiteralCharacters < 2)
+		{
+			SetError(pError, "Add at least two letters so the search is not too broad");
+			return false;
+		}
+
+		pParsed->m_CanonicalQuery = Query;
+		if(pParsed->m_Name.empty())
+		{
+			std::string Generated;
+			auto AddNamePiece = [&](std::string Piece) {
+				Piece = Trim(std::move(Piece));
+				if(Piece.empty())
+					return;
+				const bool ShortAsciiWord = Piece.size() <= 3 && std::all_of(Piece.begin(), Piece.end(), [](unsigned char Ch) {
+					return Ch < 128 && std::isalnum(Ch);
+				});
+				if(ShortAsciiWord)
+					std::transform(Piece.begin(), Piece.end(), Piece.begin(), [](unsigned char Ch) { return static_cast<char>(std::toupper(Ch)); });
+				else if(Piece[0] >= 'a' && Piece[0] <= 'z')
+					Piece[0] = static_cast<char>(std::toupper(Piece[0]));
+				if(!Generated.empty())
+					Generated += " · ";
+				Generated += Piece;
+			};
+			for(const std::string &Token : vTokens)
+			{
+				if(Token.size() > 1 && Token.front() == '-')
+					continue;
+				std::string Piece;
+				for(char Ch : Token)
+				{
+					if(Ch == '*' || Ch == '?' || Ch == '_' || Ch == '-')
+					{
+						AddNamePiece(std::move(Piece));
+						Piece.clear();
+					}
+					else
+						Piece.push_back(Ch);
+				}
+				AddNamePiece(std::move(Piece));
+			}
+			pParsed->m_Name = Utf8Truncate(Generated.empty() ? "Map search" : Generated, 40);
+			if(!pParsed->m_Name.empty() && pParsed->m_Name[0] >= 'a' && pParsed->m_Name[0] <= 'z')
+				pParsed->m_Name[0] = static_cast<char>(std::toupper(pParsed->m_Name[0]));
+		}
+		return true;
+	}
+
+	bool CalculateSha256(const char *pFilename, SHA256_DIGEST *pDigest)
+	{
+		IOHANDLE File = io_open(pFilename, IOFLAG_READ);
+		if(!File)
+			return false;
+		SHA256_CTX Context;
+		sha256_init(&Context);
+		unsigned char aBuffer[64 * 1024];
+		while(true)
+		{
+			const unsigned Bytes = io_read(File, aBuffer, sizeof(aBuffer));
+			if(Bytes == 0)
+				break;
+			sha256_update(&Context, aBuffer, Bytes);
+		}
+		io_close(File);
+		*pDigest = sha256_finish(&Context);
+		return true;
+	}
+
+	bool CopyFile(const char *pSource, const char *pDestination)
+	{
+		IOHANDLE Source = io_open(pSource, IOFLAG_READ);
+		if(!Source)
+			return false;
+		IOHANDLE Destination = io_open(pDestination, IOFLAG_WRITE);
+		if(!Destination)
+		{
+			io_close(Source);
+			return false;
+		}
+		bool Success = true;
+		unsigned char aBuffer[64 * 1024];
+		while(true)
+		{
+			const unsigned Bytes = io_read(Source, aBuffer, sizeof(aBuffer));
+			if(Bytes == 0)
+				break;
+			if(io_write(Destination, aBuffer, Bytes) != Bytes)
+			{
+				Success = false;
+				break;
+			}
+		}
+		Success = io_sync(Destination) == 0 && Success;
+		io_close(Destination);
+		io_close(Source);
+		return Success;
+	}
+
+	void TouchCacheFile(const std::string &Path)
+	{
+		std::error_code Error;
+		std::filesystem::last_write_time(Path, std::filesystem::file_time_type::clock::now(), Error);
+	}
+
+	std::string CacheSlug(const std::string &Name)
+	{
+		std::string Result;
+		bool LastDash = false;
+		for(unsigned char Ch : Name)
+		{
+			char Out = '-';
+			if((Ch >= 'a' && Ch <= 'z') || (Ch >= 'A' && Ch <= 'Z') || (Ch >= '0' && Ch <= '9'))
+				Out = static_cast<char>(Ch);
+			else if(Ch == '_' || Ch == '-')
+				Out = static_cast<char>(Ch);
+			if(Out == '-')
+			{
+				if(LastDash || Result.empty())
+					continue;
+				LastDash = true;
+			}
+			else
+				LastDash = false;
+			Result.push_back(Out);
+			if(Result.size() == 32)
+				break;
+		}
+		while(!Result.empty() && Result.back() == '-')
+			Result.pop_back();
+		return Result.empty() ? "map" : Result;
+	}
+
+	struct SCacheFile
+	{
+		std::string m_Path;
+		int64_t m_Size = 0;
+		time_t m_Modified = 0;
+	};
+
+	struct SCacheScan
+	{
+		std::string m_Directory;
+		std::vector<SCacheFile> m_vFiles;
+	};
+
+	int CacheScan(const CFsFileInfo *pInfo, int IsDir, int DirType, void *pUser)
+	{
+		(void)DirType;
+		if(IsDir || !pInfo || !str_endswith(pInfo->m_pName, ".map"))
+			return 0;
+		const char *pHashSeparator = str_rchr(pInfo->m_pName, '-');
+		if(!pHashSeparator || str_length(pHashSeparator + 1) != 68)
+			return 0;
+		std::string HashWithExtension = pHashSeparator + 1;
+		HashWithExtension.resize(64);
+		if(!IsHexHash(HashWithExtension))
+			return 0;
+		auto *pScan = static_cast<SCacheScan *>(pUser);
+		SCacheFile File;
+		File.m_Path = pScan->m_Directory + "/" + pInfo->m_pName;
+		IOHANDLE Handle = io_open(File.m_Path.c_str(), IOFLAG_READ);
+		if(!Handle)
+			return 0;
+		File.m_Size = io_length(Handle);
+		io_close(Handle);
+		if(File.m_Size < 0)
+			return 0;
+		File.m_Modified = pInfo->m_TimeModified;
+		pScan->m_vFiles.push_back(std::move(File));
+		return 0;
+	}
+
+	class CMapExtractJob final : public IJob
+	{
+		std::string m_ArchivePath;
+		std::string m_DeltaDirectory;
+		std::string m_ExtractorPath;
+		std::string m_CacheDirectory;
+		std::string m_CacheMapPrefix;
+		std::string m_CurrentMapPath;
+		CMapWarehouse::SMap m_Map;
+		int64_t m_MaxCacheBytes;
+		int m_MaxCacheMaps;
+
+		bool m_Success = false;
+		std::string m_ResultMapPath;
+		std::string m_Error;
+
+		void Fail(const std::string &Error)
+		{
+			m_Error = Error;
+			m_Success = false;
+		}
+
+		void Run() override
+		{
+			const std::string CacheName = CacheSlug(m_Map.m_Name) + "--" + m_Map.m_Hash + ".map";
+			const std::string FinalPath = m_CacheDirectory + "/" + CacheName;
+			m_ResultMapPath = m_CacheMapPrefix + "/" + CacheName.substr(0, CacheName.size() - 4);
+
+			SHA256_DIGEST Expected;
+			if(sha256_from_str(&Expected, m_Map.m_Hash.c_str()) != 0)
+			{
+				Fail("invalid expected map hash");
+				return;
+			}
+			SHA256_DIGEST Existing;
+			if(fs_is_file(FinalPath.c_str()))
+			{
+				if(CalculateSha256(FinalPath.c_str(), &Existing) && Existing == Expected)
+				{
+					TouchCacheFile(FinalPath);
+					m_Success = true;
+					return;
+				}
+				if(fs_remove(FinalPath.c_str()) != 0)
+				{
+					Fail("could not replace an invalid cached map");
+					return;
+				}
+			}
+
+			if(m_Map.m_Size > static_cast<uint64_t>(m_MaxCacheBytes))
+			{
+				Fail("map is larger than the configured cache limit");
+				return;
+			}
+			if(fs_makedir_rec_for(FinalPath.c_str()) != 0 && !fs_is_dir(m_CacheDirectory.c_str()))
+			{
+				Fail("could not create the map cache directory");
+				return;
+			}
+
+			char aNonce[64];
+			str_format(aNonce, sizeof(aNonce), "%d-%lld", process_id(), static_cast<long long>(time_get()));
+			const std::string TemporaryDirectory = m_CacheDirectory + "/.extract-" + m_Map.m_Hash + "-" + aNonce;
+			if(fs_makedir(TemporaryDirectory.c_str()) != 0)
+			{
+				Fail("could not create a private extraction directory");
+				return;
+			}
+			const std::string ExtractedPath = TemporaryDirectory + "/" + m_Map.m_SourcePath;
+
+			bool Extracted = false;
+			if(m_Map.m_SourceKind == 'A')
+			{
+				const std::string OutputArgument = "-o" + TemporaryDirectory;
+				const char *apArguments[] = {"e", "-bd", "-bb0", "-y", "-mmt=2", OutputArgument.c_str(), m_ArchivePath.c_str(), "--", m_Map.m_SourcePath.c_str()};
+				PROCESS Process = process_execute(m_ExtractorPath.c_str(), EShellExecuteWindowState::BACKGROUND, apArguments, std::size(apArguments));
+				if(Process != INVALID_PROCESS)
+				{
+					while(process_is_alive(Process))
+					{
+						if(State() == STATE_ABORTED)
+						{
+							process_kill(Process);
+							break;
+						}
+						std::this_thread::sleep_for(std::chrono::milliseconds(50));
+					}
+					Extracted = State() != STATE_ABORTED;
+				}
+			}
+			else if(m_Map.m_SourceKind == 'D')
+			{
+				const std::string Source = m_DeltaDirectory + "/" + m_Map.m_SourcePath;
+				Extracted = CopyFile(Source.c_str(), ExtractedPath.c_str());
+			}
+
+			SHA256_DIGEST Actual;
+			if(!Extracted || !CalculateSha256(ExtractedPath.c_str(), &Actual) || Actual != Expected)
+			{
+				(void)fs_remove(ExtractedPath.c_str());
+				(void)fs_removedir(TemporaryDirectory.c_str());
+				if(State() != STATE_ABORTED)
+					Fail("archive extraction did not produce the verified map");
+				return;
+			}
+
+			SCacheScan Scan;
+			Scan.m_Directory = m_CacheDirectory;
+			fs_listdir_fileinfo(m_CacheDirectory.c_str(), CacheScan, 0, &Scan);
+			std::sort(Scan.m_vFiles.begin(), Scan.m_vFiles.end(), [](const SCacheFile &Left, const SCacheFile &Right) {
+				return std::tie(Left.m_Modified, Left.m_Path) < std::tie(Right.m_Modified, Right.m_Path);
+			});
+			int64_t CacheBytes = 0;
+			for(const SCacheFile &File : Scan.m_vFiles)
+				CacheBytes += File.m_Size;
+			int CacheMaps = static_cast<int>(Scan.m_vFiles.size());
+			for(const SCacheFile &File : Scan.m_vFiles)
+			{
+				if(CacheMaps + 1 <= m_MaxCacheMaps && CacheBytes + static_cast<int64_t>(m_Map.m_Size) <= m_MaxCacheBytes)
+					break;
+				if(File.m_Path == FinalPath || File.m_Path == m_CurrentMapPath)
+					continue;
+				if(fs_remove(File.m_Path.c_str()) == 0)
+				{
+					--CacheMaps;
+					CacheBytes -= File.m_Size;
+				}
+			}
+			if(CacheMaps + 1 > m_MaxCacheMaps || CacheBytes + static_cast<int64_t>(m_Map.m_Size) > m_MaxCacheBytes)
+			{
+				(void)fs_remove(ExtractedPath.c_str());
+				(void)fs_removedir(TemporaryDirectory.c_str());
+				Fail("the bounded map cache is full while the current map is protected");
+				return;
+			}
+			(void)fs_remove(FinalPath.c_str());
+			if(fs_rename(ExtractedPath.c_str(), FinalPath.c_str()) != 0)
+			{
+				(void)fs_remove(ExtractedPath.c_str());
+				(void)fs_removedir(TemporaryDirectory.c_str());
+				Fail("could not publish the verified map into the cache");
+				return;
+			}
+			(void)fs_removedir(TemporaryDirectory.c_str());
+			TouchCacheFile(FinalPath);
+			m_Success = true;
+		}
+
+	public:
+		CMapExtractJob(const CMapWarehouse::SMap &Map, std::string ArchivePath, std::string DeltaDirectory, std::string ExtractorPath, std::string CacheDirectory, std::string CacheMapPrefix, int64_t MaxCacheBytes, int MaxCacheMaps, std::string CurrentMapPath) :
+			m_ArchivePath(std::move(ArchivePath)),
+			m_DeltaDirectory(std::move(DeltaDirectory)),
+			m_ExtractorPath(std::move(ExtractorPath)),
+			m_CacheDirectory(std::move(CacheDirectory)),
+			m_CacheMapPrefix(std::move(CacheMapPrefix)),
+			m_CurrentMapPath(std::move(CurrentMapPath)),
+			m_Map(Map),
+			m_MaxCacheBytes(MaxCacheBytes),
+			m_MaxCacheMaps(MaxCacheMaps)
+		{
+			Abortable(true);
+		}
+
+		bool Success() const { return m_Success; }
+		const std::string &ResultMapPath() const { return m_ResultMapPath; }
+		const std::string &Error() const { return m_Error; }
+	};
+} // namespace
