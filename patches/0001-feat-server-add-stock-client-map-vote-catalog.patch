+	{
+		return {
+			{"[BoD] AiP DDRace", TestHash(1), 100},
+			{"AiP Race Alias", TestHash(1), 100},
+			{"Race Before AiP", TestHash(2), 200},
+			{"AiP Solo Race Old", TestHash(3), 300},
+			{"Gores Race", TestHash(4), 400},
+			{"Zero Race", TestHash(5), 0},
+		};
+	}
