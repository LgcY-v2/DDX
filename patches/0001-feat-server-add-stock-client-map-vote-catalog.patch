+bool CMapWarehouse::LoadIndex(IStorage *pStorage, const char *pIndexPath, std::string *pError)
+{
+	char *pData = pStorage->ReadFileStr(pIndexPath, IStorage::TYPE_ALL_OR_ABSOLUTE);
+	if(!pData)
+	{
+		SetError(pError, "warehouse index is unreadable");
+		return false;
+	}
+	std::string Data(pData);
+	free(pData);
+	std::vector<std::string> vLines = Split(Data, '\n');
+	if(vLines.empty() || vLines[0] != INDEX_HEADER)
+	{
+		SetError(pError, "warehouse index has an unsupported header");
+		return false;
+	}
+
+	int DeclaredMaps = -1;
+	int DeclaredUnique = -1;
+	std::string ArchiveSha;
+	std::string AuthorityListingSha;
+	std::string MirrorListingSha;
+	size_t LineIndex = 1;
+	for(; LineIndex < vLines.size() && !vLines[LineIndex].empty(); ++LineIndex)
+	{
+		const std::vector<std::string> vFields = Split(vLines[LineIndex], '\t');
+		if(vFields.size() != 2)
+		{
+			SetError(pError, "warehouse index metadata is malformed");
+			return false;
+		}
+		if(vFields[0] == "archive_sha256")
+			ArchiveSha = vFields[1];
+		else if(vFields[0] == "authority_listing_sha256")
+			AuthorityListingSha = vFields[1];
+		else if(vFields[0] == "mirror_listing_sha256")
+			MirrorListingSha = vFields[1];
+		else if(vFields[0] == "map_entries")
+			DeclaredMaps = str_toint(vFields[1].c_str());
+		else if(vFields[0] == "unique_content")
+			DeclaredUnique = str_toint(vFields[1].c_str());
+	}
+	if(!IsHexHash(ArchiveSha) || !IsHexHash(AuthorityListingSha) || !IsHexHash(MirrorListingSha) || DeclaredMaps <= 0 || DeclaredUnique <= 0)
+	{
+		SetError(pError, "warehouse index metadata is incomplete");
+		return false;
+	}
+
+	std::vector<SMap> vMaps;
+	vMaps.reserve(DeclaredMaps);
+	std::unordered_map<std::string, uint64_t> ContentSizes;
+	for(++LineIndex; LineIndex < vLines.size(); ++LineIndex)
+	{
+		if(vLines[LineIndex].empty())
+			continue;
+		const std::vector<std::string> vFields = Split(vLines[LineIndex], '\t');
+		if(vFields.size() != 6 || vFields[0] != "M" || !IsHexHash(vFields[2]))
+		{
+			SetError(pError, "warehouse index contains a malformed map record");
+			return false;
+		}
+		SMap MapValue;
+		if(!PercentDecode(vFields[1], &MapValue.m_Name) || !PercentDecode(vFields[5], &MapValue.m_SourcePath) || !str_utf8_check(MapValue.m_Name.c_str()) || MapValue.m_Name.empty() || MapValue.m_Name.size() > 256)
+		{
+			SetError(pError, "warehouse index contains invalid encoded text");
+			return false;
+		}
+		MapValue.m_Hash = vFields[2];
+		const long long Size = str_toint64_base(vFields[3].c_str());
+		if(Size < 0 || (vFields[4] != "A" && vFields[4] != "D") || MapValue.m_SourcePath.empty() || MapValue.m_SourcePath.size() > 512 || MapValue.m_SourcePath == "." || MapValue.m_SourcePath == ".." || MapValue.m_SourcePath.find_first_of("/\\\t\r\n") != std::string::npos || !str_endswith_nocase(MapValue.m_SourcePath.c_str(), ".map"))
+		{
+			SetError(pError, "warehouse index contains an unsafe map source");
+			return false;
+		}
+		MapValue.m_Size = static_cast<uint64_t>(Size);
+		const auto [ContentIt, Inserted] = ContentSizes.emplace(MapValue.m_Hash, MapValue.m_Size);
+		if(!Inserted && ContentIt->second != MapValue.m_Size)
+		{
+			SetError(pError, "warehouse index disagrees about a map's content size");
+			return false;
+		}
+		MapValue.m_SourceKind = vFields[4][0];
+		MapValue.m_NormalizedName = Normalize(MapValue.m_Name);
+		vMaps.push_back(std::move(MapValue));
+	}
+	if(static_cast<int>(vMaps.size()) != DeclaredMaps || static_cast<int>(ContentSizes.size()) != DeclaredUnique)
+	{
+		SetError(pError, "warehouse index counts do not match its header");
+		return false;
+	}
+	m_vMaps = std::move(vMaps);
+	m_UniqueMapCount = DeclaredUnique;
+	m_IndexIdentity = ArchiveSha + ":" + AuthorityListingSha;
+	return true;
+}
+
+bool CMapWarehouse::LoadCollections(IStorage *pStorage, std::string *pError)
+{
+	m_vCollections.clear();
+	m_NextCollectionId = 1;
+	if(!pStorage->FileExists(m_StatePath.c_str(), IStorage::TYPE_SAVE))
+		return true;
+	char *pData = pStorage->ReadFileStr(m_StatePath.c_str(), IStorage::TYPE_SAVE);
+	if(!pData)
+	{
+		SetError(pError, "search collection state is unreadable");
+		return false;
+	}
+	std::string Data(pData);
+	free(pData);
+	const std::vector<std::string> vLines = Split(Data, '\n');
+	if(vLines.size() < 2 || vLines[0] != STATE_HEADER || vLines[1] != "index\t" + m_IndexIdentity)
+	{
+		SetError(pError, "search collection state belongs to another warehouse index");
+		return false;
+	}
+	std::unordered_map<std::string, int> CanonicalByHash;
+	for(int MapIndex = 0; MapIndex < static_cast<int>(m_vMaps.size()); ++MapIndex)
+		CanonicalByHash.try_emplace(m_vMaps[MapIndex].m_Hash, MapIndex);
+	std::set<int> Ids;
+	for(size_t LineIndex = 2; LineIndex < vLines.size(); ++LineIndex)
+	{
+		if(vLines[LineIndex].empty())
+			continue;
+		const std::vector<std::string> vFields = Split(vLines[LineIndex], '\t');
+		if(vFields.size() != 5 || vFields[0] != "C")
+		{
+			SetError(pError, "search collection state contains a malformed record");
+			return false;
+		}
+		SCollection Collection;
+		Collection.m_Id = str_toint(vFields[1].c_str());
+		if(Collection.m_Id <= 0 || Collection.m_Id > 1000000 || !Ids.insert(Collection.m_Id).second || !PercentDecode(vFields[2], &Collection.m_Name) || !PercentDecode(vFields[3], &Collection.m_Query) || !str_utf8_check(Collection.m_Name.c_str()) || !str_utf8_check(Collection.m_Query.c_str()))
+		{
+			SetError(pError, "search collection state contains an invalid identity");
+			return false;
+		}
+		std::set<std::string> Hashes;
+		for(const std::string &Hash : Split(vFields[4], ','))
+		{
+			if(Hash.empty())
+				continue;
+			const auto It = CanonicalByHash.find(Hash);
+			if(!IsHexHash(Hash) || It == CanonicalByHash.end() || !Hashes.insert(Hash).second)
+			{
+				SetError(pError, "search collection references an unknown map");
+				return false;
+			}
+			Collection.m_vMapIndices.push_back(It->second);
+		}
+		const bool DuplicateName = std::any_of(m_vCollections.begin(), m_vCollections.end(), [&](const SCollection &Existing) {
+			return str_utf8_comp_nocase(Existing.m_Name.c_str(), Collection.m_Name.c_str()) == 0;
+		});
+		if(Collection.m_Name.empty() || Collection.m_Name.size() > 40 || Collection.m_Query.empty() || Collection.m_Query.size() > 180 || DuplicateName || Collection.m_vMapIndices.empty() || Collection.m_vMapIndices.size() > MAX_COLLECTION_MAPS)
+		{
+			SetError(pError, "search collection exceeds runtime limits");
+			return false;
+		}
+		m_NextCollectionId = std::max(m_NextCollectionId, Collection.m_Id + 1);
+		m_vCollections.push_back(std::move(Collection));
+	}
+	if(m_vCollections.size() > MAX_COLLECTIONS)
+	{
+		SetError(pError, "too many persisted search collections");
+		return false;
+	}
+	return true;
+}
+
+bool CMapWarehouse::SaveCollections(IStorage *pStorage, std::string *pError) const
+{
+	std::string Content = std::string(STATE_HEADER) + "\nindex\t" + m_IndexIdentity + "\n";
+	for(const SCollection &Collection : m_vCollections)
+	{
+		Content += "C\t" + std::to_string(Collection.m_Id) + "\t" + PercentEncode(Collection.m_Name) + "\t" + PercentEncode(Collection.m_Query) + "\t";
+		for(size_t Index = 0; Index < Collection.m_vMapIndices.size(); ++Index)
+		{
+			const SMap *pMap = Map(Collection.m_vMapIndices[Index]);
+			if(!pMap)
+			{
+				SetError(pError, "search collection references an unknown map");
+				return false;
+			}
+			if(Index != 0)
+				Content.push_back(',');
+			Content += pMap->m_Hash;
+		}
+		Content.push_back('\n');
+	}
+	char aTemporary[IO_MAX_PATH_LENGTH];
+	IStorage::FormatTmpPath(aTemporary, sizeof(aTemporary), m_StatePath.c_str());
+	IOHANDLE File = pStorage->OpenFile(aTemporary, IOFLAG_WRITE, IStorage::TYPE_SAVE);
+	if(!File)
+	{
+		SetError(pError, "could not create search collection state");
+		return false;
+	}
+	const bool Written = io_write(File, Content.data(), Content.size()) == Content.size() && io_sync(File) == 0;
+	io_close(File);
+	if(!Written || !pStorage->RenameFile(aTemporary, m_StatePath.c_str(), IStorage::TYPE_SAVE))
+	{
+		pStorage->RemoveFile(aTemporary, IStorage::TYPE_SAVE);
+		SetError(pError, "could not atomically publish search collection state");
+		return false;
+	}
+	return true;
+}
+
+bool CMapWarehouse::Load(IStorage *pStorage, IConsole *pConsole, const char *pIndexPath, const char *pStatePath, std::string *pError)
+{
+	if(pError)
+		pError->clear();
+	m_Active = false;
+	m_vMaps.clear();
+	m_vCollections.clear();
+	if(!pStorage || !pIndexPath || !pIndexPath[0] || !pStatePath || !pStatePath[0] || !fs_is_relative_path(pStatePath) || str_find(pStatePath, ".."))
+	{
+		SetError(pError, "warehouse paths are not safely configured");
+		return false;
+	}
+	m_StatePath = pStatePath;
+	if(!LoadIndex(pStorage, pIndexPath, pError) || !LoadCollections(pStorage, pError))
+		return false;
+	m_Active = true;
+	if(pConsole)
+	{
+		char aMessage[192];
+		str_format(aMessage, sizeof(aMessage), "loaded %d historical names, %d unique maps and %d search collections", AliasCount(), UniqueMapCount(), static_cast<int>(m_vCollections.size()));
+		pConsole->Print(IConsole::OUTPUT_LEVEL_STANDARD, "map-warehouse", aMessage);
+	}
+	return true;
+}
+
+CMapWarehouse::SSearchResult CMapWarehouse::Search(const char *pInput, IStorage *pStorage)
+{
+	SSearchResult Result;
+	if(!m_Active || !pStorage)
+	{
+		Result.m_Message = "The map archive is unavailable";
+		return Result;
+	}
+	SParsedSearch Parsed;
+	if(!ParseSearch(pInput, &Parsed, &Result.m_Message))
+		return Result;
+
+	for(const SCollection &Collection : m_vCollections)
+	{
+		if(str_utf8_comp_nocase(Collection.m_Name.c_str(), Parsed.m_Name.c_str()) == 0)
+		{
+			if(Collection.m_Query == Parsed.m_CanonicalQuery)
+			{
+				Result.m_Status = ESearchStatus::EXISTING;
+				Result.m_CollectionId = Collection.m_Id;
+				Result.m_CollectionName = Collection.m_Name;
+				Result.m_UniqueMatches = static_cast<int>(Collection.m_vMapIndices.size());
+				Result.m_Message = "That search is already ready";
+				return Result;
+			}
+			if(Parsed.m_ExplicitName)
+			{
+				Result.m_Message = "That collection name is already in use; choose another with --name";
+				return Result;
+			}
+		}
+	}
+	if(!Parsed.m_ExplicitName)
+	{
+		const std::string BaseName = Parsed.m_Name;
+		for(int Suffix = 2;; ++Suffix)
+		{
+			const bool Available = std::none_of(m_vCollections.begin(), m_vCollections.end(), [&](const SCollection &Collection) {
+				return str_utf8_comp_nocase(Collection.m_Name.c_str(), Parsed.m_Name.c_str()) == 0;
+			});
+			if(Available)
+				break;
+			const std::string SuffixText = " · " + std::to_string(Suffix);
+			Parsed.m_Name = Utf8Truncate(BaseName, 40 - static_cast<int>(SuffixText.size())) + SuffixText;
+		}
+	}
+	if(m_vCollections.size() >= MAX_COLLECTIONS)
+	{
+		Result.m_Message = "The server already has 24 search collections; an administrator must clear them first";
+		return Result;
+	}
+
+	std::unordered_set<std::string> SeenHashes;
+	std::vector<int> vMatches;
+	for(int MapIndex = 0; MapIndex < static_cast<int>(m_vMaps.size()); ++MapIndex)
+	{
+		const SMap &MapValue = m_vMaps[MapIndex];
+		if(MapValue.m_Size == 0)
+			continue;
+		const bool Included = std::all_of(Parsed.m_vPositive.begin(), Parsed.m_vPositive.end(), [&](const std::string &Pattern) {
+			return GlobMatch(Pattern, MapValue.m_NormalizedName);
+		});
+		const bool Excluded = std::any_of(Parsed.m_vNegative.begin(), Parsed.m_vNegative.end(), [&](const std::string &Pattern) {
+			return GlobMatch(Pattern, MapValue.m_NormalizedName);
+		});
+		if(!Included || Excluded)
+			continue;
+		++Result.m_AliasMatches;
+		if(SeenHashes.insert(MapValue.m_Hash).second)
+		{
+			vMatches.push_back(MapIndex);
+			if(vMatches.size() > MAX_COLLECTION_MAPS)
+			{
+				Result.m_Message = "More than 1,000 unique maps matched; add another word or exclusion";
+				return Result;
+			}
+		}
+	}
+	if(vMatches.empty())
+	{
+		Result.m_Message = "No archive maps matched that search";
+		return Result;
+	}
+
+	SCollection Collection;
+	Collection.m_Id = m_NextCollectionId++;
+	Collection.m_Name = Parsed.m_Name;
+	Collection.m_Query = Parsed.m_CanonicalQuery;
+	Collection.m_vMapIndices = std::move(vMatches);
+	m_vCollections.push_back(Collection);
+	std::string Error;
+	if(!SaveCollections(pStorage, &Error))
+	{
+		m_vCollections.pop_back();
+		--m_NextCollectionId;
+		Result.m_Message = Error;
+		return Result;
+	}
+	Result.m_Status = ESearchStatus::CREATED;
+	Result.m_CollectionId = Collection.m_Id;
+	Result.m_CollectionName = Collection.m_Name;
+	Result.m_UniqueMatches = static_cast<int>(Collection.m_vMapIndices.size());
+	Result.m_Message = "Search collection created";
+	return Result;
+}
+
+bool CMapWarehouse::ClearCollections(IStorage *pStorage, std::string *pError)
+{
+	if(!pStorage)
+	{
+		SetError(pError, "storage is unavailable");
+		return false;
+	}
+	const std::vector<SCollection> vPrevious = m_vCollections;
+	m_vCollections.clear();
+	if(!SaveCollections(pStorage, pError))
+	{
+		m_vCollections = vPrevious;
+		return false;
+	}
+	m_NextCollectionId = 1;
+	return true;
+}
+
+bool CMapWarehouse::QueueMap(const char *pHash, IEngine *pEngine, IStorage *pStorage, const char *pArchivePath, const char *pDeltaDirectory, const char *pExtractorPath, const char *pCacheDirectory, int CacheMaxMegabytes, int CacheMaxMaps, const char *pCurrentMapPath, std::string *pDisplayName, std::string *pError)
+{
+	if(m_pExtractJob)
+	{
+		SetError(pError, "another archive map is already being prepared");
+		return false;
+	}
+	const bool ValidHash = pHash && IsHexHash(pHash);
+	const SMap *pMap = ValidHash ? CanonicalMapByHash(pHash) : nullptr;
+	if(!pMap || !pEngine || !pStorage || !pArchivePath || !pArchivePath[0] || !pDeltaDirectory || !pDeltaDirectory[0] || !pExtractorPath || !pExtractorPath[0] || !pCacheDirectory || !str_startswith(pCacheDirectory, "maps/") || str_find(pCacheDirectory, "..") || CacheMaxMegabytes < 64 || CacheMaxMaps < 2)
+	{
+		SetError(pError, "map warehouse runtime settings are invalid");
+		return false;
+	}
+	char aCacheAbsolute[IO_MAX_PATH_LENGTH];
+	pStorage->GetCompletePath(IStorage::TYPE_SAVE, pCacheDirectory, aCacheAbsolute, sizeof(aCacheAbsolute));
+	std::string CurrentAbsolute;
+	if(pCurrentMapPath && str_startswith(pCurrentMapPath, pCacheDirectory + str_length("maps/")))
+		CurrentAbsolute = std::string(aCacheAbsolute) + "/" + fs_filename(pCurrentMapPath) + ".map";
+	const int64_t MaxBytes = static_cast<int64_t>(CacheMaxMegabytes) * 1024 * 1024;
+	auto pJob = std::make_shared<CMapExtractJob>(*pMap, pArchivePath, pDeltaDirectory, pExtractorPath, aCacheAbsolute, pCacheDirectory + str_length("maps/"), MaxBytes, CacheMaxMaps, CurrentAbsolute);
+	m_pExtractJob = pJob;
+	m_PrepareStartTime = time_get();
+	m_PreparingDisplayName = pMap->m_Name;
+	if(pDisplayName)
+		*pDisplayName = pMap->m_Name;
+	pEngine->AddJob(pJob);
+	return true;
+}
+
+CMapWarehouse::SPreparedMap CMapWarehouse::PollPreparedMap()
+{
+	SPreparedMap Result;
+	if(!m_pExtractJob || !m_pExtractJob->Done())
+		return Result;
+	Result.m_Finished = true;
+	Result.m_DisplayName = m_PreparingDisplayName;
+	if(m_pExtractJob->State() == IJob::STATE_DONE)
+	{
+		const auto pJob = std::static_pointer_cast<CMapExtractJob>(m_pExtractJob);
+		Result.m_Success = pJob->Success();
+		Result.m_MapPath = pJob->ResultMapPath();
+		Result.m_Error = pJob->Error();
+	}
+	else
+		Result.m_Error = "map preparation was cancelled";
+	m_pExtractJob.reset();
+	m_PrepareStartTime = 0;
+	m_PreparingDisplayName.clear();
+	return Result;
+}
+
+void CMapWarehouse::AbortPreparation()
+{
+	if(m_pExtractJob && !m_pExtractJob->Done())
+		m_pExtractJob->Abort();
+}
