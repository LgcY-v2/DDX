+TEST(Server, RedirectAdmissionIsSingleUseAndIgnoresPort)
+{
+	CRedirectAdmission Admission;
+	NETADDR Granted;
+	NETADDR Arriving;
+	ASSERT_EQ(net_addr_from_str(&Granted, "192.0.2.4:40000"), 0);
+	ASSERT_EQ(net_addr_from_str(&Arriving, "192.0.2.4:50000"), 0);
+
+	ASSERT_TRUE(Admission.Add(Granted, 200, 100));
+	EXPECT_EQ(Admission.Size(100), 1U);
+	EXPECT_TRUE(Admission.Consume(Arriving, 150));
+	EXPECT_FALSE(Admission.Consume(Arriving, 150));
+}
+
+TEST(Server, RedirectAdmissionExpiresAndKeepsDistinctGrants)
+{
+	CRedirectAdmission Admission;
+	NETADDR First;
+	NETADDR Second;
+	ASSERT_EQ(net_addr_from_str(&First, "192.0.2.4:40000"), 0);
+	ASSERT_EQ(net_addr_from_str(&Second, "[2001:db8::4]"), 0);
+
+	ASSERT_TRUE(Admission.Add(First, 150, 100));
+	ASSERT_TRUE(Admission.Add(Second, 300, 100));
+	EXPECT_FALSE(Admission.Consume(First, 150));
+	EXPECT_TRUE(Admission.Consume(Second, 150));
+	EXPECT_EQ(Admission.Size(150), 0U);
+}
