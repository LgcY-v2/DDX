+#ifndef ENGINE_SERVER_REDIRECT_ADMISSION_H
+#define ENGINE_SERVER_REDIRECT_ADMISSION_H
+
+#include <base/net.h>
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+class CRedirectAdmission
+{
+	struct CEntry
+	{
+		NETADDR m_Address;
+		int64_t m_ExpiresAt;
+	};
+
+	static constexpr size_t MAX_ENTRIES = 128;
+	std::vector<CEntry> m_vEntries;
+
+	void RemoveExpired(int64_t Now)
+	{
+		m_vEntries.erase(
+			std::remove_if(m_vEntries.begin(), m_vEntries.end(), [Now](const CEntry &Entry) {
+				return Entry.m_ExpiresAt <= Now;
+			}),
+			m_vEntries.end());
+	}
+
+public:
+	bool Add(const NETADDR &Address, int64_t ExpiresAt, int64_t Now)
+	{
+		RemoveExpired(Now);
+		if(ExpiresAt <= Now || m_vEntries.size() >= MAX_ENTRIES)
+			return false;
+
+		NETADDR AddressWithoutPort = Address;
+		AddressWithoutPort.port = 0;
+		m_vEntries.push_back({AddressWithoutPort, ExpiresAt});
+		return true;
+	}
+
+	bool Consume(const NETADDR &Address, int64_t Now)
+	{
+		RemoveExpired(Now);
+		auto Iterator = std::find_if(m_vEntries.begin(), m_vEntries.end(), [&Address](const CEntry &Entry) {
+			return net_addr_comp_noport(&Entry.m_Address, &Address) == 0;
+		});
+		if(Iterator == m_vEntries.end())
+			return false;
+
+		m_vEntries.erase(Iterator);
+		return true;
+	}
+
+	size_t Size(int64_t Now)
+	{
+		RemoveExpired(Now);
+		return m_vEntries.size();
+	}
+};
+
+#endif
