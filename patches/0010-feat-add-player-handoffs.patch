+void CServer::ConRedirect(IConsole::IResult *pResult, void *pUser)
+{
+	CServer *pThis = static_cast<CServer *>(pUser);
+	if(pResult->m_ClientId != IConsole::CLIENT_ID_UNSPECIFIED)
+	{
+		pThis->Console()->Print(IConsole::OUTPUT_LEVEL_STANDARD, "server", "redirect failed: local console only");
+		return;
+	}
+	const int ClientId = pResult->GetInteger(0);
+	const int Port = pResult->GetInteger(1);
+	if(ClientId < 0 || ClientId >= MAX_CLIENTS || pThis->m_aClients[ClientId].m_State < CClient::STATE_READY)
+	{
+		pThis->Console()->Print(IConsole::OUTPUT_LEVEL_STANDARD, "server", "redirect failed: invalid client id");
+		return;
+	}
+	if(Port < 1 || Port > 65535)
+	{
+		pThis->Console()->Print(IConsole::OUTPUT_LEVEL_STANDARD, "server", "redirect failed: invalid port");
+		return;
+	}
+	if(pThis->GetClientVersion(ClientId) < VERSION_DDNET_REDIRECT)
+	{
+		pThis->Console()->Print(IConsole::OUTPUT_LEVEL_STANDARD, "server", "redirect failed: client does not support redirects");
+		return;
+	}
+
+	pThis->RedirectClient(ClientId, Port);
+	pThis->Console()->Print(IConsole::OUTPUT_LEVEL_STANDARD, "server", "redirect sent");
+}
+
+void CServer::ConRedirectGrant(IConsole::IResult *pResult, void *pUser)
+{
+	CServer *pThis = static_cast<CServer *>(pUser);
+	if(pResult->m_ClientId != IConsole::CLIENT_ID_UNSPECIFIED)
+	{
+		pThis->Console()->Print(IConsole::OUTPUT_LEVEL_STANDARD, "server", "redirect grant failed: local console only");
+		return;
+	}
+	NETADDR Address;
+	if(net_addr_from_str(&Address, pResult->GetString(0)) != 0)
+	{
+		pThis->Console()->Print(IConsole::OUTPUT_LEVEL_STANDARD, "server", "redirect grant failed: invalid address");
+		return;
+	}
+
+	const int LifetimeMs = pResult->GetInteger(1);
+	if(LifetimeMs < 100 || LifetimeMs > 10000)
+	{
+		pThis->Console()->Print(IConsole::OUTPUT_LEVEL_STANDARD, "server", "redirect grant failed: lifetime must be between 100 and 10000 ms");
+		return;
+	}
+
+	const int64_t Now = time_get();
+	const int64_t ExpiresAt = Now + (time_freq() * LifetimeMs) / 1000;
+	if(!pThis->m_RedirectAdmission.Add(Address, ExpiresAt, Now))
+	{
+		pThis->Console()->Print(IConsole::OUTPUT_LEVEL_STANDARD, "server", "redirect grant failed: admission table is full");
+		return;
+	}
+
+	pThis->Console()->Print(IConsole::OUTPUT_LEVEL_STANDARD, "server", "redirect grant added");
+}
