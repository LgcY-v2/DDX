+int CCollision::DdxCombinedOutputIndex(int Index) const
+{
+	const auto It = std::lower_bound(
+		m_vDdxCombinedOutputs.begin(), m_vDdxCombinedOutputs.end(), Index,
+		[](const CCombinedOutput &Output, int MapIndex) { return Output.m_MapIndex < MapIndex; });
+	return It != m_vDdxCombinedOutputs.end() && It->m_MapIndex == Index ? It->m_OutputIndex : -1;
+}
