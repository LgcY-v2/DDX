+bool CCollision::IsDdxCombinedTeleport(int Index) const
+{
+	if(Index < 0 || !m_pTele)
+		return false;
+	const int Type = m_pTele[Index].m_Type;
+	return DdxLegacyTeleport::IsCombinedNormal(m_DdxLegacyProfile.m_TeleLayer, Type) ||
+		DdxLegacyTeleport::IsCombinedEvil(m_DdxLegacyProfile.m_TeleLayer, Type);
+}
