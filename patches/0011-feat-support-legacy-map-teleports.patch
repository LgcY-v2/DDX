+}
+
+TEST(DdxLegacyTeleport, Legacy05PairedTilesHaveOnePolarityAndMatchingNumbers)
+{
+	EXPECT_EQ(Legacy05TeleportOutNumber(34), 0);
+	EXPECT_EQ(Legacy05TeleportInNumber(35), 0);
+	for(int Output = 35; Output <= 189; Output += 2)
+	{
+		const int Input = Output + 1;
+		EXPECT_EQ(Legacy05TeleportOutNumber(Output), Output >> 1);
+		EXPECT_EQ(Legacy05TeleportInNumber(Output), 0);
+		EXPECT_EQ(Legacy05TeleportInNumber(Input), Output >> 1);
+		EXPECT_EQ(Legacy05TeleportOutNumber(Input), 0);
+	}
+	EXPECT_EQ(Legacy05TeleportInNumber(190), 94);
+	EXPECT_EQ(Legacy05TeleportOutNumber(191), 0);
+}
