+TEST(DdxLegacyTeleport, SelectorsFailClosedWithoutClampingIntoAProfile)
+{
+	EXPECT_FALSE(IsKnownTeleSelector(INT_MIN));
+	EXPECT_FALSE(IsKnownTeleSelector(-1));
+	EXPECT_TRUE(IsKnownTeleSelector(0));
+	EXPECT_TRUE(IsKnownTeleSelector(1));
+	EXPECT_TRUE(IsKnownTeleSelector(2));
+	EXPECT_TRUE(IsKnownTeleSelector(3));
+	EXPECT_FALSE(IsKnownTeleSelector(4));
+	EXPECT_FALSE(IsKnownTeleSelector(INT_MAX));
+	EXPECT_EQ(TeleLayerFromSelector(INT_MIN), ETeleLayer::MODERN);
+	EXPECT_EQ(TeleLayerFromSelector(-1), ETeleLayer::MODERN);
+	EXPECT_EQ(TeleLayerFromSelector(0), ETeleLayer::MODERN);
+	EXPECT_EQ(TeleLayerFromSelector(1), ETeleLayer::FDDRACE_93_94);
+	EXPECT_EQ(TeleLayerFromSelector(2), ETeleLayer::FDDRACE_95_94);
+	EXPECT_EQ(TeleLayerFromSelector(3), ETeleLayer::XXL_STANDARD);
+	EXPECT_EQ(TeleLayerFromSelector(4), ETeleLayer::MODERN);
+	EXPECT_EQ(TeleLayerFromSelector(INT_MAX), ETeleLayer::MODERN);
+}
+
+TEST(DdxLegacyTeleport, ExactMapRequiresSizeAndFullSha256)
+{
+	SHA256_DIGEST Exact;
+	ASSERT_EQ(sha256_from_str(&Exact, "8f4a614b00f319694d877e3ee24ee3bd59cbe549a8eab2670db9ec0504a60ccf"), 0);
+	EXPECT_TRUE(IsLegacy05Map(107225, Exact));
+	EXPECT_FALSE(IsLegacy05Map(107224, Exact));
+
+	SHA256_DIGEST Different = Exact;
+	Different.data[SHA256_DIGEST_LENGTH - 1] ^= 1;
+	EXPECT_FALSE(IsLegacy05Map(107225, Different));
+	EXPECT_EQ(ResolveProfile(0, 107225, Different).m_GameLayer, EGameLayer::MODERN);
+
+	Different = Exact;
+	Different.data[0] ^= 1;
+	EXPECT_FALSE(IsLegacy05Map(107225, Different));
+	EXPECT_EQ(ResolveProfile(1, LEGACY_05_MAP_SIZE, Exact), (CProfile{EGameLayer::TEEWORLDS_05, ETeleLayer::FDDRACE_93_94}));
+	EXPECT_EQ(ResolveProfile(INT_MAX, LEGACY_05_MAP_SIZE, Exact), (CProfile{EGameLayer::TEEWORLDS_05, ETeleLayer::MODERN}));
+}
+
+TEST(DdxLegacyTeleport, ProfileResolutionDoesNotRetainPriorMapState)
+{
+	const CProfile Legacy = ResolveProfile(0, LEGACY_05_MAP_SIZE, LEGACY_05_MAP_SHA256);
+	const CProfile Modern = ResolveProfile(0, 0, SHA256_DIGEST{});
+	const CProfile LegacyAgain = ResolveProfile(0, LEGACY_05_MAP_SIZE, LEGACY_05_MAP_SHA256);
+	EXPECT_EQ(Legacy.m_GameLayer, EGameLayer::TEEWORLDS_05);
+	EXPECT_EQ(Modern, CProfile{});
+	EXPECT_EQ(LegacyAgain, Legacy);
+}
+
