+bool CCharacter::HandleDdxLegacyGameTile(int MapIndex)
+{
+	if(Collision()->DdxLegacyProfile().m_GameLayer != DdxLegacyTeleport::EGameLayer::TEEWORLDS_05)
+		return false;
+
+	const int Tile = Collision()->GetRawTileIndex(MapIndex);
+	if(!DdxLegacyTeleport::ConsumesLegacy05GameTile(Tile))
+		return false;
+
+	const DdxLegacyTeleport::CLegacy05Boost Boost = DdxLegacyTeleport::Legacy05Boost(Tile);
+	if(Boost.m_X || Boost.m_Y)
+	{
+		m_Core.m_Vel += vec2(Boost.m_X, Boost.m_Y);
+		if(Boost.m_Freeze)
+			Freeze(3);
+		return true;
+	}
+	if(Tile == 9)
+	{
+		Freeze(3);
+		return true;
+	}
+	if(Tile == 11)
+	{
+		Unfreeze();
+		return true;
+	}
+
+	const int Number = Collision()->Ddx05Teleport(MapIndex);
+	if(Number)
+	{
+		const std::vector<vec2> &vOutputs = Collision()->Ddx05TeleOuts(Number);
+		if(!vOutputs.empty())
+		{
+			m_Core.m_Pos = vOutputs[GameWorld()->m_Core.RandomOr0(vOutputs.size())];
+			ResetHook();
+		}
+	}
+	return true;
+}
+
+bool CCharacter::HandleDdxLegacyTeleporter(int MapIndex)
+{
+	const DdxLegacyTeleport::ETeleLayer Layer = Collision()->DdxLegacyProfile().m_TeleLayer;
+	if(DdxLegacyTeleport::IsCombined(Layer))
+	{
+		const int Normal = Collision()->IsTeleport(MapIndex);
+		const int Evil = Collision()->IsEvilTeleport(MapIndex);
+		m_DdxLastCombinedTeleporter = DdxLegacyTeleport::RetainCombinedEntry(m_DdxLastCombinedTeleporter, Normal, Evil);
+		if(!Collision()->IsDdxCombinedTeleport(MapIndex))
+			return false;
+
+		const bool IsEvil = Evil != 0;
+		const int Number = IsEvil ? Evil : Normal;
+		if(Number <= 0 || m_Core.m_Super || m_Core.m_Invincible || m_DdxLastCombinedTeleporter == Number)
+			return true;
+		if(!IsEvil && (g_Config.m_SvOldTeleportHook || g_Config.m_SvOldTeleportWeapons))
+			return true;
+
+		const std::vector<vec2> &vOutputs = Collision()->DdxTeleOuts(Number - 1);
+		const int CurrentOutput = Collision()->DdxCombinedOutputIndex(MapIndex);
+		if(vOutputs.size() <= 1 || CurrentOutput < 0)
+			return true;
+		const size_t Draw = GameWorld()->m_Core.RandomOr0(vOutputs.size() - 1);
+		const size_t Output = DdxLegacyTeleport::AlternativeOutputIndex(vOutputs.size(), CurrentOutput, Draw);
+		if(Output == DdxLegacyTeleport::INVALID_OUTPUT)
+			return true;
+
+		m_DdxLastCombinedTeleporter = Number;
+		m_Core.m_Pos = vOutputs[Output];
+		if(IsEvil)
+		{
+			if(!g_Config.m_SvOldTeleportHook && !g_Config.m_SvOldTeleportWeapons)
+			{
+				m_Core.m_Vel = vec2(0, 0);
+				if(!g_Config.m_SvTeleportHoldHook)
+				{
+					ResetHook();
+					GameWorld()->ReleaseHooked(GetPlayer()->GetCid());
+				}
+				if(g_Config.m_SvTeleportLoseWeapons)
+					ResetPickups();
+			}
+		}
+		else
+		{
+			if(!g_Config.m_SvTeleportHoldHook)
+				ResetHook();
+			if(g_Config.m_SvTeleportLoseWeapons)
+				ResetPickups();
+		}
+		return true;
+	}
+
+	if(Layer != DdxLegacyTeleport::ETeleLayer::XXL_STANDARD)
+		return false;
+
+	const int Normal = Collision()->IsTeleport(MapIndex);
+	if(Normal)
+	{
+		const std::vector<vec2> &vOutputs = Collision()->DdxTeleOuts(Normal - 1);
+		if(!vOutputs.empty())
+		{
+			m_Core.m_Pos = vOutputs[GameWorld()->m_Core.RandomOr0(vOutputs.size())];
+			ResetHook();
+		}
+		return true;
+	}
+
+	const int Evil = Collision()->IsEvilTeleport(MapIndex);
+	if(Evil)
+	{
+		const std::vector<vec2> &vOutputs = Collision()->DdxTeleOuts(Evil - 1);
+		if(!m_Core.m_Super && !m_Core.m_Invincible && !vOutputs.empty())
+		{
+			m_Core.m_Pos = vOutputs[GameWorld()->m_Core.RandomOr0(vOutputs.size())];
+			m_Core.m_Vel = vec2(0, 0);
+			ResetHook();
+			GameWorld()->ReleaseHooked(GetPlayer()->GetCid());
+		}
+		return true;
+	}
+
+	if(!Collision()->IsCheckTeleport(MapIndex))
+		return false;
+	for(int k = m_TeleCheckpoint - 1; k >= 0; k--)
+	{
+		const std::vector<vec2> &vOutputs = Collision()->TeleCheckOuts(k);
+		if(!vOutputs.empty())
+		{
+			m_Core.m_Pos = vOutputs[GameWorld()->m_Core.RandomOr0(vOutputs.size())];
+			ResetHook();
+			return true;
+		}
+	}
+	vec2 SpawnPos;
+	if(GameServer()->m_pController->CanSpawn(m_pPlayer->GetTeam(), &SpawnPos, GetPlayer()->GetCid()))
+	{
+		m_Core.m_Pos = SpawnPos;
+		ResetHook();
+	}
+	return true;
+}
