--- /dev/null
+++ b/src/game/ddx_legacy_teleport.h
@@ -0,0 +1,168 @@
+#ifndef GAME_DDX_LEGACY_TELEPORT_H
+#define GAME_DDX_LEGACY_TELEPORT_H
+
+#include <base/hash.h>
+
+#include <cstddef>
+#include <limits>
+
+namespace DdxLegacyTeleport
+{
+enum class EGameLayer
+{
+	MODERN,
+	TEEWORLDS_05,
+};
+
+enum class ETeleLayer
+{
+	MODERN,
+	FDDRACE_93_94,
+	FDDRACE_95_94,
+	XXL_STANDARD,
+};
+
+struct CProfile
+{
+	EGameLayer m_GameLayer = EGameLayer::MODERN;
+	ETeleLayer m_TeleLayer = ETeleLayer::MODERN;
+
+	bool operator==(const CProfile &Other) const = default;
+};
+
+constexpr bool IsKnownTeleSelector(int Value)
+{
+	return Value >= 0 && Value <= 3;
+}
+
+constexpr ETeleLayer TeleLayerFromSelector(int Value)
+{
+	switch(Value)
+	{
+	case 1: return ETeleLayer::FDDRACE_93_94;
+	case 2: return ETeleLayer::FDDRACE_95_94;
+	case 3: return ETeleLayer::XXL_STANDARD;
+	default: return ETeleLayer::MODERN;
+	}
+}
+
+constexpr bool IsCombined(ETeleLayer Layer)
+{
+	return Layer == ETeleLayer::FDDRACE_93_94 || Layer == ETeleLayer::FDDRACE_95_94;
+}
+
+constexpr bool IsCombinedNormal(ETeleLayer Layer, int Type)
+{
+	return (Layer == ETeleLayer::FDDRACE_93_94 && Type == 93) ||
+		(Layer == ETeleLayer::FDDRACE_95_94 && Type == 95);
+}
+
+constexpr bool IsCombinedEvil(ETeleLayer Layer, int Type)
+{
+	return IsCombined(Layer) && Type == 94;
+}
+
+constexpr SHA256_DIGEST LEGACY_05_MAP_SHA256 = {{
+	0x8f, 0x4a, 0x61, 0x4b, 0x00, 0xf3, 0x19, 0x69,
+	0x4d, 0x87, 0x7e, 0x3e, 0xe2, 0x4e, 0xe3, 0xbd,
+	0x59, 0xcb, 0xe5, 0x49, 0xa8, 0xea, 0xb2, 0x67,
+	0x0d, 0xb9, 0xec, 0x05, 0x04, 0xa6, 0x0c, 0xcf,
+}};
+
+constexpr unsigned LEGACY_05_MAP_SIZE = 107225;
+
+inline bool IsLegacy05Map(unsigned Size, const SHA256_DIGEST &Sha256)
+{
+	return Size == LEGACY_05_MAP_SIZE && Sha256 == LEGACY_05_MAP_SHA256;
+}
+
+inline CProfile ResolveProfile(int TeleSelector, unsigned MapSize, const SHA256_DIGEST &MapSha256)
+{
+	return {
+		IsLegacy05Map(MapSize, MapSha256) ? EGameLayer::TEEWORLDS_05 : EGameLayer::MODERN,
+		TeleLayerFromSelector(TeleSelector),
+	};
+}
+
+constexpr const char *GameLayerName(EGameLayer Layer)
+{
+	return Layer == EGameLayer::TEEWORLDS_05 ? "teeworlds-0.5" : "modern";
+}
+
+constexpr const char *TeleLayerName(ETeleLayer Layer)
+{
+	switch(Layer)
+	{
+	case ETeleLayer::FDDRACE_93_94: return "f-ddrace-93-94";
+	case ETeleLayer::FDDRACE_95_94: return "f-ddrace-95-94";
+	case ETeleLayer::XXL_STANDARD: return "xxl-standard";
+	case ETeleLayer::MODERN: return "modern";
+	}
+	return "modern";
+}
+
+constexpr int ModernGameTile(EGameLayer Layer, int RawTile)
+{
+	if(Layer == EGameLayer::MODERN)
+		return RawTile;
+	return (RawTile >= 0 && RawTile <= 4) || RawTile == 33 || RawTile == 34 ? RawTile : 0;
+}
+
+constexpr bool ConsumesLegacy05GameTile(int Tile)
+{
+	return (Tile >= 5 && Tile <= 32) || (Tile >= 35 && Tile <= 190);
+}
+
+constexpr int Legacy05TeleportInNumber(int Tile)
+{
+	return Tile >= 36 && Tile <= 190 && Tile % 2 == 0 ? (Tile - 1) >> 1 : 0;
+}
+
+constexpr int Legacy05TeleportOutNumber(int Tile)
+{
+	return Tile >= 35 && Tile <= 189 && Tile % 2 == 1 ? Tile >> 1 : 0;
+}
+
+struct CLegacy05Boost
+{
+	int m_X;
+	int m_Y;
+	bool m_Freeze;
+
+	bool operator==(const CLegacy05Boost &Other) const = default;
+};
+
+constexpr CLegacy05Boost Legacy05Boost(int Tile)
+{
+	switch(Tile)
+	{
+	case 5: return {-3, 0, false};
+	case 6: return {3, 0, false};
+	case 8: return {0, -2, false};
+	case 12: return {-15, 0, false};
+	case 13: return {15, 0, false};
+	case 14: return {0, 15, false};
+	case 15: return {0, -15, false};
+	case 21: return {-3, 0, true};
+	case 22: return {3, 0, true};
+	case 23: return {0, 2, true};
+	default: return {0, 0, false};
+	}
+}
+
+constexpr size_t INVALID_OUTPUT = std::numeric_limits<size_t>::max();
+
+constexpr size_t AlternativeOutputIndex(size_t OutputCount, size_t CurrentIndex, size_t Draw)
+{
+	if(OutputCount <= 1 || CurrentIndex >= OutputCount || Draw >= OutputCount - 1)
+		return INVALID_OUTPUT;
+	return Draw >= CurrentIndex ? Draw + 1 : Draw;
+}
+
+constexpr int RetainCombinedEntry(int PreviousNumber, int NormalNumber, int EvilNumber)
+{
+	return (NormalNumber == PreviousNumber || EvilNumber == PreviousNumber) ? PreviousNumber : 0;
+}
