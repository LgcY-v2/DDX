+bool CCharacter::HandleDdx05Tiles(int MapIndex)
+{
+	if(DdxCompat::Family(m_DdxCompatFamily) != DdxCompat::EFamily::XXLDDRACE_05)
+		return false;
+	const int Tile = Collision()->GetRawTileIndex(MapIndex);
+	if(Tile == 10)
+	{
+		Server()->Kick(m_pPlayer->GetCid(), "Kicked by historical map kick zone");
+		return true;
+	}
+	const DdxGameCompat::CLegacy05Boost Boost = DdxGameCompat::Legacy05Boost(Tile);
+	if(Boost.m_X || Boost.m_Y)
+	{
+		m_Core.m_Vel += vec2(Boost.m_X, Boost.m_Y);
+		if(Boost.m_Freeze && !m_Core.m_Super && !m_Core.m_Invincible && !m_Core.m_DeepFrozen)
+			Freeze();
+	}
+	const int Teleport = Collision()->Ddx05Teleport(MapIndex);
+	const std::vector<vec2> &vOutputs = Collision()->Ddx05TeleOuts(Teleport);
+	if(!Teleport || vOutputs.empty())
+		return false;
+	m_Core.m_Pos = vOutputs[GameWorld()->m_Core.RandomOr0(vOutputs.size())];
+	ResetHook();
+	return true;
+}
