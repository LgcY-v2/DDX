--- /dev/null
+++ b/src/game/ddx_game_compat.h
@@ -0,0 +1,69 @@
+#ifndef GAME_DDX_GAME_COMPAT_H
+#define GAME_DDX_GAME_COMPAT_H
+
+namespace DdxGameCompat
+{
+enum class EFamily
+{
+	OFF = 0,
+	XXLDDRACE = 1,
+	TBLOCK = 2,
+	FTK = 3,
+	XXLDDRACE_05 = 4,
+};
+
+constexpr EFamily Family(int Value)
+{
+	return Value >= static_cast<int>(EFamily::XXLDDRACE) && Value <= static_cast<int>(EFamily::XXLDDRACE_05) ?
+		static_cast<EFamily>(Value) : EFamily::OFF;
+}
+
+constexpr bool IsLegacy05(EFamily Family)
+{
+	return Family == EFamily::XXLDDRACE_05;
+}
+
+constexpr bool IsLegacy05EncodedGameTile(int Tile)
+{
+	return (Tile >= 5 && Tile <= 32 && Tile != 9 && Tile != 11) || (Tile >= 35 && Tile <= 175);
+}
+
+constexpr int Legacy05TeleportInNumber(int Tile)
+{
+	return Tile >= 36 && Tile <= 174 && Tile % 2 == 0 ? (Tile - 1) >> 1 : 0;
+}
+
+constexpr int Legacy05TeleportOutNumber(int Tile)
+{
+	return Tile >= 35 && Tile <= 175 && Tile % 2 == 1 ? Tile >> 1 : 0;
+}
+
+struct CLegacy05Boost
+{
+	int m_X;
+	int m_Y;
+	bool m_Freeze;
+};
+
+constexpr CLegacy05Boost Legacy05Boost(int Tile)
+{
+	switch(Tile)
+	{
+	case 5: return {-3, 0, false};
+	case 6: return {3, 0, false};
+	case 7: return {0, 2, false};
+	case 8: return {0, -2, false};
+	case 12: return {-15, 0, false};
+	case 13: return {15, 0, false};
+	case 14: return {0, 15, false};
+	case 15: return {0, -15, false};
+	case 21: return {-3, 0, true};
+	case 22: return {3, 0, true};
+	case 23: return {0, 2, true};
+	case 24: return {0, -2, true};
+	default: return {0, 0, false};
+	}
+}
+} // namespace DdxGameCompat
+
+#endif // GAME_DDX_GAME_COMPAT_H
