new file mode 100644
index 0000000..be77ffe
--- /dev/null
+++ b/src/test/ddx_rapid_fire_test.cpp
@@ -0,0 +1,19 @@
+#include <game/server/ddx_rapid_fire.h>
+
+#include <gtest/gtest.h>
+
+TEST(DdxRapidFire, RoundsDelayUpToServerTicks)
+{
+	EXPECT_EQ(DdxRapidFire::DelayTicks(1, 50), 1);
+	EXPECT_EQ(DdxRapidFire::DelayTicks(20, 50), 1);
+	EXPECT_EQ(DdxRapidFire::DelayTicks(21, 50), 2);
+	EXPECT_EQ(DdxRapidFire::DelayTicks(100, 50), 5);
+	EXPECT_EQ(DdxRapidFire::DelayMs(5, 50), 100);
+}
+
+TEST(DdxRapidFire, UsesAnAbsoluteFireDeadline)
+{
+	EXPECT_TRUE(DdxRapidFire::CanFire(100, -1, 5));
+	EXPECT_FALSE(DdxRapidFire::CanFire(104, 100, 5));
+	EXPECT_TRUE(DdxRapidFire::CanFire(105, 100, 5));
+}
