+void CGameContext::ConAip(IConsole::IResult *pResult, void *pUserData)
+{
+	CGameContext *pSelf = (CGameContext *)pUserData;
+
+	const bool HasDelay = pResult->NumArguments() > 0;
+	int DelayTicks = 1;
+	if(HasDelay)
+	{
+		const int DelayMs = pResult->GetInteger(0);
+		if(DelayMs < 1 || DelayMs > 10000)
+		{
+			pSelf->Console()->Print(IConsole::OUTPUT_LEVEL_STANDARD, "aip", "delay must be 1..10000 ms");
+			return;
+		}
+		DelayTicks = DdxRapidFire::DelayTicks(DelayMs, pSelf->Server()->TickSpeed());
+	}
+
+	const int ClientId = pResult->NumArguments() > 1 ? pResult->GetVictim() : pResult->m_ClientId;
+	if(!CheckClientId(ClientId))
+	{
+		pSelf->Console()->Print(IConsole::OUTPUT_LEVEL_STANDARD, "aip", "a client must be specified outside rcon");
+		return;
+	}
+	CPlayer *pPlayer = pSelf->m_apPlayers[ClientId];
+	if(!pPlayer)
+		return;
+	if(HasDelay)
+		pPlayer->m_AipDelayTicks = DelayTicks;
+	else
+		pPlayer->m_AipDelayTicks = pPlayer->m_AipDelayTicks == 0 ? 1 : 0;
+	pSelf->SendTuningParams(ClientId, pPlayer->m_TuneZone);
+	char aBuf[96];
+	if(pPlayer->m_AipDelayTicks == 0)
+		str_format(aBuf, sizeof(aBuf), "rapid fire disabled for client %d", ClientId);
+	else
+	{
+		const int DelayMs = DdxRapidFire::DelayMs(pPlayer->m_AipDelayTicks, pSelf->Server()->TickSpeed());
+		str_format(aBuf, sizeof(aBuf), "rapid fire client %d: %d ms (%d shots/s)", ClientId, DelayMs, pSelf->Server()->TickSpeed() / pPlayer->m_AipDelayTicks);
+	}
+	pSelf->Console()->Print(IConsole::OUTPUT_LEVEL_STANDARD, "aip", aBuf);
+}
