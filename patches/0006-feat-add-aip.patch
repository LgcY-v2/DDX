+#ifndef GAME_SERVER_DDX_RAPID_FIRE_H
+#define GAME_SERVER_DDX_RAPID_FIRE_H
+
+#include <algorithm>
+
+namespace DdxRapidFire
+{
+constexpr int DelayTicks(int DelayMs, int TickSpeed)
+{
+	return std::max(1, (DelayMs * TickSpeed + 999) / 1000);
+}
+
+constexpr int DelayMs(int DelayTicks, int TickSpeed)
+{
+	return (DelayTicks * 1000 + TickSpeed - 1) / TickSpeed;
+}
+
+constexpr bool CanFire(int Tick, int LastFireTick, int DelayTicks)
+{
+	return LastFireTick < 0 || Tick >= LastFireTick + DelayTicks;
+}
+} // namespace DdxRapidFire
+
+#endif // GAME_SERVER_DDX_RAPID_FIRE_H
