diff --git b/src/game/server/ddx_sudo.h b/src/game/server/ddx_sudo.h
new file mode 100644
index 0000000..d9b76b5
--- /dev/null
+++ b/src/game/server/ddx_sudo.h
@@ -0,0 +1,29 @@
+#ifndef GAME_SERVER_DDX_SUDO_H
+#define GAME_SERVER_DDX_SUDO_H
+
+namespace DdxSudo
+{
+	enum class EMovementTarget
+	{
+		SELF,
+		SPECTATED_PLAYER,
+		NONE,
+	};
+
+	constexpr EMovementTarget ResolveMovementTarget(
+		bool Enabled,
+		bool IsOwner,
+		bool IsSpectating,
+		bool HasDirectTarget,
+		bool CanManageTarget,
+		bool TargetHasCharacter)
+	{
+		if(!Enabled || !IsOwner || !IsSpectating || !HasDirectTarget)
+			return EMovementTarget::SELF;
+		if(!CanManageTarget || !TargetHasCharacter)
+			return EMovementTarget::NONE;
+		return EMovementTarget::SPECTATED_PLAYER;
+	}
+} // namespace DdxSudo
+
+#endif // GAME_SERVER_DDX_SUDO_H
