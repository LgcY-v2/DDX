new file mode 100644
index 0000000..1109965
--- /dev/null
+++ b/src/test/ddx_sudo_test.cpp
@@ -0,0 +1,26 @@
+#include <game/server/ddx_sudo.h>
+
+#include <gtest/gtest.h>
+
+TEST(DdxSudo, KeepsSelfMovementWithoutAnEligibleDirectTarget)
+{
+	using ETarget = DdxSudo::EMovementTarget;
+	EXPECT_EQ(DdxSudo::ResolveMovementTarget(false, true, true, true, true, true), ETarget::SELF);
+	EXPECT_EQ(DdxSudo::ResolveMovementTarget(true, false, true, true, true, true), ETarget::SELF);
+	EXPECT_EQ(DdxSudo::ResolveMovementTarget(true, true, false, true, true, true), ETarget::SELF);
+	EXPECT_EQ(DdxSudo::ResolveMovementTarget(true, true, true, false, true, true), ETarget::SELF);
+}
+
+TEST(DdxSudo, FailsClosedForAnUnavailableDirectTarget)
+{
+	using ETarget = DdxSudo::EMovementTarget;
+	EXPECT_EQ(DdxSudo::ResolveMovementTarget(true, true, true, true, false, true), ETarget::NONE);
+	EXPECT_EQ(DdxSudo::ResolveMovementTarget(true, true, true, true, true, false), ETarget::NONE);
+}
+
+TEST(DdxSudo, MovesAnEligibleDirectlySpectatedPlayer)
+{
+	EXPECT_EQ(
+		DdxSudo::ResolveMovementTarget(true, true, true, true, true, true),
+		DdxSudo::EMovementTarget::SPECTATED_PLAYER);
+}
