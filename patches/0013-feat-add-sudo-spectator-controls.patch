+void CGameContext::MoveCharacterByDirection(int ClientId, int X, int Y)
+{
+	if(!CheckClientId(ClientId) || !m_apPlayers[ClientId])
+		return;
+
+	CPlayer *pPlayer = m_apPlayers[ClientId];
+	const int SpectatorId = pPlayer->SpectatorId();
+	const bool HasDirectTarget = SpectatorId >= 0;
+	const bool TargetIdValid = CheckClientId(SpectatorId);
+	const DdxSudo::EMovementTarget Target = DdxSudo::ResolveMovementTarget(
+		pPlayer->m_SudoSpectatorControl,
+		DdxAuth::IsOwner(Server()->GetAuthedState(ClientId)),
+		pPlayer->GetTeam() == TEAM_SPECTATORS || pPlayer->IsPaused(),
+		HasDirectTarget,
+		TargetIdValid && Server()->CanManageClient(ClientId, SpectatorId),
+		TargetIdValid && GetPlayerChar(SpectatorId) != nullptr);
+
+	switch(Target)
+	{
+	case DdxSudo::EMovementTarget::SELF:
+		MoveCharacter(ClientId, X, Y);
+		break;
+	case DdxSudo::EMovementTarget::SPECTATED_PLAYER:
+		MoveCharacter(SpectatorId, X, Y);
+		break;
+	case DdxSudo::EMovementTarget::NONE:
+		break;
+	}
+}
+
+void CGameContext::ConSudo(IConsole::IResult *pResult, void *pUserData)
+{
+	CGameContext *pSelf = static_cast<CGameContext *>(pUserData);
+	const int ClientId = pResult->m_ClientId;
+	if(!CheckClientId(ClientId) || !pSelf->m_apPlayers[ClientId] ||
+		!DdxAuth::IsOwner(pSelf->Server()->GetAuthedState(ClientId)))
+	{
+		pSelf->Console()->Print(IConsole::OUTPUT_LEVEL_STANDARD, "sudo", "Sudo requires a connected owner client.");
+		return;
+	}
+
+	CPlayer *pPlayer = pSelf->m_apPlayers[ClientId];
+	pPlayer->m_SudoSpectatorControl = !pPlayer->m_SudoSpectatorControl;
+	pSelf->Console()->Print(
+		IConsole::OUTPUT_LEVEL_STANDARD,
+		"sudo",
+		pPlayer->m_SudoSpectatorControl ?
+			"Sudo enabled: up/down/left/right move the player you directly spectate; otherwise they move you." :
+			"Sudo disabled: up/down/left/right move you.");
+}
