+	m_DdxLastTileIndex = GameTile;
+	m_DdxLastFrontTileIndex = FrontTile;
+	ApplyDdxCompatTile(GameTile, EnteredGame);
+	if(m_Alive && FrontTile != GameTile)
+		ApplyDdxCompatTile(FrontTile, EnteredFront);
+}
