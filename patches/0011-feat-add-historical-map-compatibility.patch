+void CCharacter::ApplyDdxCompatTile(int Tile, bool Entered)
+{
+	if(DdxCompat::Family(m_DdxCompatFamily) == DdxCompat::EFamily::FTK && Entered && ApplyFtkTuning(Tile))
+		return;
+	const DdxCompat::EAction Action = DdxCompat::Action(DdxCompat::Family(m_DdxCompatFamily), Tile);
+	if(Action == DdxCompat::EAction::NONE || (!Entered && !DdxCompat::IsContinuous(Action)))
+		return;
+
+	const int ClientId = m_pPlayer->GetCid();
+	auto RequireAuth = [this, ClientId](int Required, const char *pMessage) {
+		if(Server()->GetAuthedState(ClientId) >= Required)
+			return;
+		GameServer()->SendChatTarget(ClientId, pMessage);
+		Die(ClientId, WEAPON_WORLD);
+	};
+
+	switch(Action)
+	{
+	case DdxCompat::EAction::RAINBOW_TOGGLE:
+		SetDdxRainbow(!m_pPlayer->m_DdxRainbow);
+		GameServer()->SendChatTarget(ClientId, m_pPlayer->m_DdxRainbow ? "Rainbow enabled" : "Rainbow disabled");
+		break;
+	case DdxCompat::EAction::RAPID_FIRE_TOGGLE:
+		m_DdxFastReload = !m_DdxFastReload;
+		GameServer()->SendChatTarget(ClientId, m_DdxFastReload ? "XXL rapid fire enabled" : "XXL rapid fire disabled");
+		break;
+	case DdxCompat::EAction::MEMBER_GATE:
+		RequireAuth(AUTHED_HELPER, "Authenticated DDX members only");
+		break;
+	case DdxCompat::EAction::MODERATOR_GATE:
+		RequireAuth(AUTHED_MOD, "DDX moderators only");
+		break;
+	case DdxCompat::EAction::ADMIN_GATE:
+		RequireAuth(AUTHED_ADMIN, "DDX administrators only");
+		break;
+	case DdxCompat::EAction::COMMUNITY_GATE:
+		// Historical clan and skin strings are client-controlled. Modern RCON authentication owns access instead.
+		RequireAuth(AUTHED_HELPER, "Authenticated DDX members only");
+		break;
+	case DdxCompat::EAction::SUPER_TOGGLE:
+		ToggleDdxSuper();
+		break;
+	case DdxCompat::EAction::HEAVY_HAMMER_TOGGLE:
+		m_DdxHeavyHammer = !m_DdxHeavyHammer;
+		GameServer()->SendChatTarget(ClientId, m_DdxHeavyHammer ? "Heavy hammer enabled" : "Heavy hammer disabled");
+		break;
+	case DdxCompat::EAction::INVISIBLE_TOGGLE:
+		m_pPlayer->m_DdxInvisible = !m_pPlayer->m_DdxInvisible;
+		GameServer()->SendChatTarget(ClientId, m_pPlayer->m_DdxInvisible ? "Invisibility enabled" : "Invisibility disabled");
+		break;
+	case DdxCompat::EAction::INVISIBLE_OFF:
+		m_pPlayer->m_DdxInvisible = false;
+		GameServer()->SendChatTarget(ClientId, "Invisibility disabled");
+		break;
+	case DdxCompat::EAction::BLOODY_TOGGLE:
+		m_DdxBloody = !m_DdxBloody;
+		GameServer()->SendChatTarget(ClientId, m_DdxBloody ? "Blood trail enabled" : "Blood trail disabled");
+		break;
+	case DdxCompat::EAction::CLEAR_EXTRAS:
+		ClearDdxCompatExtras();
+		GameServer()->SendChatTarget(ClientId, "All historical extras disabled");
+		break;
+	case DdxCompat::EAction::REMOVE_NINJA:
+		if(m_Core.m_aWeapons[WEAPON_NINJA].m_Got || m_Core.m_ActiveWeapon == WEAPON_NINJA)
+		{
+			RemoveNinja();
+			if(g_Config.m_SvDdxRemoveNinjaResetVelocity)
+				m_Core.m_Vel = vec2(0, 0);
+			GameServer()->SendChatTarget(ClientId, "You lost ninja");
+		}
+		break;
+	case DdxCompat::EAction::JUMPS_DEFAULT:
+		m_Core.m_Jumps = 2;
+		break;
+	case DdxCompat::EAction::JUMPS_ADD:
+		if(m_Core.m_Jumps < 255)
+			m_Core.m_Jumps++;
+		break;
+	case DdxCompat::EAction::JUMPS_REMOVE:
+		if(m_Core.m_Jumps > 0)
+			m_Core.m_Jumps--;
+		break;
+	case DdxCompat::EAction::GLOBAL_SOUND:
+		GameServer()->CreateSoundGlobal(SOUND_GUN_FIRE);
+		GameServer()->CreateSoundGlobal(SOUND_GRENADE_EXPLODE);
+		break;
+	case DdxCompat::EAction::RESCUE_ENABLE:
+		m_DdxRescueDisabled = false;
+		GameServer()->SendChatTarget(ClientId, "Rescue enabled by the map");
+		break;
+	case DdxCompat::EAction::RESCUE_DISABLE:
+		m_DdxRescueDisabled = true;
+		GameServer()->SendChatTarget(ClientId, "Rescue disabled by the map");
+		break;
+	case DdxCompat::EAction::NONE:
+		break;
+	}
+}
+
+bool CCharacter::ApplyFtkTuning(int Tile)
+{
+	const DdxCompat::CTuningChange Change = DdxCompat::FtkTuning(Tile);
+	CTuneParam *pParameter = nullptr;
+	const char *pName = nullptr;
+	switch(Change.m_Parameter)
+	{
+	case DdxCompat::ETuning::AIR_JUMP_IMPULSE: pParameter = &m_DdxFtkTuning.m_AirJumpImpulse; pName = "air_jump_impulse"; break;
+	case DdxCompat::ETuning::LASER_REACH: pParameter = &m_DdxFtkTuning.m_LaserReach; pName = "laser_reach"; break;
+	case DdxCompat::ETuning::LASER_BOUNCE_NUM: pParameter = &m_DdxFtkTuning.m_LaserBounceNum; pName = "laser_bounce_num"; break;
+	case DdxCompat::ETuning::HOOK_LENGTH: pParameter = &m_DdxFtkTuning.m_HookLength; pName = "hook_length"; break;
+	case DdxCompat::ETuning::GROUND_CONTROL_SPEED: pParameter = &m_DdxFtkTuning.m_GroundControlSpeed; pName = "ground_control_speed"; break;
+	case DdxCompat::ETuning::AIR_CONTROL_SPEED: pParameter = &m_DdxFtkTuning.m_AirControlSpeed; pName = "air_control_speed"; break;
+	case DdxCompat::ETuning::GROUND_JUMP_IMPULSE: pParameter = &m_DdxFtkTuning.m_GroundJumpImpulse; pName = "ground_jump_impulse"; break;
+	case DdxCompat::ETuning::PLAYER_COLLISION: pParameter = &m_DdxFtkTuning.m_PlayerCollision; pName = "player_collision"; break;
+	case DdxCompat::ETuning::GRAVITY: pParameter = &m_DdxFtkTuning.m_Gravity; pName = "gravity"; break;
+	case DdxCompat::ETuning::GROUND_FRICTION: pParameter = &m_DdxFtkTuning.m_GroundFriction; pName = "ground_friction"; break;
+	case DdxCompat::ETuning::AIR_FRICTION: pParameter = &m_DdxFtkTuning.m_AirFriction; pName = "air_friction"; break;
+	case DdxCompat::ETuning::PLAYER_HOOKING: pParameter = &m_DdxFtkTuning.m_PlayerHooking; pName = "player_hooking"; break;
+	case DdxCompat::ETuning::NONE: return false;
+	}
+	if(pParameter->Get() == Change.m_RawValue)
+		return true;
+	pParameter->Set(Change.m_RawValue);
+	m_Core.m_Tuning = m_DdxFtkTuning;
+	char aBuf[128];
+	str_format(aBuf, sizeof(aBuf), "%s set to %.2f", pName, Change.m_RawValue / 100.0f);
+	GameServer()->SendChatTarget(m_pPlayer->GetCid(), aBuf);
+	GameServer()->SendTuningParams(m_pPlayer->GetCid(), m_TuneZone);
+	return true;
+}
+
+bool CCharacter::HasDdxCustomTuning() const
+{
+	return DdxCompat::Family(m_DdxCompatFamily) == DdxCompat::EFamily::FTK;
+}
