+#include <game/ddx_tele_compat.h>
+#include <game/server/ddx_compat.h>
+
+#include <gtest/gtest.h>
+
+TEST(DdxCompat, FailsClosedForUnknownFamilies)
+{
+	EXPECT_EQ(DdxCompat::Family(-1), DdxCompat::EFamily::OFF);
+	EXPECT_EQ(DdxCompat::Family(0), DdxCompat::EFamily::OFF);
+	EXPECT_EQ(DdxCompat::Family(4), DdxCompat::EFamily::OFF);
+	EXPECT_EQ(DdxCompat::Action(DdxCompat::EFamily::OFF, 176), DdxCompat::EAction::NONE);
+}
+
+TEST(DdxCompat, MapsCanonicalXxlTiles)
+{
+	const auto Family = DdxCompat::EFamily::XXLDDRACE;
+	EXPECT_EQ(DdxCompat::Action(Family, 176), DdxCompat::EAction::RAINBOW_TOGGLE);
+	EXPECT_EQ(DdxCompat::Action(Family, 178), DdxCompat::EAction::ADMIN_GATE);
+	EXPECT_EQ(DdxCompat::Action(Family, 185), DdxCompat::EAction::REMOVE_NINJA);
+	EXPECT_EQ(DdxCompat::Action(Family, 189), DdxCompat::EAction::JUMPS_DEFAULT);
+	EXPECT_EQ(DdxCompat::Action(Family, 190), DdxCompat::EAction::JUMPS_ADD);
+	EXPECT_EQ(DdxCompat::Action(Family, 191), DdxCompat::EAction::JUMPS_REMOVE);
+	EXPECT_EQ(DdxCompat::Action(Family, 188), DdxCompat::EAction::NONE);
+}
+
+TEST(DdxCompat, KeepsTBlockConflictsSeparate)
+{
+	const auto Family = DdxCompat::EFamily::TBLOCK;
+	EXPECT_EQ(DdxCompat::Action(Family, 164), DdxCompat::EAction::COMMUNITY_GATE);
+	EXPECT_EQ(DdxCompat::Action(Family, 168), DdxCompat::EAction::GLOBAL_SOUND);
+	EXPECT_EQ(DdxCompat::Action(Family, 178), DdxCompat::EAction::MEMBER_GATE);
+	EXPECT_EQ(DdxCompat::Action(Family, 183), DdxCompat::EAction::COMMUNITY_GATE);
+	EXPECT_EQ(DdxCompat::Action(Family, 187), DdxCompat::EAction::CLEAR_EXTRAS);
+	EXPECT_EQ(DdxCompat::Action(Family, 189), DdxCompat::EAction::INVISIBLE_OFF);
+}
+
+TEST(DdxCompat, EdgeTriggerUsesRawLayerIdentity)
+{
+	EXPECT_TRUE(DdxCompat::EnteredTile(176, 0, 0));
+	EXPECT_FALSE(DdxCompat::EnteredTile(176, 176, 0));
+	EXPECT_FALSE(DdxCompat::EnteredTile(176, 0, 176));
+	EXPECT_TRUE(DdxCompat::EnteredTile(184, 183, 0));
+}
+
+TEST(DdxCompat, BoundsXxlFireDelay)
+{
+	EXPECT_EQ(DdxCompat::XxlFireDelayTicks(100), 10);
+	EXPECT_EQ(DdxCompat::XxlFireDelayTicks(11), 1);
+	EXPECT_EQ(DdxCompat::XxlFireDelayTicks(10), 1);
+	EXPECT_EQ(DdxCompat::XxlFireDelayTicks(0), 1);
+}
+
+TEST(DdxCompat, MapsFtkPerPlayerTuningTilesExactly)
+{
+	using DdxCompat::ETuning;
+	struct CExpected
+	{
+		int m_Tile;
+		ETuning m_Parameter;
+		int m_RawValue;
+	};
+	constexpr CExpected aExpected[] = {
+		{0x80, ETuning::AIR_JUMP_IMPULSE, 1200}, {0x81, ETuning::AIR_JUMP_IMPULSE, 0}, {0x82, ETuning::AIR_JUMP_IMPULSE, 2400}, {0x83, ETuning::AIR_JUMP_IMPULSE, 3600},
+		{0x84, ETuning::AIR_JUMP_IMPULSE, -1200}, {0x85, ETuning::AIR_JUMP_IMPULSE, -2400}, {0x86, ETuning::AIR_JUMP_IMPULSE, 600}, {0x87, ETuning::AIR_JUMP_IMPULSE, -600},
+		{0x88, ETuning::LASER_REACH, 80000}, {0x89, ETuning::LASER_REACH, 160000}, {0x8a, ETuning::LASER_REACH, 40000},
+		{0x8b, ETuning::LASER_BOUNCE_NUM, 100}, {0x8c, ETuning::LASER_BOUNCE_NUM, 400}, {0x8d, ETuning::LASER_BOUNCE_NUM, 0},
+		{0x90, ETuning::HOOK_LENGTH, 38000}, {0x91, ETuning::HOOK_LENGTH, 76000}, {0x92, ETuning::HOOK_LENGTH, 114000}, {0x93, ETuning::HOOK_LENGTH, 19000},
+		{0x94, ETuning::GROUND_CONTROL_SPEED, 1000}, {0x95, ETuning::GROUND_CONTROL_SPEED, 2000}, {0x96, ETuning::GROUND_CONTROL_SPEED, 500},
+		{0x97, ETuning::AIR_CONTROL_SPEED, 500}, {0x98, ETuning::AIR_CONTROL_SPEED, 1000}, {0x99, ETuning::AIR_CONTROL_SPEED, 1500}, {0x9a, ETuning::AIR_CONTROL_SPEED, 250},
+		{0x9b, ETuning::GROUND_JUMP_IMPULSE, 1320}, {0x9c, ETuning::GROUND_JUMP_IMPULSE, 0}, {0x9d, ETuning::GROUND_JUMP_IMPULSE, 2640},
+		{0x9e, ETuning::PLAYER_COLLISION, 100}, {0x9f, ETuning::PLAYER_COLLISION, 0},
+		{0xa0, ETuning::GRAVITY, 50}, {0xa1, ETuning::GRAVITY, 0}, {0xa2, ETuning::GRAVITY, 100}, {0xa3, ETuning::GRAVITY, 150},
+		{0xa4, ETuning::GRAVITY, -50}, {0xa5, ETuning::GRAVITY, -100}, {0xa6, ETuning::GRAVITY, 25}, {0xa7, ETuning::GRAVITY, -25},
+		{0xa8, ETuning::GROUND_FRICTION, 50}, {0xa9, ETuning::GROUND_FRICTION, 0}, {0xaa, ETuning::GROUND_FRICTION, 100},
+		{0xab, ETuning::AIR_FRICTION, 95}, {0xac, ETuning::AIR_FRICTION, 0}, {0xad, ETuning::AIR_FRICTION, 100},
+		{0xae, ETuning::PLAYER_HOOKING, 100}, {0xaf, ETuning::PLAYER_HOOKING, 0},
+	};
+	for(const CExpected &Expected : aExpected)
+	{
+		const auto Actual = DdxCompat::FtkTuning(Expected.m_Tile);
+		EXPECT_EQ(Actual.m_Parameter, Expected.m_Parameter) << Expected.m_Tile;
+		EXPECT_EQ(Actual.m_RawValue, Expected.m_RawValue) << Expected.m_Tile;
+	}
+	EXPECT_EQ(DdxCompat::FtkTuning(0x8e).m_Parameter, DdxCompat::ETuning::NONE);
+	EXPECT_EQ(DdxCompat::FtkTuning(0xb0).m_Parameter, DdxCompat::ETuning::NONE);
+}
+
+TEST(DdxCompat, KeepsFtkRescueControlSeparate)
+{
+	EXPECT_EQ(DdxCompat::Action(DdxCompat::EFamily::FTK, 0xba), DdxCompat::EAction::RESCUE_ENABLE);
+	EXPECT_EQ(DdxCompat::Action(DdxCompat::EFamily::FTK, 0xbb), DdxCompat::EAction::RESCUE_DISABLE);
+	EXPECT_EQ(DdxCompat::Action(DdxCompat::EFamily::XXLDDRACE, 0xba), DdxCompat::EAction::NONE);
+}
+
+TEST(DdxTeleCompat, KeepsConflictingFddraceEncodingsExplicit)
+{
+	using DdxTeleCompat::EFamily;
+	EXPECT_TRUE(DdxTeleCompat::IsNormalInOut(EFamily::FDDRACE_93, 93));
+	EXPECT_FALSE(DdxTeleCompat::IsNormalInOut(EFamily::FDDRACE_93, 95));
+	EXPECT_TRUE(DdxTeleCompat::IsNormalInOut(EFamily::FDDRACE_95, 95));
+	EXPECT_FALSE(DdxTeleCompat::IsNormalInOut(EFamily::FDDRACE_95, 93));
+	EXPECT_TRUE(DdxTeleCompat::IsEvilInOut(EFamily::FDDRACE_93, 94));
+	EXPECT_TRUE(DdxTeleCompat::IsEvilInOut(EFamily::FDDRACE_95, 94));
+	EXPECT_FALSE(DdxTeleCompat::IsInOut(EFamily::OFF, 94));
+	EXPECT_EQ(DdxTeleCompat::Family(3), EFamily::OFF);
+}

