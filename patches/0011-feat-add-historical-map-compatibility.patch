diff --git a/src/game/ddx_tele_compat.h b/src/game/ddx_tele_compat.h
new file mode 100644
index 0000000..08ca393
--- /dev/null
+++ b/src/game/ddx_tele_compat.h
@@ -0,0 +1,36 @@
+#ifndef GAME_DDX_TELE_COMPAT_H
+#define GAME_DDX_TELE_COMPAT_H
+
+namespace DdxTeleCompat
+{
+enum class EFamily
+{
+	OFF = 0,
+	FDDRACE_93 = 1,
+	FDDRACE_95 = 2,
+};
+
+constexpr EFamily Family(int Value)
+{
+	return Value >= static_cast<int>(EFamily::FDDRACE_93) && Value <= static_cast<int>(EFamily::FDDRACE_95) ?
+		static_cast<EFamily>(Value) : EFamily::OFF;
+}
+
+constexpr bool IsNormalInOut(EFamily Family, int Type)
+{
+	return (Family == EFamily::FDDRACE_93 && Type == 93) ||
+		(Family == EFamily::FDDRACE_95 && Type == 95);
+}
+
+constexpr bool IsEvilInOut(EFamily Family, int Type)
+{
+	return Family != EFamily::OFF && Type == 94;
+}
+
+constexpr bool IsInOut(EFamily Family, int Type)
+{
+	return IsNormalInOut(Family, Type) || IsEvilInOut(Family, Type);
+}
+} // namespace DdxTeleCompat
+
+#endif // GAME_DDX_TELE_COMPAT_H
diff --git a/src/game/server/ddx_compat.h b/src/game/server/ddx_compat.h
new file mode 100644
index 0000000..be68a77
--- /dev/null
+++ b/src/game/server/ddx_compat.h
@@ -0,0 +1,195 @@
+#ifndef GAME_SERVER_DDX_COMPAT_H
+#define GAME_SERVER_DDX_COMPAT_H
+
+namespace DdxCompat
+{
+enum class EFamily
+{
+	OFF = 0,
+	XXLDDRACE = 1,
+	TBLOCK = 2,
+	FTK = 3,
+};
+
+enum class EAction
+{
+	NONE,
+	RAINBOW_TOGGLE,
+	RAPID_FIRE_TOGGLE,
+	MEMBER_GATE,
+	MODERATOR_GATE,
+	ADMIN_GATE,
+	COMMUNITY_GATE,
+	SUPER_TOGGLE,
+	HEAVY_HAMMER_TOGGLE,
+	INVISIBLE_TOGGLE,
+	INVISIBLE_OFF,
+	BLOODY_TOGGLE,
+	CLEAR_EXTRAS,
+	REMOVE_NINJA,
+	JUMPS_DEFAULT,
+	JUMPS_ADD,
+	JUMPS_REMOVE,
+	GLOBAL_SOUND,
+	RESCUE_ENABLE,
+	RESCUE_DISABLE,
+};
+
+enum class ETuning
+{
+	NONE,
+	AIR_JUMP_IMPULSE,
+	LASER_REACH,
+	LASER_BOUNCE_NUM,
+	HOOK_LENGTH,
+	GROUND_CONTROL_SPEED,
+	AIR_CONTROL_SPEED,
+	GROUND_JUMP_IMPULSE,
+	PLAYER_COLLISION,
+	GRAVITY,
+	GROUND_FRICTION,
+	AIR_FRICTION,
+	PLAYER_HOOKING,
+};
+
+struct CTuningChange
+{
+	ETuning m_Parameter;
+	int m_RawValue;
+};
+
+constexpr EFamily Family(int Value)
+{
+	return Value >= static_cast<int>(EFamily::XXLDDRACE) && Value <= static_cast<int>(EFamily::FTK) ?
+		static_cast<EFamily>(Value) : EFamily::OFF;
+}
+
+constexpr EAction Action(EFamily Family, int Tile)
+{
+	if(Family == EFamily::FTK)
+	{
+		if(Tile == 0xba)
+			return EAction::RESCUE_ENABLE;
+		if(Tile == 0xbb)
+			return EAction::RESCUE_DISABLE;
+	}
+	if(Family == EFamily::XXLDDRACE || Family == EFamily::FTK)
+	{
+		switch(Tile)
+		{
+		case 176: return EAction::RAINBOW_TOGGLE;
+		case 177: return EAction::RAPID_FIRE_TOGGLE;
+		case 178: return EAction::ADMIN_GATE;
+		case 179: return EAction::MEMBER_GATE;
+		case 180: return EAction::SUPER_TOGGLE;
+		case 181: return EAction::HEAVY_HAMMER_TOGGLE;
+		case 182: return EAction::INVISIBLE_TOGGLE;
+		case 183: return EAction::BLOODY_TOGGLE;
+		case 184: return EAction::CLEAR_EXTRAS;
+		case 185: return EAction::REMOVE_NINJA;
+		case 189: return EAction::JUMPS_DEFAULT;
+		case 190: return EAction::JUMPS_ADD;
+		case 191: return EAction::JUMPS_REMOVE;
+		default: return EAction::NONE;
+		}
+	}
+	if(Family == EFamily::TBLOCK)
+	{
+		switch(Tile)
+		{
+		case 164: return EAction::COMMUNITY_GATE;
+		case 166: return EAction::MODERATOR_GATE;
+		case 167: return EAction::ADMIN_GATE;
+		case 168: return EAction::GLOBAL_SOUND;
+		case 176: return EAction::RAINBOW_TOGGLE;
+		case 177: return EAction::RAPID_FIRE_TOGGLE;
+		case 178: return EAction::MEMBER_GATE;
+		case 179: return EAction::SUPER_TOGGLE;
+		case 180: return EAction::HEAVY_HAMMER_TOGGLE;
+		case 181: return EAction::INVISIBLE_TOGGLE;
+		case 182: return EAction::BLOODY_TOGGLE;
+		case 183:
+		case 184:
+		case 185:
+		case 186:
+		case 188: return EAction::COMMUNITY_GATE;
+		case 187: return EAction::CLEAR_EXTRAS;
+		case 189: return EAction::INVISIBLE_OFF;
+		default: return EAction::NONE;
+		}
+	}
+	return EAction::NONE;
+}
+
+constexpr CTuningChange FtkTuning(int Tile)
+{
+	switch(Tile)
+	{
+	case 0x80: return {ETuning::AIR_JUMP_IMPULSE, 1200};
+	case 0x81: return {ETuning::AIR_JUMP_IMPULSE, 0};
+	case 0x82: return {ETuning::AIR_JUMP_IMPULSE, 2400};
+	case 0x83: return {ETuning::AIR_JUMP_IMPULSE, 3600};
+	case 0x84: return {ETuning::AIR_JUMP_IMPULSE, -1200};
+	case 0x85: return {ETuning::AIR_JUMP_IMPULSE, -2400};
+	case 0x86: return {ETuning::AIR_JUMP_IMPULSE, 600};
+	case 0x87: return {ETuning::AIR_JUMP_IMPULSE, -600};
+	case 0x88: return {ETuning::LASER_REACH, 80000};
+	case 0x89: return {ETuning::LASER_REACH, 160000};
+	case 0x8a: return {ETuning::LASER_REACH, 40000};
+	case 0x8b: return {ETuning::LASER_BOUNCE_NUM, 100};
+	case 0x8c: return {ETuning::LASER_BOUNCE_NUM, 400};
+	case 0x8d: return {ETuning::LASER_BOUNCE_NUM, 0};
+	case 0x90: return {ETuning::HOOK_LENGTH, 38000};
+	case 0x91: return {ETuning::HOOK_LENGTH, 76000};
+	case 0x92: return {ETuning::HOOK_LENGTH, 114000};
+	case 0x93: return {ETuning::HOOK_LENGTH, 19000};
+	case 0x94: return {ETuning::GROUND_CONTROL_SPEED, 1000};
+	case 0x95: return {ETuning::GROUND_CONTROL_SPEED, 2000};
+	case 0x96: return {ETuning::GROUND_CONTROL_SPEED, 500};
+	case 0x97: return {ETuning::AIR_CONTROL_SPEED, 500};
+	case 0x98: return {ETuning::AIR_CONTROL_SPEED, 1000};
+	case 0x99: return {ETuning::AIR_CONTROL_SPEED, 1500};
+	case 0x9a: return {ETuning::AIR_CONTROL_SPEED, 250};
+	case 0x9b: return {ETuning::GROUND_JUMP_IMPULSE, 1320};
+	case 0x9c: return {ETuning::GROUND_JUMP_IMPULSE, 0};
+	case 0x9d: return {ETuning::GROUND_JUMP_IMPULSE, 2640};
+	case 0x9e: return {ETuning::PLAYER_COLLISION, 100};
+	case 0x9f: return {ETuning::PLAYER_COLLISION, 0};
+	case 0xa0: return {ETuning::GRAVITY, 50};
+	case 0xa1: return {ETuning::GRAVITY, 0};
+	case 0xa2: return {ETuning::GRAVITY, 100};
+	case 0xa3: return {ETuning::GRAVITY, 150};
+	case 0xa4: return {ETuning::GRAVITY, -50};
+	case 0xa5: return {ETuning::GRAVITY, -100};
+	case 0xa6: return {ETuning::GRAVITY, 25};
+	case 0xa7: return {ETuning::GRAVITY, -25};
+	case 0xa8: return {ETuning::GROUND_FRICTION, 50};
+	case 0xa9: return {ETuning::GROUND_FRICTION, 0};
+	case 0xaa: return {ETuning::GROUND_FRICTION, 100};
+	case 0xab: return {ETuning::AIR_FRICTION, 95};
+	case 0xac: return {ETuning::AIR_FRICTION, 0};
+	case 0xad: return {ETuning::AIR_FRICTION, 100};
+	case 0xae: return {ETuning::PLAYER_HOOKING, 100};
+	case 0xaf: return {ETuning::PLAYER_HOOKING, 0};
+	default: return {ETuning::NONE, 0};
+	}
+}
+
+constexpr bool IsContinuous(EAction Action)
+{
+	return Action == EAction::MEMBER_GATE || Action == EAction::MODERATOR_GATE ||
+		Action == EAction::ADMIN_GATE || Action == EAction::COMMUNITY_GATE;
+}
+
+constexpr bool EnteredTile(int Tile, int LastGameTile, int LastFrontTile)
+{
+	return Tile != LastGameTile && Tile != LastFrontTile;
+}
+
+constexpr int XxlFireDelayTicks(int NormalDelayTicks)
+{
+	return NormalDelayTicks > 10 ? NormalDelayTicks / 10 : 1;
+}
+} // namespace DdxCompat
+
+#endif // GAME_SERVER_DDX_COMPAT_H
