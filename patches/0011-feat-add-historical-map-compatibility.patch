+std::string DdxTileList(const std::set<int> &Tiles)
+{
+	std::string Result;
+	for(const int Tile : Tiles)
+	{
+		if(!Result.empty())
+			Result += ',';
+		Result += std::to_string(Tile);
+	}
+	return Result;
+}
+
+void LogDdxMapCompatibility(const char *pMapName, const CCollision &Collision)
+{
+	const DdxCompat::EFamily Family = DdxCompat::Family(g_Config.m_SvDdxCompatFamily);
+	std::set<int> LegacyLooking;
+	std::set<int> EnabledActions;
+	for(int Index = 0; Index < Collision.GetWidth() * Collision.GetHeight(); ++Index)
+	{
+		const int aTiles[] = {Collision.GetTileIndex(Index), Collision.GetFrontTileIndex(Index)};
+		for(const int Tile : aTiles)
+		{
+			if(Tile >= 176 && Tile <= 189)
+				LegacyLooking.insert(Tile);
+			if(DdxCompat::Action(Family, Tile) != DdxCompat::EAction::NONE ||
+				(Family == DdxCompat::EFamily::FTK && DdxCompat::FtkTuning(Tile).m_Parameter != DdxCompat::ETuning::NONE))
+				EnabledActions.insert(Tile);
+		}
+	}
+
+	if(!LegacyLooking.empty() && Family == DdxCompat::EFamily::OFF)
+	{
+		log_warn("ddx", "map='%s' has unsupported historical-looking game/front tile IDs=%s; set sv_ddx_compat_family only after identifying the source family", pMapName, DdxTileList(LegacyLooking).c_str());
+	}
+	else if(!EnabledActions.empty())
+	{
+		log_info("ddx", "map='%s' historical family=%d enables raw game/front tile IDs=%s", pMapName, static_cast<int>(Family), DdxTileList(EnabledActions).c_str());
+	}
+
+	std::set<int> CombinedTeleTypes;
+	if(Collision.TeleLayer())
+	{
+		for(int Index = 0; Index < Collision.GetWidth() * Collision.GetHeight(); ++Index)
+		{
+			const int Type = Collision.TeleLayer()[Index].m_Type;
+			if(Type >= 93 && Type <= 95)
+				CombinedTeleTypes.insert(Type);
+		}
+	}
+	if(!CombinedTeleTypes.empty() && Collision.DdxTeleFamily() == 0)
+	{
+		log_warn("ddx", "map='%s' has unsupported combined-tele candidates=%s; select the proven 93/94 or 95/94 F-DDrace family", pMapName, DdxTileList(CombinedTeleTypes).c_str());
+	}
+	else if(!CombinedTeleTypes.empty())
+	{
+		log_info("ddx", "map='%s' combined-tele family=%d handles raw types=%s", pMapName, Collision.DdxTeleFamily(), DdxTileList(CombinedTeleTypes).c_str());
+	}
+}
