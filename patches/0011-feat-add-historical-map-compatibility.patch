+void CCharacter::ClearDdxCompatExtras()
+{
+	SetDdxRainbow(false);
+	m_pPlayer->m_DdxInvisible = false;
+	m_DdxFastReload = false;
+	m_DdxBloody = false;
+	m_DdxHeavyHammer = false;
+	m_DdxRescueDisabled = false;
+	if(m_DdxSuper)
+		SetSuper(false);
+}
+
+void CCharacter::SetDdxRainbow(bool Enabled)
+{
+	if(Enabled == m_pPlayer->m_DdxRainbow)
+		return;
+	if(Enabled)
+	{
+		m_pPlayer->m_DdxRainbowHadCustomColor = m_pPlayer->m_TeeInfos.m_UseCustomColor;
+		m_pPlayer->m_DdxRainbowBodyColor = m_pPlayer->m_TeeInfos.m_ColorBody;
+		m_pPlayer->m_DdxRainbowFeetColor = m_pPlayer->m_TeeInfos.m_ColorFeet;
+		m_pPlayer->m_DdxRainbow = true;
+		return;
+	}
+	m_pPlayer->m_DdxRainbow = false;
+	m_pPlayer->m_TeeInfos.m_UseCustomColor = m_pPlayer->m_DdxRainbowHadCustomColor;
+	m_pPlayer->m_TeeInfos.m_ColorBody = m_pPlayer->m_DdxRainbowBodyColor;
+	m_pPlayer->m_TeeInfos.m_ColorFeet = m_pPlayer->m_DdxRainbowFeetColor;
+	m_pPlayer->m_TeeInfos.ToSixup();
+}
+
+void CCharacter::ToggleDdxSuper()
+{
+	if(m_Core.m_Super)
+	{
+		SetSuper(false);
+		GameServer()->SendChatTarget(m_pPlayer->GetCid(), "Super disabled");
+		return;
+	}
+	SetSuper(true);
+	m_DdxSuper = true;
+	Unfreeze();
+	GameServer()->SendChatTarget(m_pPlayer->GetCid(), "Super enabled");
+}
+
+void CCharacter::TickDdxCompat()
+{
+	if(m_DdxCompatFamily != g_Config.m_SvDdxCompatFamily)
+	{
+		ClearDdxCompatExtras();
+		m_DdxCompatFamily = g_Config.m_SvDdxCompatFamily;
+		m_DdxFtkTuning = m_Core.m_Tuning;
+		m_DdxLastTileIndex = 0;
+		m_DdxLastFrontTileIndex = 0;
+	}
+	if(DdxCompat::Family(m_DdxCompatFamily) == DdxCompat::EFamily::OFF)
+		return;
+	if(DdxCompat::Family(m_DdxCompatFamily) == DdxCompat::EFamily::FTK)
+		m_Core.m_Tuning = m_DdxFtkTuning;
+	if(m_DdxBloody)
+		GameServer()->CreateDeath(m_Pos, m_pPlayer->GetCid(), TeamMask());
+	if(m_pPlayer->m_DdxRainbow)
+	{
+		const int Color = 65280 + (Server()->Tick() % 255) * 65536;
+		m_pPlayer->m_TeeInfos.m_UseCustomColor = true;
+		m_pPlayer->m_TeeInfos.m_ColorBody = Color;
+		m_pPlayer->m_TeeInfos.m_ColorFeet = Color;
+		m_pPlayer->m_TeeInfos.ToSixup();
+	}
+}
