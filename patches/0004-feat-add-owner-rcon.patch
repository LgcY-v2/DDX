diff --git a/src/test/console_victim_test.cpp b/src/test/console_victim_test.cpp
new file mode 100644
index 0000000..4fea98b
--- /dev/null
+++ b/src/test/console_victim_test.cpp
@@ -0,0 +1,70 @@
+#include "test.h"
+
+#include <base/str.h>
+
+#include <engine/console.h>
+#include <engine/shared/config.h>
+#include <engine/shared/console.h>
+
+#include <gtest/gtest.h>
+
+#include <optional>
+#include <vector>
+
+namespace
+{
+	int g_NumExecutions = 0;
+	int g_LastVictim = -1;
+
+	void VictimRecorder(IConsole::IResult *pResult, void *)
+	{
+		g_NumExecutions++;
+		g_LastVictim = pResult->GetVictim();
+	}
+
+	std::optional<std::vector<int>> NumericVictims(int ClientId, const char *pVictim, void *)
+	{
+		if(!str_comp(pVictim, "me"))
+		{
+			if(ClientId < 0)
+				return std::nullopt;
+			return std::vector<int>{ClientId};
+		}
+		int Target;
+		if(!str_toint(pVictim, &Target))
+			return std::nullopt;
+		return std::vector<int>{Target};
+	}
+} // namespace
+
+TEST(ConsoleVictim, NumericVictimKeepsStandaloneConsoleContract)
+{
+	auto pConsole = CreateConsole(CFGFLAG_SERVER);
+	pConsole->StoreCommands(false);
+
+	g_NumExecutions = 0;
+	pConsole->Register("victimrec", "?v[victim]", CFGFLAG_SERVER, VictimRecorder, nullptr, "victim command recorder");
+
+	pConsole->ExecuteLine("victimrec 3", IConsole::CLIENT_ID_UNSPECIFIED);
+	EXPECT_EQ(g_NumExecutions, 1);
+	EXPECT_EQ(g_LastVictim, 3);
+
+	pConsole->SetGetVictimsCommandCallback(NumericVictims, nullptr);
+	pConsole->ExecuteLine("victimrec 3", IConsole::CLIENT_ID_UNSPECIFIED);
+	EXPECT_EQ(g_NumExecutions, 2);
+	EXPECT_EQ(g_LastVictim, 3);
+}
+
+TEST(ConsoleVictim, BareOptionalVictimResolvesToCaller)
+{
+	auto pConsole = CreateConsole(CFGFLAG_SERVER);
+	pConsole->StoreCommands(false);
+
+	g_NumExecutions = 0;
+	pConsole->Register("victimrec", "?v[victim]", CFGFLAG_SERVER, VictimRecorder, nullptr, "victim command recorder");
+	pConsole->SetGetVictimsCommandCallback(NumericVictims, nullptr);
+
+	pConsole->ExecuteLine("victimrec", 7);
+	EXPECT_EQ(g_NumExecutions, 1);
+	EXPECT_EQ(g_LastVictim, 7);
+}
diff --git a/src/test/ddx_auth_test.cpp b/src/test/ddx_auth_test.cpp
new file mode 100644
index 0000000..108c275
--- /dev/null
+++ b/src/test/ddx_auth_test.cpp
@@ -0,0 +1,120 @@
+#include <engine/console.h>
+#include <engine/server/authmanager.h>
+#include <engine/server/ddx_auth.h>
+#include <engine/shared/config.h>
+
+#include <base/str.h>
+
+#include <gtest/gtest.h>
+
+namespace
+{
+struct CCommandPolicy
+{
+	bool m_TestCommandsEnabled = false;
+};
+
+bool CanUseDdxCommand(int ClientId, const IConsole::ICommandInfo *pCommand, void *pUser)
+{
+	const CCommandPolicy *pPolicy = static_cast<CCommandPolicy *>(pUser);
+	if(pCommand->Flags() & CMDFLAG_OWNER && !DdxAuth::IsOwner(ClientId))
+		return false;
+	if(pCommand->Flags() & CMDFLAG_TEST && !DdxAuth::CanUseTestCommands(ClientId, pPolicy->m_TestCommandsEnabled))
+		return false;
+	return true;
+}
+
+void CountCommand(IConsole::IResult *, void *pUser)
+{
+	int *pCount = static_cast<int *>(pUser);
+	(*pCount)++;
+}
+
+std::optional<std::vector<int>> AuthorizedVictim(int ClientId, const char *pVictim, void *)
+{
+	int TargetClientId;
+	if(!str_toint(pVictim, &TargetClientId))
+		return std::nullopt;
+	if(!DdxAuth::CanManage(ClientId, TargetClientId))
+		return std::vector<int>{};
+	return std::vector<int>{TargetClientId};
+}
+
+void RecordVictim(IConsole::IResult *pResult, void *pUser)
+{
+	int *pVictim = static_cast<int *>(pUser);
+	*pVictim = pResult->GetVictim();
+}
+} // namespace
+
+TEST(DdxAuth, DefinesOwnerAboveAdmin)
+{
+	EXPECT_GT(DdxAuth::OWNER, AUTHED_ADMIN);
+	EXPECT_TRUE(DdxAuth::IsOwner(DdxAuth::OWNER));
+	EXPECT_FALSE(DdxAuth::IsOwner(AUTHED_ADMIN));
+	EXPECT_TRUE(DdxAuth::CanManage(DdxAuth::OWNER, AUTHED_ADMIN));
+	EXPECT_FALSE(DdxAuth::CanManage(AUTHED_ADMIN, DdxAuth::OWNER));
+	EXPECT_EQ(DdxAuth::PublicAuthLevel(DdxAuth::OWNER), AUTHED_ADMIN);
+}
+
+TEST(DdxAuth, RegistersOwnerAuthenticationKeys)
+{
+	CAuthManager AuthManager;
+	const CRconRole *pOwnerRole = AuthManager.FindRole(RoleName::OWNER);
+	ASSERT_NE(pOwnerRole, nullptr);
+	EXPECT_EQ(pOwnerRole->Rank(), DdxAuth::OWNER);
+	EXPECT_STREQ(CAuthManager::AuthLevelToRoleName(DdxAuth::OWNER), RoleName::OWNER);
+
+	const int OwnerKey = AuthManager.AddKey("test_owner", "not-a-production-secret", RoleName::OWNER);
+	ASSERT_GE(OwnerKey, 0);
+	EXPECT_EQ(AuthManager.KeyLevel(OwnerKey), DdxAuth::OWNER);
+	EXPECT_TRUE(AuthManager.CheckKey(OwnerKey, "not-a-production-secret"));
+	EXPECT_FALSE(AuthManager.CheckKey(OwnerKey, "wrong"));
+}
+
+TEST(DdxAuth, KeepsTestAndOwnerCommandsExclusive)
+{
+	auto pConsole = CreateConsole(CFGFLAG_SERVER);
+	CCommandPolicy Policy;
+	pConsole->SetCanUseCommandCallback(CanUseDdxCommand, &Policy);
+	pConsole->StoreCommands(false);
+
+	int TestExecutions = 0;
+	int OwnerExecutions = 0;
+	pConsole->Register("ddx_test", "", CFGFLAG_SERVER | CMDFLAG_TEST, CountCommand, &TestExecutions, "test command");
+	pConsole->Register("ddx_owner", "", CFGFLAG_SERVER | CMDFLAG_OWNER, CountCommand, &OwnerExecutions, "owner command");
+
+	pConsole->ExecuteLine("ddx_test", AUTHED_ADMIN);
+	pConsole->ExecuteLine("ddx_owner", AUTHED_ADMIN);
+	EXPECT_EQ(TestExecutions, 0);
+	EXPECT_EQ(OwnerExecutions, 0);
+
+	pConsole->ExecuteLine("ddx_test", DdxAuth::OWNER);
+	pConsole->ExecuteLine("ddx_owner", DdxAuth::OWNER);
+	EXPECT_EQ(TestExecutions, 1);
+	EXPECT_EQ(OwnerExecutions, 1);
+
+	Policy.m_TestCommandsEnabled = true;
+	pConsole->ExecuteLine("ddx_test", AUTHED_ADMIN);
+	pConsole->ExecuteLine("ddx_owner", AUTHED_ADMIN);
+	EXPECT_EQ(TestExecutions, 2);
+	EXPECT_EQ(OwnerExecutions, 1);
+}
+
+TEST(DdxAuth, AuthorizesNumericVictimsBeforeExecution)
+{
+	auto pConsole = CreateConsole(CFGFLAG_SERVER);
+	CCommandPolicy Policy;
+	pConsole->SetCanUseCommandCallback(CanUseDdxCommand, &Policy);
+	pConsole->SetGetVictimsCommandCallback(AuthorizedVictim, nullptr);
+	pConsole->StoreCommands(false);
+
+	int ExecutedVictim = -1;
+	pConsole->Register("ddx_target", "v[id]", CFGFLAG_SERVER, RecordVictim, &ExecutedVictim, "target command");
+
+	pConsole->ExecuteLine("ddx_target 4", AUTHED_ADMIN);
+	EXPECT_EQ(ExecutedVictim, -1);
+
+	pConsole->ExecuteLine("ddx_target 3", DdxAuth::OWNER);
+	EXPECT_EQ(ExecutedVictim, AUTHED_ADMIN);
+}
