+#ifndef ENGINE_SERVER_DDX_AUTH_H
+#define ENGINE_SERVER_DDX_AUTH_H
+
+#include <generated/protocol.h>
+
+namespace DdxAuth
+{
+inline constexpr int OWNER = AUTHED_ADMIN + 1;
+
+constexpr bool IsOwner(int AuthLevel)
+{
+	return AuthLevel >= OWNER;
+}
+
+constexpr bool CanManage(int ActorAuthLevel, int TargetAuthLevel)
+{
+	return ActorAuthLevel >= TargetAuthLevel;
+}
+
+constexpr bool CanUseTestCommands(int AuthLevel, bool TestCommandsEnabled)
+{
+	return TestCommandsEnabled || IsOwner(AuthLevel);
+}
+
+constexpr int PublicAuthLevel(int AuthLevel)
+{
+	return AuthLevel > AUTHED_ADMIN ? AUTHED_ADMIN : AuthLevel;
+}
+} // namespace DdxAuth
+
+#endif // ENGINE_SERVER_DDX_AUTH_H
