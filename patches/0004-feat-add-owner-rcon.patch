 	return Addr;
 }
 
+static bool CanManageAddress(CGameContext *pGameServer, int ActorClientId, const NETADDR *pAddr)
+{
+	for(int ClientId = 0; ClientId < pGameServer->Server()->MaxClients(); ClientId++)
+	{
+		if(!pGameServer->Server()->ClientIngame(ClientId) || net_addr_comp_noport(pAddr, pGameServer->Server()->ClientAddr(ClientId)) != 0)
+			continue;
+		if(!pGameServer->Server()->CanManageClient(ActorClientId, ClientId))
+		{
+			pGameServer->Console()->Print(IConsole::OUTPUT_LEVEL_STANDARD, "auth", "address command denied for higher-ranked client");
+			return false;
+		}
+	}
+	return true;
+}
